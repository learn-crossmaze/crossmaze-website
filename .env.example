# Copy to .env for local development. None of these are needed in production on Firebase Hosting.

# Admin panel (/admin): your Firebase web-app config. On Firebase Hosting it is loaded automatically
# from /__/firebase/init.json, so you only need these for `npm run dev`.
# Firebase console -> Project settings -> Your apps -> Web app -> SDK setup and configuration.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_APP_ID=

# Set to true to point the admin panel at the local Firebase emulators (firebase emulators:start).
PUBLIC_FIREBASE_EMULATORS=

# Show "Continue with Google" on the admin sign-in page. Only set to true after enabling
# Google in Firebase -> Authentication -> Sign-in method (also add it as a GitHub variable).
PUBLIC_ADMIN_GOOGLE_SIGNIN=

# Where website forms are sent. Defaults to /api/submit (the `submit` Cloud Function).
PUBLIC_FORM_ENDPOINT=
