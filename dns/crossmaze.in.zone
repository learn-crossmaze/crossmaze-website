bounce-zem                3600  IN  CNAME  cluster89.zeptomail.com.
zb15474756                3600  IN  CNAME  zmverify.zoho.com.
mail                      3600  IN  CNAME  mail.cs.zohohost.com.
forms                     3600  IN  CNAME  forms.cs.zohohost.com.

; Email policy, set up by Wix (same p=none policy); becomes TXT "v=DMARC1; p=none;" after leaving Wix
_dmarc                    3600  IN  CNAME  _dmarc.wixemails.com.

; LITMUS
litmus                    1800  IN  CNAME  litmus-prod-crossmaze.web.app.
staging                   3600  IN  CNAME  litmus-staging-37942.web.app.
_acme-challenge.staging   3600  IN  TXT    "TEgQsUbU57mZeJL6lOn6PuYBkXDZgGcFasRp3cfIs7g"
_acme-challenge.app       3600  IN  TXT    "YcFfbe_HSsFPk8u0FwxPib0lKAOixwf1wrJT69jywIQ"

