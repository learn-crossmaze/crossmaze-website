---
// A section with a form: the intro (eyebrow, heading, lead) and an aside beside a form on a glass card.
// The branch pages' "Book a visit" uses it with the centre's address, phone and map in the aside; the
// home page's enquiry (with the admission steps) and the careers application (with the careers email)
// can use it the same way.
//  - Wide screens (from 1001px): two columns. While the form scrolls past, the intro and aside stay in
//    view under the floating header (only on screens tall enough to show them whole).
//  - Narrower: the intro, then the form across the full width (so its fields stay two to a row on
//    tablets), then the aside. "Book a visit" (#enquire) then lands with the form's first fields in view
//    on a phone instead of the address card or the admission steps.
//
//   <FormSection id="enquire" admissions title="Book a visit" lead="…">
//     <div slot="aside">…</div>
//     <EnquiryForm slot="form" … />
//   </FormSection>
import AdmissionsYear from './AdmissionsYear.astro';

interface Props {
  /** The section's id (a link target such as #enquire); the heading's id is this plus "-title". */
  id?: string;
  eyebrow?: string;
  /** The eyebrow says "Admissions open for 2027–28" (the coming school year, kept up to date). */
  admissions?: boolean;
  title: string;
  lead?: string;
  /** More classes for the <section>. */
  class?: string;
}

const { id, eyebrow, admissions = false, title, lead, class: className } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['section', 'form-section', className]} id={id} aria-labelledby={headingId}>
  <div class="container form-section__inner">
    <div class="form-section__intro">
      {
        admissions ? (
          <span class="eyebrow">
            <span>
              Admissions open for <AdmissionsYear />
            </span>
          </span>
        ) : (
          eyebrow && <span class="eyebrow">{eyebrow}</span>
        )
      }
      <h2 id={headingId}>{title}</h2>
      {lead && <p class="lead">{lead}</p>}
      {
        hasAside && (
          <div class="form-section__aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
    <div class="card form-section__form">
      <slot name="form" />
      <slot />
    </div>
  </div>
</section>

<style>
  /* Sections clip their drifting doodle with overflow: hidden (global.css), which would also stop the
     intro from sticking; clip does the same clipping without that side effect. */
  .form-section {
    overflow: clip;
  }

  .form-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  .form-section__intro h2 {
    max-width: 22ch;
  }

  .form-section__intro .lead {
    margin-bottom: 0;
  }

  .form-section__aside {
    margin-top: clamp(24px, 3vw, 32px);
  }

  .form-section__form {
    min-width: 0;
  }

  /* Two fields to a row whenever the card is at least about 450px wide (the shared rows in global.css
     need about 510px), so they don't fall to one a row beside the intro on smaller laptops. */
  .form-section__form :global(.form-row) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
  }

  @media (min-width: 1001px) and (min-height: 760px) {
    .form-section__intro {
      position: sticky;
      top: calc(var(--header-gap) + var(--header-h) + 24px);
    }
  }

  /* The intro's pieces join the column (display: contents), so the form can come between the lead and the
     aside. */
  @media (max-width: 1000px) {
    .form-section__inner {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .form-section__intro {
      display: contents;
    }

    .form-section__form,
    .form-section__aside {
      width: 100%;
      margin-top: clamp(28px, 4vw, 40px);
    }

    .form-section__form {
      order: 1;
    }

    .form-section__aside {
      order: 2;
    }
  }
</style>
