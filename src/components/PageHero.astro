---
import FloatingShapes from './FloatingShapes.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}
const { eyebrow, title, lead, crumbs = [] } = Astro.props;
// An illustration (components/art/) passed as <Fragment slot="art"> sits beside the text.
const hasArt = Astro.slots.has('art');
---

<section class:list={['page-hero', { 'page-hero--art': hasArt }]}>
  <FloatingShapes variant={hasArt ? 'art' : 'page'} />
  <div class="container page-hero__inner">
    <div class="page-hero__text">
    {
      crumbs.length > 0 && (
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumbs">
            <li>
              <a href="/">Home</a>
            </li>
            {crumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 set:html={title} />
    {lead && <p class="lead">{lead}</p>}
    <slot />
    </div>
    {
      hasArt && (
        <div class="page-hero__art">
          <slot name="art" />
        </div>
      )
    }
  </div>
</section>
