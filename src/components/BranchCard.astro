---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Branch } from '../data/branches';
import { branchPhotos, shortName, telHref } from '../data/branches';

interface Props {
  branch: Branch;
  index?: number;
  /** How wide the photo is drawn (the card less its border and 16px padding), for its `sizes`. The
      default fits `.grid--3` in a `.container` (one card a row below 560px, two below 880px, then
      three of at most 377px); pass your own if the cards sit in another layout, such as a strip. */
  sizes?: string;
  /** The centre's short introduction under its area (the Branches page). */
  showIntro?: boolean;
  /** The heading level of the centre's name: 2 where the cards are the page's main list (the Branches page). */
  level?: 2 | 3;
}
const {
  branch,
  index = 0,
  sizes = '(max-width: 559.98px) calc(100vw - 66px), (max-width: 640px) calc(50vw - 62px), (max-width: 879.98px) calc(50vw - 66px), (max-width: 1219.98px) calc(33.3vw - 63px), 344px',
  showIntro = false,
  level = 3,
} = Astro.props;
const Name = level === 2 ? 'h2' : 'h3';
const tones = ['navy', 'green', 'coral', 'sky', 'sun'];
const tone = tones[index % tones.length];
const cover = branchPhotos(branch.slug)[0];
---

<article class:list={['branch-card', 'card', `tone-${tone}`]}>
  <div class="branch-card__media">
    {
      cover ? (
        <Image src={cover} alt={`Inside ${branch.name}`} widths={[400, 640, 800, 1000]} sizes={sizes} />
      ) : (
        <div class="branch-card__art" aria-hidden="true">
          <Icon name="Building2" size={44} strokeWidth={1.6} />
        </div>
      )
    }
    <span class="branch-card__pin"><Icon name="MapPin" size={16} /> {branch.pincode}</span>
  </div>
  <Name class="branch-card__name"><a href={`/branch/${branch.slug}`}>{shortName(branch)}</a></Name>
  <p class="muted">{branch.area}</p>
  {showIntro && branch.intro && <p class="branch-card__intro">{branch.intro}</p>}
  <ul class="branch-card__facts">
    {
      branch.carpetArea && (
        <li>
          <Icon name="Ruler" size={18} />
          {branch.carpetArea}
        </li>
      )
    }
    {
      branch.capacity && (
        <li>
          <Icon name="Users" size={18} />
          {branch.capacity} children
        </li>
      )
    }
  </ul>
  {/* "View branch" and a round call button, on one row however narrow the card or wide the theme's
      font. "branch-card" tells the call log (scripts/call-log.ts) that a call came from a branch card. */}
  <div class="branch-card__actions">
    <a class="btn btn--sm branch-card__view" href={`/branch/${branch.slug}`}>View branch</a>
    <a class="btn btn--sm btn--ghost branch-card__call" href={telHref(branch.phone)} aria-label={`Call ${branch.name}`}>
      <Icon name="Phone" size={18} />
    </a>
  </div>
</article>

<style>
  .branch-card {
    display: flex;
    flex-direction: column;
    padding: 16px 16px 22px;
  }
  .branch-card > :not(.branch-card__media) {
    margin-inline: 8px;
  }
  .branch-card__media {
    position: relative;
    margin-bottom: 18px;
    border-radius: 14px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2, var(--badge-bg)) 100%);
  }
  .branch-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .branch-card:hover .branch-card__media :global(img) {
    transform: scale(1.05);
  }
  .branch-card__art {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--badge-fg);
    background:
      radial-gradient(circle at 15% 85%, var(--tone) 0 34px, transparent 35px),
      radial-gradient(circle at 88% 18%, rgb(255 255 255 / 70%) 0 46px, transparent 47px),
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2, var(--badge-bg)) 100%);
  }
  /* Dark mode (a branch without photos): softer bubbles in the branch's colour instead of a white one
     and a full-strength dot, which glare on the night tint. */
  :global(:root[data-mode='dark']) .branch-card__art {
    background:
      radial-gradient(circle at 15% 85%, color-mix(in srgb, var(--tone) 55%, transparent) 0 34px, transparent 35px),
      radial-gradient(circle at 88% 18%, color-mix(in srgb, var(--badge-fg) 22%, transparent) 0 46px, transparent 47px),
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2, var(--badge-bg)) 100%);
  }
  .branch-card__pin {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim);
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--ink);
  }
  /* The name looks the same as an h2 (the Branches page) as it does as an h3, without the page headings'
     gradient. */
  .branch-card__name {
    margin-bottom: 0.35em;
    font-size: 1.3rem;
    background: none;
    color: var(--ink);
  }
  .branch-card__name a {
    color: var(--ink);
    text-decoration: none;
  }
  .branch-card__name a:hover {
    color: var(--navy);
  }
  .branch-card .muted {
    margin-bottom: 12px;
  }
  .branch-card__intro {
    margin: -2px 0 18px;
    font-size: 0.97rem;
    line-height: 1.55;
  }
  /* The facts sit with the buttons at the foot of the card, so they line up across a row even when
     a name or an area takes two lines in one card and one line in the next. */
  .branch-card__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: auto 0 18px;
    padding: 0;
    list-style: none;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .branch-card__facts li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .branch-card__facts :global(svg) {
    flex: none;
    color: var(--badge-fg);
  }
  .branch-card__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }
  .branch-card__facts + .branch-card__actions {
    margin-top: 0;
  }
  .branch-card__view {
    flex: 1;
    min-width: 0;
    padding-inline: 12px;
    white-space: nowrap;
  }
  .branch-card__call {
    flex: none;
    width: 40px;
    padding: 0;
  }
</style>
