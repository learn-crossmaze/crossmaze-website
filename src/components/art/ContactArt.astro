---
// Contact page banner: a message flies from a phone as a paper plane towards a letter, and a child
// waves hello.
import Person from './Person.astro';
---

<svg class="art" viewBox="0 0 480 400" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="contact-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color:var(--tint-5)"></stop>
      <stop offset="1" style="stop-color:var(--tint-3)"></stop>
    </linearGradient>
  </defs>
  <path d="M238 20c102 0 186 54 202 144 16 92-38 188-136 212-94 24-208 8-260-74C-6 222 8 118 74 66 118 32 176 20 238 20z" fill="url(#contact-bg)"></path>
  <ellipse cx="250" cy="354" rx="190" ry="16" style="fill:color-mix(in srgb, var(--tint-3) 70%, #fff)"></ellipse>

  <!-- phone with a chat -->
  <g transform="rotate(-6 128 214)">
    <rect x="66" y="96" width="124" height="230" rx="24" style="fill:var(--navy)"></rect>
    <rect x="76" y="118" width="104" height="186" rx="14" fill="#fff"></rect>
    <rect x="114" y="104" width="28" height="5" rx="2.5" fill="#fff" fill-opacity=".4"></rect>
    <rect x="86" y="132" width="62" height="26" rx="12" style="fill:var(--tint-2)"></rect>
    <text x="96" y="150" class="art__chat">Hello!</text>
    <rect x="108" y="168" width="62" height="26" rx="12" style="fill:var(--sun)"></rect>
    <path d="M118 181h42" style="stroke:var(--sun-btn-fg, #131a3a)" stroke-opacity=".5" stroke-width="3" stroke-linecap="round"></path>
    <rect x="86" y="204" width="70" height="40" rx="12" style="fill:var(--tint-5)"></rect>
    <path d="M96 218h48M96 230h32" style="stroke:var(--navy)" stroke-opacity=".45" stroke-width="3" stroke-linecap="round"></path>
    <rect x="108" y="254" width="62" height="26" rx="12" style="fill:var(--coral)" fill-opacity=".85"></rect>
    <path d="M139 260c-3-5-11-2-8 3l8 7 8-7c3-5-5-8-8-3z" fill="#fff"></path>
  </g>

  <!-- the message flies off as a paper plane -->
  <path d="M186 150C226 70 268 150 236 156S236 80 312 92" fill="none" style="stroke:var(--navy)" stroke-opacity=".35" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round"></path>
  <g class="art__float">
    <path d="M318 96l70-30-26 66-14-22z" fill="#fff" style="stroke:var(--navy)" stroke-width="3" stroke-linejoin="round"></path>
    <path d="M348 110l40-44" style="stroke:var(--navy)" stroke-width="3" stroke-linecap="round"></path>
    <path d="M348 110l-4 18 18-6" fill="#fff" style="stroke:var(--navy)" stroke-width="3" stroke-linejoin="round"></path>
  </g>

  <!-- the letter -->
  <g transform="rotate(5 340 206)">
    <rect x="280" y="166" width="124" height="82" rx="10" fill="#fff" style="stroke:var(--navy)" stroke-width="3"></rect>
    <path d="M284 172l58 42 58-42" fill="none" style="stroke:var(--coral)" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"></path>
    <circle cx="342" cy="214" r="13" style="fill:var(--coral)"></circle>
    <path d="M342 210c-2-4-8-2-6 2l6 6 6-6c2-4-4-6-6-2z" fill="#fff"></path>
  </g>

  <Person x={238} y={352} scale={0.98} skin="#c68642" hair="pigtails" top="var(--sky)" dress arms="wave" accent="var(--coral)" />

  <g class="art__float" style="fill:var(--sun)">
    <path d="M430 60l4 9 10 1-7 7 2 10-9-5-9 5 2-10-7-7 10-1z"></path>
    <path d="M62 70l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1z" fill-opacity=".7"></path>
  </g>
</svg>

<style>
  .art__chat {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    fill: var(--ink);
  }
</style>
