---
// About page banner: three friends holding hands on a hill under a rainbow.
import Person from './Person.astro';

const arc = (r: number) => `M${240 - r} 322A${r} ${r} 0 0 1 ${240 + r} 322`;
const bands = [
  { r: 170, color: 'var(--coral)' },
  { r: 146, color: 'var(--sun)' },
  { r: 122, color: 'var(--green)' },
  { r: 98, color: 'var(--sky)' },
];
---

<svg class="art" viewBox="0 0 480 400" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="about-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color:var(--tint-5)"></stop>
      <stop offset="1" style="stop-color:var(--tint-1)"></stop>
    </linearGradient>
    <linearGradient id="about-hill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color:var(--tint-3)"></stop>
      <stop offset="1" style="stop-color:color-mix(in srgb, var(--tint-3) 70%, var(--green))"></stop>
    </linearGradient>
    <clipPath id="about-clip">
      <path d="M244 18c98 2 176 56 194 142 19 92-30 190-128 218-94 26-214 10-266-72C-6 226 8 118 76 64 120 30 180 16 244 18z"></path>
    </clipPath>
  </defs>
  <path d="M244 18c98 2 176 56 194 142 19 92-30 190-128 218-94 26-214 10-266-72C-6 226 8 118 76 64 120 30 180 16 244 18z" fill="url(#about-bg)"></path>
  <g clip-path="url(#about-clip)">
    {bands.map((b) => <path d={arc(b.r)} style={`stroke:${b.color}`} stroke-opacity=".78" stroke-width="22" fill="none" />)}
    <path d="M-10 330Q240 268 490 330V420H-10Z" fill="url(#about-hill)"></path>
    <g fill="#fff" fill-opacity=".9">
      <circle cx="96" cy="356" r="4"></circle>
      <circle cx="392" cy="352" r="4"></circle>
      <circle cx="430" cy="366" r="3"></circle>
      <circle cx="60" cy="372" r="3"></circle>
    </g>
    <g style="fill:var(--sun)">
      <circle cx="96" cy="356" r="1.8"></circle>
      <circle cx="392" cy="352" r="1.8"></circle>
    </g>
  </g>
  <g fill="#fff">
    <circle cx="62" cy="318" r="20"></circle>
    <circle cx="88" cy="308" r="26"></circle>
    <circle cx="114" cy="320" r="18"></circle>
    <circle cx="366" cy="320" r="18"></circle>
    <circle cx="392" cy="308" r="26"></circle>
    <circle cx="418" cy="318" r="20"></circle>
  </g>
  <g class="art__spin" style="transform-origin:398px 74px">
    <circle cx="398" cy="74" r="24" style="fill:var(--sun)"></circle>
    <path d="M398 34v-12M398 126v-12M358 74h-12M450 74h-12M370 46l-8-8M434 110l-8-8M370 102l-8 8M434 38l-8 8" style="stroke:var(--sun)" stroke-width="5" stroke-linecap="round"></path>
  </g>
  <g class="art__float">
    <path d="M108 112c-6-10-22-4-16 8l16 14 16-14c6-12-10-18-16-8z" style="fill:var(--coral)" fill-opacity=".85"></path>
    <path d="M150 74c-4-7-15-3-11 5l11 9 11-9c4-8-7-12-11-5z" style="fill:var(--coral)" fill-opacity=".6"></path>
  </g>
  <Person x={158} y={348} scale={1.12} skin="#e0ac69" hair="pigtails" top="var(--coral)" dress arms="out" accent="var(--sun)" />
  <Person x={240} y={350} scale={1.16} skin="#a8693c" hair="short" top="var(--sky)" arms="out" />
  <Person x={322} y={348} scale={1.1} skin="#c68642" hair="curly" top="var(--green)" dress arms="out" />
</svg>
