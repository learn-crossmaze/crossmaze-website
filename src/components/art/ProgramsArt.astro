---
// Programs page banner: towers of ABC blocks that grow step by step (Play Group to Senior KG),
// with a child celebrating on top.
import Person from './Person.astro';

const size = 54;
const ground = 352;
const colors = ['var(--coral)', 'var(--sun)', 'var(--green)', 'var(--sky)'];
const letters = 'ABCDEFGHIJ';
let n = 0;
const towers = colors.map((color, t) => ({
  x: 74 + t * 78,
  color,
  blocks: Array.from({ length: t + 1 }, (_, j) => ({ y: ground - size * (j + 1), letter: letters[n++] })),
}));
const top = towers.at(-1)!;
---

<svg class="art" viewBox="0 0 480 400" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="programs-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color:var(--tint-4)"></stop>
      <stop offset="1" style="stop-color:var(--tint-5)"></stop>
    </linearGradient>
  </defs>
  <path d="M232 20c104-4 196 50 214 144 18 96-40 186-142 212-96 24-210 10-262-70C-10 230 6 122 70 70 114 34 172 22 232 20z" fill="url(#programs-bg)"></path>
  <ellipse cx="230" cy="356" rx="196" ry="16" style="fill:var(--tint-3)"></ellipse>

  <path class="art__dash" d="M60 250C110 170 190 128 300 96" fill="none" style="stroke:var(--navy)" stroke-opacity=".35" stroke-width="3" stroke-dasharray="2 10" stroke-linecap="round"></path>

  {
    towers.map((t) =>
      t.blocks.map((b) => (
        <g>
          <path d={`M${t.x} ${b.y}l12 -12h${size}l-12 12z`} style={`fill:color-mix(in srgb, ${t.color} 55%, #fff)`} />
          <path d={`M${t.x + size} ${b.y}l12 -12v${size}l-12 12z`} style={`fill:color-mix(in srgb, ${t.color} 78%, #000)`} />
          <rect x={t.x} y={b.y} width={size} height={size} rx="6" style={`fill:${t.color}`} />
          <rect x={t.x + 7} y={b.y + 7} width={size - 14} height={size - 14} rx="5" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width="2.5" />
          <text x={t.x + size / 2} y={b.y + 38} text-anchor="middle" class="art__letter">
            {b.letter}
          </text>
        </g>
      )),
    )
  }

  <Person x={top.x + size / 2 + 4} y={top.blocks.at(-1)!.y - 4} scale={0.92} skin="#c68642" hair="curly" top="var(--coral)" arms="up" />

  <g class="art__float" style="fill:var(--sun)">
    <path d="M410 70l7 15 16 2-12 11 3 16-14-8-14 8 3-16-12-11 16-2z"></path>
    <path d="M444 140l4 8 9 1-7 6 2 9-8-5-8 5 2-9-7-6 9-1z" fill-opacity=".7"></path>
  </g>

  <g transform="translate(420 352)">
    <path d="M-16 0h32l-5 -26h-22z" style="fill:var(--coral)"></path>
    <path d="M0 -26c0-18 2-30 8-40" style="stroke:var(--green)" stroke-width="4" fill="none" stroke-linecap="round"></path>
    <path d="M2 -48c-16-2-22-12-20-18 12 0 18 6 20 18zM6 -58c12-6 22-4 24 2-8 6-16 6-24-2z" style="fill:var(--green)"></path>
  </g>
</svg>

<style>
  .art__letter {
    fill: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
  }
</style>
