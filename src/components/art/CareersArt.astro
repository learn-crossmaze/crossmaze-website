---
// Careers page banner: a teacher reading a story to two children, with a board of letters and
// numbers behind them.
import Person from './Person.astro';
---

<svg class="art" viewBox="0 0 480 400" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="careers-bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color:var(--tint-2)"></stop>
      <stop offset="1" style="stop-color:var(--tint-1)"></stop>
    </linearGradient>
  </defs>
  <path d="M240 20c100 0 182 54 198 142 17 92-36 188-134 214-94 25-210 8-262-74C-8 222 6 118 72 66 116 32 176 20 240 20z" fill="url(#careers-bg)"></path>
  <ellipse cx="250" cy="352" rx="190" ry="18" style="fill:color-mix(in srgb, var(--tint-4) 80%, #fff)"></ellipse>

  <!-- the board -->
  <path d="M86 236l-16 116M184 236l16 116" stroke="#b07a48" stroke-width="7" stroke-linecap="round"></path>
  <rect x="58" y="96" width="154" height="128" rx="10" fill="#b07a48"></rect>
  <rect x="66" y="104" width="138" height="112" rx="6" fill="#fff"></rect>
  <text x="80" y="148" class="art__chalk" style="fill:var(--coral)">A</text>
  <text x="114" y="148" class="art__chalk" style="fill:var(--sun-fg)">B</text>
  <text x="148" y="148" class="art__chalk" style="fill:var(--green)">C</text>
  <text x="80" y="198" class="art__chalk" style="fill:var(--sky)">1</text>
  <text x="114" y="198" class="art__chalk" style="fill:var(--navy)">2</text>
  <text x="148" y="198" class="art__chalk" style="fill:var(--coral)">3</text>

  <Person x={244} y={350} scale={1.12} adult skin="#c68642" hair="bun" top="var(--coral)" legs="var(--navy)" arms="hold" accent="var(--sun)" />

  <!-- the open book in the teacher's hands -->
  <g transform="translate(244 260)">
    <path d="M-38 -12q19-8 38 0v34q-19-8-38 0z" style="fill:var(--sky)"></path>
    <path d="M38 -12q-19-8-38 0v34q19-8 38 0z" style="fill:var(--sky)"></path>
    <path d="M-34 -10q17-7 34 0v30q-17-7-34 0z" fill="#fff"></path>
    <path d="M34 -10q-17-7-34 0v30q17-7 34 0z" fill="#fff"></path>
    <path d="M-28 -2h20M-28 5h20M-28 12h14M8 -2h20M8 5h20M8 12h14" style="stroke:color-mix(in srgb, var(--navy) 30%, #fff)" stroke-width="2" stroke-linecap="round"></path>
  </g>

  <g class="art__float" style="fill:var(--sun)">
    <path d="M318 132l5 10 11 1-8 8 2 11-10-5-10 5 2-11-8-8 11-1z"></path>
    <path d="M360 166l3 7 8 1-6 5 2 8-7-4-7 4 2-8-6-5 8-1z" fill-opacity=".7"></path>
    <path d="M298 184c-4-7-15-3-11 5l11 9 11-9c4-8-7-12-11-5z" style="fill:var(--coral)" fill-opacity=".8"></path>
  </g>

  <Person x={346} y={352} scale={0.86} skin="#e0ac69" hair="bob" top="var(--green)" dress arms="raise" />
  <Person x={414} y={352} scale={0.82} skin="#a8693c" hair="short" top="var(--sun)" arms="down" />
</svg>

<style>
  .art__chalk {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
  }
</style>
