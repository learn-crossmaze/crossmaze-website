---
// Animated background for page banners: a slowly shifting pastel wash plus floating preschool
// doodles (see doodles.ts). Purely decorative (aria-hidden) and still for visitors who prefer
// reduced motion.
import { doodle, pastel, type Colors, type DoodleKind } from './doodles';

interface Props {
  variant?: 'home' | 'page';
}
const { variant = 'page' } = Astro.props;

type Shape = {
  kind: DoodleKind;
  colors: Colors;
  size: number;
  top: string;
  left: string;
  motion: 'bob' | 'drift' | 'spin';
  dur: number;
  delay: number;
  letter?: string;
  /** Hidden once the banner stacks into one column (900px and narrower), where it would cover text. */
  hideOnMobile?: boolean;
  /** Where to put the shape in the one-column layout, if different (keeps it clear of the text). */
  mobile?: { top: string; left: string };
};

const home: Shape[] = [
  { kind: 'cloud', colors: pastel.sky, size: 130, top: '6%', left: '34%', motion: 'drift', dur: 28, delay: -4, hideOnMobile: true },
  { kind: 'star', colors: pastel.butter, size: 40, top: '14%', left: '4%', motion: 'spin', dur: 22, delay: 0, hideOnMobile: true },
  { kind: 'balloon', colors: pastel.pink, size: 54, top: '58%', left: '2%', motion: 'bob', dur: 7, delay: -2, mobile: { top: '47%', left: '86%' } },
  { kind: 'plane', colors: pastel.lavender, size: 48, top: '80%', left: '28%', motion: 'drift', dur: 16, delay: -5 },
  { kind: 'block', colors: pastel.mint, size: 50, top: '84%', left: '46%', motion: 'bob', dur: 8, delay: -1, letter: 'A', hideOnMobile: true },
  { kind: 'sun', colors: pastel.butter, size: 60, top: '6%', left: '87%', motion: 'bob', dur: 9, delay: -8 },
  { kind: 'crayon', colors: pastel.peach, size: 44, top: '24%', left: '46%', motion: 'bob', dur: 6, delay: -3, hideOnMobile: true },
  { kind: 'block', colors: pastel.pink, size: 46, top: '88%', left: '92%', motion: 'bob', dur: 9, delay: -4, letter: 'B', hideOnMobile: true },
  { kind: 'kite', colors: pastel.sky, size: 58, top: '30%', left: '94%', motion: 'bob', dur: 10, delay: -6, hideOnMobile: true },
  { kind: 'rainbow', colors: pastel.pink, size: 70, top: '86%', left: '64%', motion: 'bob', dur: 11, delay: -5, hideOnMobile: true },
];

const page: Shape[] = [
  { kind: 'cloud', colors: pastel.sky, size: 110, top: '10%', left: '62%', motion: 'drift', dur: 26, delay: -3, mobile: { top: '1%', left: '66%' } },
  { kind: 'star', colors: pastel.butter, size: 34, top: '18%', left: '90%', motion: 'spin', dur: 20, delay: -2 },
  { kind: 'balloon', colors: pastel.pink, size: 48, top: '56%', left: '84%', motion: 'bob', dur: 7, delay: -1, hideOnMobile: true },
  { kind: 'plane', colors: pastel.lavender, size: 40, top: '30%', left: '53%', motion: 'drift', dur: 15, delay: -6, hideOnMobile: true },
  { kind: 'crayon', colors: pastel.peach, size: 42, top: '80%', left: '1.5%', motion: 'bob', dur: 9, delay: -4, hideOnMobile: true },
  { kind: 'block', colors: pastel.mint, size: 40, top: '12%', left: '46%', motion: 'bob', dur: 9, delay: -2, letter: 'C', hideOnMobile: true },
  { kind: 'rainbow', colors: pastel.pink, size: 66, top: '62%', left: '68%', motion: 'bob', dur: 12, delay: -7, hideOnMobile: true },
];

const shapes = variant === 'home' ? home : page;
---

<div class:list={['fx', `fx--${variant}`]} aria-hidden="true">
  <div class="fx__aurora"></div>
  {
    shapes.map((s) => (
      <span
        class:list={['fx__shape', `fx__shape--${s.motion}`, { 'fx__shape--desktop': s.hideOnMobile }]}
        style={`--size:${s.size}px;--top:${s.top};--left:${s.left};--dur:${s.dur}s;--delay:${s.delay}s${s.mobile ? `;--top-m:${s.mobile.top};--left-m:${s.mobile.left}` : ''}`}
      >
        <svg viewBox="0 0 100 100" set:html={doodle(s.kind, s.colors, s.letter)} />
      </span>
    ))
  }
</div>

<style>
  .fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .fx__aurora {
    position: absolute;
    inset: -25%;
    background:
      radial-gradient(32% 40% at 18% 28%, #ffe1ec 0%, transparent 70%),
      radial-gradient(30% 38% at 78% 22%, #e4dbff 0%, transparent 70%),
      radial-gradient(34% 40% at 70% 78%, #d6f3e4 0%, transparent 70%),
      radial-gradient(30% 36% at 28% 82%, #fff1c2 0%, transparent 70%),
      radial-gradient(26% 30% at 50% 50%, #e1efff 0%, transparent 70%);
    animation: fx-aurora 26s ease-in-out infinite alternate;
  }

  @keyframes fx-aurora {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate3d(5%, -4%, 0) rotate(10deg) scale(1.08);
    }
    100% {
      transform: translate3d(-4%, 5%, 0) rotate(-8deg) scale(1.04);
    }
  }

  .fx__shape {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: var(--size);
    animation-duration: var(--dur);
    animation-delay: var(--delay);
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
    opacity: 0.95;
  }

  .fx__shape svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .fx__shape--bob {
    animation-name: fx-bob;
    animation-direction: alternate;
  }

  .fx__shape--drift {
    animation-name: fx-drift;
    animation-direction: alternate;
  }

  .fx__shape--spin {
    animation-name: fx-spin;
    animation-timing-function: linear;
  }

  @keyframes fx-bob {
    from {
      transform: translateY(0) rotate(-4deg);
    }
    to {
      transform: translateY(-18px) rotate(4deg);
    }
  }

  @keyframes fx-drift {
    from {
      transform: translateX(-30px);
    }
    to {
      transform: translateX(40px);
    }
  }

  @keyframes fx-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 900px) {
    .fx__shape--desktop {
      display: none;
    }
    .fx__shape {
      top: var(--top-m, var(--top));
      left: var(--left-m, var(--left));
    }
  }

  @media (max-width: 760px) {
    .fx__shape {
      width: calc(var(--size) * 0.7);
    }
  }
</style>
