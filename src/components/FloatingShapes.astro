---
// Animated background for page banners: a slowly shifting pastel wash plus floating preschool
// doodles (see doodles.ts). Purely decorative (aria-hidden) and still for visitors who prefer
// reduced motion.
import { doodle, nightOf, pastel, type Colors, type DoodleKind } from './doodles';

interface Props {
  variant?: 'home' | 'page';
}
const { variant = 'page' } = Astro.props;

type Shape = {
  kind: DoodleKind;
  colors: Colors;
  size: number;
  top: string;
  left: string;
  motion: 'bob' | 'drift' | 'spin';
  dur: number;
  delay: number;
  letter?: string;
  /** Hidden once the banner stacks into one column (900px and narrower), where it would cover text. */
  hideOnMobile?: boolean;
  /** Where to put the shape in the one-column layout, if different (keeps it clear of the text). */
  mobile?: { top: string; left: string };
};

// A few doodles only, so the banners stay calm and the text has room.
const home: Shape[] = [
  { kind: 'cloud', colors: pastel.sky, size: 120, top: '6%', left: '34%', motion: 'drift', dur: 28, delay: -4, hideOnMobile: true },
  { kind: 'sun', colors: pastel.butter, size: 58, top: '6%', left: '87%', motion: 'bob', dur: 9, delay: -8 },
  { kind: 'balloon', colors: pastel.pink, size: 50, top: '58%', left: '2%', motion: 'bob', dur: 7, delay: -2, mobile: { top: '47%', left: '86%' } },
  { kind: 'plane', colors: pastel.lavender, size: 46, top: '80%', left: '28%', motion: 'drift', dur: 16, delay: -5 },
];

const page: Shape[] = [
  { kind: 'cloud', colors: pastel.sky, size: 104, top: '10%', left: '62%', motion: 'drift', dur: 26, delay: -3, mobile: { top: '1%', left: '66%' } },
  { kind: 'star', colors: pastel.butter, size: 32, top: '18%', left: '90%', motion: 'spin', dur: 20, delay: -2 },
  { kind: 'balloon', colors: pastel.pink, size: 46, top: '56%', left: '84%', motion: 'bob', dur: 7, delay: -1, hideOnMobile: true },
];

const shapes = variant === 'home' ? home : page;
---

<div class:list={['fx', `fx--${variant}`]} aria-hidden="true">
  <div class="fx__aurora"></div>
  <div class="fx__shapes">
    {
      shapes.map((s) => (
        <span
          class:list={['fx__shape', `fx__shape--${s.motion}`, `fx__shape--${s.kind}`, { 'fx__shape--desktop': s.hideOnMobile }]}
          style={`--size:${s.size}px;--top:${s.top};--left:${s.left};--dur:${s.dur}s;--delay:${s.delay}s${s.mobile ? `;--top-m:${s.mobile.top};--left-m:${s.mobile.left}` : ''}`}
        >
          <svg class="fx__day" viewBox="0 0 100 100" set:html={doodle(s.kind, s.colors, s.letter)} />
          <svg class="fx__night" viewBox="0 0 100 100" set:html={doodle(s.kind, nightOf(s.colors), s.letter, true)} />
        </span>
      ))
    }
  </div>
</div>

<style>
  .fx {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .fx__aurora {
    position: absolute;
    inset: -25%;
    background:
      radial-gradient(32% 40% at 18% 28%, color-mix(in srgb, var(--tint-1) 70%, #fff) 0%, transparent 70%),
      radial-gradient(30% 38% at 78% 22%, var(--tint-2) 0%, transparent 70%),
      radial-gradient(34% 40% at 70% 78%, var(--tint-3) 0%, transparent 70%),
      radial-gradient(30% 36% at 28% 82%, var(--tint-4) 0%, transparent 70%),
      radial-gradient(26% 30% at 50% 50%, color-mix(in srgb, var(--tint-5) 60%, #fff) 0%, transparent 70%);
    /* Fade out well before the banner's bottom edge so it melts into the page gradient. */
    -webkit-mask-image: linear-gradient(180deg, #000 0%, #000 40%, transparent 70%);
    mask-image: linear-gradient(180deg, #000 0%, #000 40%, transparent 70%);
    animation: fx-aurora 26s ease-in-out infinite alternate;
  }

  /* The doodles stay below the header when the banner reaches up behind it (global.css). */
  .fx__shapes {
    position: absolute;
    inset: var(--under-header, 0px) 0 0;
  }

  @keyframes fx-aurora {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate3d(5%, -3%, 0) rotate(6deg) scale(1.06);
    }
    100% {
      transform: translate3d(-4%, 3%, 0) rotate(-5deg) scale(1.03);
    }
  }

  .fx__shape {
    position: absolute;
    top: var(--top);
    left: var(--left);
    width: var(--size);
    animation-duration: var(--dur);
    animation-delay: var(--delay);
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
    opacity: 0.85;
  }

  .fx__shape svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .fx__shape--bob {
    animation-name: fx-bob;
    animation-direction: alternate;
  }

  .fx__shape--drift {
    animation-name: fx-drift;
    animation-direction: alternate;
  }

  .fx__shape--spin {
    animation-name: fx-spin;
    animation-timing-function: linear;
  }

  @keyframes fx-bob {
    from {
      transform: translateY(0) rotate(-4deg);
    }
    to {
      transform: translateY(-18px) rotate(4deg);
    }
  }

  @keyframes fx-drift {
    from {
      transform: translateX(-30px);
    }
    to {
      transform: translateX(40px);
    }
  }

  @keyframes fx-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 900px) {
    .fx__shape--desktop {
      display: none;
    }
    .fx__shape {
      top: var(--top-m, var(--top));
      left: var(--left-m, var(--left));
    }
  }

  @media (max-width: 760px) {
    .fx__shape {
      width: calc(var(--size) * 0.7);
    }
  }

  /* Dark mode: the wash glows in the theme's night tints (mixing in white would turn it into a grey
     haze), and the pastel doodles are dimmed so they glow softly instead of glaring. */
  :global(:root[data-mode='dark']) .fx__aurora {
    background:
      radial-gradient(32% 40% at 18% 28%, var(--tint-1) 0%, transparent 70%),
      radial-gradient(30% 38% at 78% 22%, var(--tint-2) 0%, transparent 70%),
      radial-gradient(34% 40% at 70% 78%, var(--tint-3) 0%, transparent 70%),
      radial-gradient(30% 36% at 28% 82%, var(--tint-4) 0%, transparent 70%),
      radial-gradient(26% 30% at 50% 50%, var(--tint-5) 0%, transparent 70%);
    opacity: 0.75;
  }

  /* Each doodle comes in day pastels and night colours (doodles.ts); dimmed pastels turn grey. */
  .fx__night,
  :global(:root[data-mode='dark']) .fx__day {
    display: none;
  }

  :global(:root[data-mode='dark']) .fx__night {
    display: block;
  }
</style>
