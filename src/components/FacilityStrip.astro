---
// The facilities as a scrolling strip of photo cards (home page; the scrolling is Strip's). Swipe,
// scroll sideways or use the arrows; tapping a photo opens it large in the facilities album, with its
// name and description.
// Photos are set per facility in the admin panel (Page sections → Facilities); a facility without a
// photo shows its icon on a soft tint instead.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import PhotoAlbum from './PhotoAlbum.astro';
import Strip from './Strip.astro';
import { hasImage, image } from '../data/content';
import type { SectionsContent } from '../data/content';

interface Props {
  items: SectionsContent['facilities'];
}

const { items } = Astro.props;
const tones = ['coral', 'sun', 'green', 'sky', 'navy'];
const cards = items.map((f, i) => ({ ...f, tone: tones[i % tones.length], photo: hasImage(f.image) ? image(f.image) : undefined }));
const withPhotos = cards.filter((c) => c.photo);
// Without JavaScript a photo link opens the full-size photo.
const fullSize = await Promise.all(withPhotos.map((c) => getImage({ src: c.photo!, width: 1400, format: 'webp' })));
const albumIndex = new Map(withPhotos.map((c, i) => [c, i]));

// How wide a photo is drawn, for its `sizes`: the frame's width (the card width, Strip's --strip-col,
// less the 5px glass ring each side). A photo wider than the 16:10 frame is cropped from a copy as tall
// as the frame, so wider than it.
const frameWidths = [
  ['(max-width: 640px)', '76vw - 10px'],
  ['(max-width: 961px)', '240px'],
  ['(max-width: 1307px)', '26vw - 10px'],
  ['', '330px'],
];
function sizesFor(photo: ImageMetadata) {
  const spill = photo.width / photo.height / (16 / 10);
  return frameWidths
    .map(([media, width]) => `${media} ${spill > 1.02 ? `calc((${width}) * ${spill.toFixed(2)})` : width.includes(' ') ? `calc(${width})` : width}`.trim())
    .join(', ');
}
---

<Strip label="facilities" style="--strip-nav-top: calc(12px + (var(--strip-col) - 10px) * 10 / 16 / 2 + 5px)">
  {
    cards.map((card) => (
      <li class:list={['facility', `tone-${card.tone}`]}>
        {card.photo ? (
          <a
            class="facility__photo"
            href={fullSize[albumIndex.get(card)!]!.src}
            data-album-for="facilities"
            data-album-open={albumIndex.get(card)}
            aria-haspopup="dialog"
          >
            <span class="facility__frame">
              <Image src={card.photo} alt={card.title} widths={[360, 480, 660, 960]} sizes={sizesFor(card.photo)} />
            </span>
            <span class="icon-badge facility__badge">
              <Icon name={card.icon} size={22} />
            </span>
          </a>
        ) : (
          <span class="facility__photo facility__photo--icon">
            <span class="facility__frame">
              <Icon name={card.icon} size={56} />
            </span>
          </span>
        )}
        <h3 class="facility__title">{card.title}</h3>
        {card.text && <p class="facility__text muted">{card.text}</p>}
      </li>
    ))
  }
</Strip>

{
  withPhotos.length > 0 && (
    <PhotoAlbum
      id="facilities"
      photos={withPhotos.map((c) => c.photo!)}
      title="Our facilities"
      alt={(n) => withPhotos[n - 1]!.title}
      captions={withPhotos.map((c) => ({ title: c.title, text: c.text }))}
    />
  )
}

<style>
  .facility {
    display: grid;
    align-content: start;
  }

  .facility__photo {
    position: relative;
    display: block;
    padding: 5px;
    border-radius: var(--radius-photo-sm);
    background: var(--g-ring);
    box-shadow: var(--shadow-sm);
    cursor: zoom-in;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .facility__photo:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  /* Every photo, whatever its shape, is cropped from its centre to the same 16:10 frame. The photo is
     taken out of the grid: as a grid item it would set the row to its own height and lose its bottom. */
  .facility__frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: inherit;
  }

  .facility__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .facility__photo:hover :global(img) {
    transform: scale(1.06);
  }

  .facility__photo--icon {
    cursor: default;
  }

  .facility__photo--icon .facility__frame {
    background:
      radial-gradient(70% 70% at 30% 25%, rgb(255 255 255 / 75%), transparent 70%),
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2) 100%);
    color: var(--badge-fg);
  }

  .facility__badge {
    position: absolute;
    left: 18px;
    bottom: -20px;
    width: 46px;
    height: 46px;
    margin: 0;
    border: 3px solid #fff;
    border-radius: 14px;
  }

  .facility__title {
    margin: 30px 4px 4px;
    font-size: 1.15rem;
  }

  .facility__photo--icon + .facility__title {
    margin-top: 16px;
  }

  .facility__text {
    margin: 0 4px;
    font-size: 0.94rem;
    line-height: 1.5;
  }

  /* Dark mode: the badge's white sticker edge would glare, so its edge is the photo's glass frame
     (over smoky glass, so it stays clear of the photo), and a facility without a photo gets a faint
     highlight instead of a white one. */
  :global(:root[data-mode='dark']) .facility__badge {
    border-color: transparent;
    background:
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2) 100%) padding-box,
      var(--g-ring) border-box,
      var(--glass-thick) border-box;
  }

  :global(:root[data-mode='dark']) .facility__photo--icon .facility__frame {
    background:
      radial-gradient(70% 70% at 30% 25%, var(--glass-edge), transparent 70%),
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2) 100%);
  }
</style>
