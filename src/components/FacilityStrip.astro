---
// The facilities as a scrolling strip of photo cards (home page). Swipe, scroll sideways or use the
// arrows; tapping a photo opens it large in the facilities album, with its name and description.
// Photos are set per facility in the admin panel (Page sections → Facilities); a facility without a
// photo shows its icon on a soft tint instead.
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import PhotoAlbum from './PhotoAlbum.astro';
import { hasImage, image } from '../data/content';
import type { SectionsContent } from '../data/content';

interface Props {
  items: SectionsContent['facilities'];
}

const { items } = Astro.props;
const tones = ['coral', 'sun', 'green', 'sky', 'navy'];
const cards = items.map((f, i) => ({ ...f, tone: tones[i % tones.length], photo: hasImage(f.image) ? image(f.image) : undefined }));
const withPhotos = cards.filter((c) => c.photo);
// Without JavaScript a photo link opens the full-size photo.
const fullSize = await Promise.all(withPhotos.map((c) => getImage({ src: c.photo!, width: 1400, format: 'webp' })));
const albumIndex = new Map(withPhotos.map((c, i) => [c, i]));
---

<div class="strip" data-strip>
  <ul class="strip__track" data-strip-track>
    {
      cards.map((card) => (
        <li class:list={['strip__item', `tone-${card.tone}`]}>
          {card.photo ? (
            <a
              class="strip__photo"
              href={fullSize[albumIndex.get(card)!]!.src}
              data-album-for="facilities"
              data-album-open={albumIndex.get(card)}
              aria-haspopup="dialog"
            >
              <span class="strip__frame">
                <Image src={card.photo} alt={card.title} widths={[360, 560, 800]} sizes="(max-width: 640px) 76vw, 340px" />
              </span>
              <span class="icon-badge strip__badge">
                <Icon name={card.icon} size={22} />
              </span>
            </a>
          ) : (
            <span class="strip__photo strip__photo--icon">
              <span class="strip__frame">
                <Icon name={card.icon} size={56} />
              </span>
            </span>
          )}
          <h3 class="strip__title">{card.title}</h3>
          {card.text && <p class="strip__text muted">{card.text}</p>}
        </li>
      ))
    }
  </ul>
  <button type="button" class="strip__nav strip__nav--prev" data-strip-prev aria-label="Previous facilities">
    <Icon name="ChevronLeft" size={26} />
  </button>
  <button type="button" class="strip__nav strip__nav--next" data-strip-next aria-label="More facilities">
    <Icon name="ChevronRight" size={26} />
  </button>
</div>

{
  withPhotos.length > 0 && (
    <PhotoAlbum
      id="facilities"
      photos={withPhotos.map((c) => c.photo!)}
      title="Our facilities"
      alt={(n) => withPhotos[n - 1]!.title}
      captions={withPhotos.map((c) => ({ title: c.title, text: c.text }))}
    />
  )
}

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const track = strip.querySelector<HTMLElement>('[data-strip-track]')!;
    const prev = strip.querySelector<HTMLButtonElement>('[data-strip-prev]')!;
    const next = strip.querySelector<HTMLButtonElement>('[data-strip-next]')!;

    function update() {
      const max = track.scrollWidth - track.clientWidth;
      const atStart = track.scrollLeft <= 4;
      const atEnd = track.scrollLeft >= max - 4;
      strip.classList.toggle('is-scrollable', max > 4);
      strip.classList.toggle('at-start', atStart);
      strip.classList.toggle('at-end', atEnd);
      prev.disabled = atStart;
      next.disabled = atEnd;
    }

    /** Moves by the cards that fit on screen, so each press shows a fresh set. */
    function page(direction: number) {
      const card = track.querySelector<HTMLElement>('.strip__item');
      if (!card) return;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const step = card.offsetWidth + gap;
      const perPage = Math.max(1, Math.floor((track.clientWidth - gap) / step) - 1 || 1);
      track.scrollBy({ left: direction * perPage * step, behavior: reduced.matches ? 'auto' : 'smooth' });
    }

    prev.addEventListener('click', () => page(-1));
    next.addEventListener('click', () => page(1));

    let ticking = false;
    track.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          update();
        });
      },
      { passive: true },
    );
    addEventListener('resize', update);
    update();
  });
</script>

<style>
  .strip {
    --strip-inset: max(var(--gutter), calc((100vw - var(--container)) / 2));
    position: relative;
    /* Full width of the window, with the first card lined up with the page content. */
    margin-inline: calc(50% - 50vw);
  }

  .strip__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(250px, 26vw, 340px);
    gap: 24px;
    margin: 0;
    padding: 12px var(--strip-inset) 26px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--strip-inset);
    scrollbar-width: none;
  }

  .strip__track::-webkit-scrollbar {
    display: none;
  }

  /* Soft fades at the edges hint that there is more to scroll to. */
  .strip.is-scrollable .strip__track {
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--strip-inset), #000 calc(100% - var(--strip-inset)), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--strip-inset), #000 calc(100% - var(--strip-inset)), transparent 100%);
  }

  .strip.is-scrollable.at-start .strip__track {
    -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - var(--strip-inset)), transparent 100%);
    mask-image: linear-gradient(90deg, #000 calc(100% - var(--strip-inset)), transparent 100%);
  }

  .strip.is-scrollable.at-end .strip__track {
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 var(--strip-inset));
    mask-image: linear-gradient(90deg, transparent 0, #000 var(--strip-inset));
  }

  .strip__item {
    display: grid;
    align-content: start;
    scroll-snap-align: start;
  }

  .strip__photo {
    position: relative;
    display: block;
    padding: 5px;
    border-radius: var(--radius-photo-sm);
    background: var(--g-ring);
    box-shadow: var(--shadow-sm);
    cursor: zoom-in;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .strip__photo:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lift);
  }

  .strip__frame {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: inherit;
  }

  .strip__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .strip__photo:hover :global(img) {
    transform: scale(1.06);
  }

  .strip__photo--icon {
    cursor: default;
  }

  .strip__photo--icon .strip__frame {
    background:
      radial-gradient(70% 70% at 30% 25%, rgb(255 255 255 / 75%), transparent 70%),
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2) 100%);
    color: var(--badge-fg);
  }

  .strip__badge {
    position: absolute;
    left: 18px;
    bottom: -20px;
    width: 46px;
    height: 46px;
    margin: 0;
    border: 3px solid #fff;
    border-radius: 14px;
  }

  .strip__title {
    margin: 30px 4px 4px;
    font-size: 1.15rem;
  }

  .strip__photo--icon + .strip__title {
    margin-top: 16px;
  }

  .strip__text {
    margin: 0 4px;
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .strip__nav {
    position: absolute;
    top: calc(12px + (clamp(250px, 26vw, 340px) - 10px) * 10 / 16 / 2 + 5px);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-top: -26px;
    border: 1px solid var(--glass-edge);
    border-radius: 50%;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow);
    color: var(--navy);
    cursor: pointer;
    transition:
      opacity 0.25s ease,
      transform 0.2s ease;
  }

  .strip__nav:hover {
    transform: scale(1.06);
  }

  .strip__nav:disabled {
    opacity: 0;
    pointer-events: none;
  }

  .strip:not(.is-scrollable) .strip__nav {
    display: none;
  }

  .strip__nav--prev {
    left: max(12px, calc(var(--strip-inset) - 26px));
  }

  .strip__nav--next {
    right: max(12px, calc(var(--strip-inset) - 26px));
  }

  /* Dark mode: the badge's white sticker edge would glare, so its edge is the photo's glass frame
     (over smoky glass, so it stays clear of the photo), and a facility without a photo gets a faint
     highlight instead of a white one. */
  :global(:root[data-mode='dark']) .strip__badge {
    border-color: transparent;
    background:
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2) 100%) padding-box,
      var(--g-ring) border-box,
      var(--glass-thick) border-box;
  }

  :global(:root[data-mode='dark']) .strip__photo--icon .strip__frame {
    background:
      radial-gradient(70% 70% at 30% 25%, var(--glass-edge), transparent 70%),
      linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2) 100%);
  }

  /* Phones: bigger cards that peek in from the edge; swipe instead of the arrows. */
  @media (max-width: 640px) {
    .strip__track {
      grid-auto-columns: 76vw;
      gap: 16px;
    }
    .strip__nav {
      display: none;
    }
  }
</style>
