---
// Placeholder mark: a rounded maze tile. Swap in the official logo by
// replacing this component's SVG with an <img src="/logo.svg">.
interface Props {
  inverted?: boolean;
}
const { inverted = false } = Astro.props;
---

<span class:list={['logo', { 'logo--inverted': inverted }]}>
  <svg class="logo__mark" viewBox="0 0 48 48" width="40" height="40" aria-hidden="true">
    <rect width="48" height="48" rx="14" fill="#4b2a8c"></rect>
    <path
      d="M12 12h24v24H18V18h12v12h-6"
      fill="none"
      stroke="#ffc23d"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <circle cx="24" cy="30" r="3.2" fill="#ff6f59"></circle>
  </svg>
  <span class="logo__text">
    <span class="logo__name">Crossmaze</span>
    <span class="logo__sub">Preschool &amp; Day Care</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
  }
  .logo__text {
    display: grid;
    line-height: 1.05;
  }
  .logo__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.45rem;
    letter-spacing: -0.01em;
    color: var(--plum);
  }
  .logo__sub {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .logo--inverted .logo__name {
    color: #fff;
  }
  .logo--inverted .logo__sub {
    color: rgb(255 255 255 / 70%);
  }
</style>
