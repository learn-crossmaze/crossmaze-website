---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Program } from '../data/programs';

interface Props {
  program: Program;
}
const { program } = Astro.props;
---

<a class:list={['program-card', 'card', `tone-${program.color}`]} href={`/our-programs#${program.slug}`}>
  <span class="program-card__media">
    <Image src={program.photo} alt={program.photoAlt} widths={[360, 560]} sizes="(max-width: 700px) 100vw, 360px" />
    <span class="icon-badge"><Icon name={program.icon} size={24} /></span>
  </span>
  <span class="program-card__body">
    <span class="pill">{program.ages}</span>
    <h3>{program.name}</h3>
    <p>{program.summary}</p>
    <span class="program-card__more">Learn more <Icon name="ArrowRight" size={18} /></span>
  </span>
</a>

<style>
  .program-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .program-card:hover {
    color: inherit;
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .program-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: var(--badge-bg);
  }
  .program-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .program-card__media .icon-badge {
    position: absolute;
    left: 20px;
    bottom: -24px;
    margin: 0;
    border: 4px solid var(--paper);
    box-sizing: content-box;
  }
  .program-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 40px 24px 24px;
  }
  .program-card .pill {
    align-self: flex-start;
    margin-bottom: 10px;
  }
  .program-card p {
    color: var(--muted);
    flex: 1;
  }
  .program-card__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-weight: 800;
    color: var(--navy);
  }
</style>
