---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Program } from '../data/programs';

interface Props {
  program: Program;
}
const { program } = Astro.props;
---

<a class:list={['program-card', 'card', `tone-${program.color}`]} href={`/our-programs#${program.slug}`}>
  <span class="program-card__media">
    <span class="program-card__photo">
      <Image src={program.photo} alt={program.photoAlt} widths={[360, 560]} sizes="(max-width: 700px) 100vw, 360px" />
    </span>
    <span class="program-card__ages">{program.ages}</span>
  </span>
  <span class="program-card__body">
    <h3>{program.name}</h3>
    <p>{program.summary}</p>
    <span class="program-card__more">Learn more <Icon name="ArrowRight" size={18} /></span>
  </span>
</a>

<style>
  .program-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .program-card:hover {
    color: inherit;
    transform: translateY(-3px);
    box-shadow: var(--glass-rim), var(--shadow-lift);
  }
  .program-card__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--badge-bg) 0%, var(--badge-bg-2, var(--badge-bg)) 100%);
  }
  /* Clips the photo's hover zoom. */
  .program-card__photo {
    display: block;
    height: 100%;
    overflow: hidden;
  }
  .program-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .program-card:hover .program-card__media :global(img) {
    transform: scale(1.05);
  }
  /* The age range on a glass label over the photo, in the program's colour. */
  .program-card__ages {
    position: absolute;
    left: 14px;
    bottom: 14px;
    padding: 5px 12px;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow-sm);
    color: var(--badge-fg);
    font-weight: 800;
    font-size: 0.85rem;
    line-height: 1.3;
  }
  .program-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 24px;
  }
  .program-card p {
    color: var(--muted);
    flex: 1;
  }
  .program-card__more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-weight: 800;
    color: var(--navy);
  }
</style>
