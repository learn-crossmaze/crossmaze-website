---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { branches, shortName } from '../data/branches';
import { cleanPath } from '../utils';
import { themeSettings } from '../data/themes';

const path = cleanPath(Astro.url.pathname);
// The sun/moon button, unless dark mode is switched off (Site settings → Look and feel).
const darkButton = themeSettings(site.theme).dark !== 'off';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.fullName} – home`}>
      <Logo />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="menu-toggle__open"><Icon name="Menu" /></span>
      <span class="menu-toggle__close"><Icon name="X" /></span>
      <span class="sr-only">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          nav.map((item) =>
            item.href === '/branch' ? (
              <li class="site-nav__item has-sub">
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                  <Icon name="ChevronDown" size={16} class="site-nav__caret" />
                </a>
                <ul class="site-nav__sub">
                  {branches.map((b) => (
                    <li>
                      <a href={`/branch/${b.slug}`} aria-current={path === `/branch/${b.slug}` ? 'page' : undefined}>
                        <strong>{shortName(b)}</strong>
                        <span>{b.area}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="site-nav__item">
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="site-nav__cta">
        <a class="btn btn--ghost btn--sm" href={site.phoneHref} data-call-picker>
          <Icon name="Phone" size={18} />
          Call a centre
        </a>
        <a class="btn btn--sm" href="/contact#enquire">Book a visit</a>
      </div>
    </nav>

    {
      darkButton && (
        <button class="mode-toggle" type="button" aria-pressed="false" data-mode-toggle>
          <span class="mode-toggle__moon">
            <Icon name="Moon" size={20} />
          </span>
          <span class="mode-toggle__sun">
            <Icon name="Sun" size={20} />
          </span>
          <span class="sr-only">Dark mode</span>
        </button>
      )
    }
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const header = document.querySelector('.site-header');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
    document.body.classList.toggle('no-scroll', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  matchMedia('(min-width: 1061px)').addEventListener('change', (e) => e.matches && setOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // Light/dark button. window.cmMode comes from the theme script in BaseLayout's <head>.
  type Mode = 'light' | 'dark';
  const cm = (
    window as unknown as {
      cmMode?: { set: (m: Mode) => void; decide: () => Mode; followsDevice: boolean; device: MediaQueryList | null };
    }
  ).cmMode;
  const modeToggle = document.querySelector<HTMLButtonElement>('[data-mode-toggle]');
  const root = document.documentElement;
  const current = (): Mode => (root.dataset.mode === 'dark' ? 'dark' : 'light');
  const deviceMode = (): Mode => (cm?.followsDevice && cm.device?.matches ? 'dark' : 'light');
  const show = (mode: Mode) => {
    cm?.set(mode);
    modeToggle?.setAttribute('aria-pressed', String(mode === 'dark'));
  };
  if (cm && modeToggle) {
    show(current());
    modeToggle.addEventListener('click', () => {
      const next: Mode = current() === 'dark' ? 'light' : 'dark';
      try {
        sessionStorage.removeItem('cm-mode-preview');
        // Picking what the device shows anyway goes back to following the device.
        if (next === deviceMode()) localStorage.removeItem('cm-mode');
        else localStorage.setItem('cm-mode', next);
      } catch {
        // Storage blocked: the choice lasts for this page only.
      }
      show(next);
    });
    // Work it out again when the phone switches to dark at sunset, when the visitor picks a mode in
    // another tab, and when the browser brings this page back from its back/forward cache.
    const sync = () => show(cm.decide());
    cm.device?.addEventListener('change', sync);
    window.addEventListener('storage', (e) => (e.key === 'cm-mode' || e.key === null) && sync());
    window.addEventListener('pageshow', (e) => e.persisted && sync());

    // Once the page has settled, fetch the other mode's doodles (a few small files, listed by
    // components/doodles; the section ones only show from 1360px), so they're there the moment the
    // mode switches. Holding on to the images keeps them in the browser's memory cache.
    const kept: HTMLImageElement[] = [];
    const listed = (name: string) => getComputedStyle(root).getPropertyValue(name).replace(/['"]/g, '').split(' ').filter(Boolean);
    const prefetch = () => {
      const names = listed('--doodle-other');
      if (matchMedia('(min-width: 1360px)').matches) names.push(...listed('--doodle-other-sections'));
      for (const name of names) {
        const img = new Image();
        img.src = `/doodles/${name}.svg`;
        kept.push(img);
      }
    };
    const whenIdle = () => ('requestIdleCallback' in window ? requestIdleCallback(prefetch) : setTimeout(prefetch, 1000));
    if (document.readyState === 'complete') whenIdle();
    else window.addEventListener('load', whenIdle, { once: true });
  }
</script>

<style>
  /* A floating bar of liquid glass, a little below the top of the window, that the page
     scrolls underneath. */
  .site-header {
    position: sticky;
    top: var(--header-gap);
    z-index: 50;
    margin-top: var(--header-gap);
  }

  /* The glass lives on a pseudo-element: backdrop-filter on the header itself
     would become the containing block for the fixed mobile menu panel. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 max(8px, calc((100% - var(--container)) / 2 - 22px));
    z-index: -1;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
    padding-inline: max(var(--gutter), 24px);
  }

  /* The logo gives way first on narrow phones (it scales down as a whole); the buttons never do. */
  .site-header__brand {
    text-decoration: none;
    flex: 0 1 auto;
    min-width: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__item > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 10px;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav__item > a:hover,
  .site-nav__item > a[aria-current='page'] {
    background: linear-gradient(135deg, var(--navy-50) 0%, var(--navy-100) 100%);
    color: var(--navy);
  }

  .has-sub {
    position: relative;
  }

  .site-nav__sub {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    min-width: 280px;
    margin: 0;
    padding: 8px;
    list-style: none;
    border: 1px solid var(--glass-edge);
    border-radius: 22px;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }

  .site-nav__sub::before {
    content: '';
    position: absolute;
    inset: -10px 0 auto;
    height: 10px;
  }

  .has-sub:hover .site-nav__sub,
  .has-sub:focus-within .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .site-nav__sub a {
    display: grid;
    padding: 10px 14px;
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
  }

  .site-nav__sub a span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .site-nav__sub a:hover,
  .site-nav__sub a[aria-current='page'] {
    background: linear-gradient(135deg, var(--navy-50) 0%, var(--navy-100) 100%);
  }

  .site-nav__cta {
    display: flex;
    gap: 8px;
  }

  .site-nav__cta .btn {
    white-space: nowrap;
  }

  /* Narrower desktops: tighter links so the bar stays on one line in every theme's font. */
  @media (max-width: 1260px) {
    .site-nav {
      gap: 10px;
    }
    .site-nav__item > a {
      padding-inline: 8px;
    }
  }

  .menu-toggle {
    display: none;
    flex: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy-50) 0%, var(--navy-100) 100%);
    color: var(--navy);
    cursor: pointer;
  }

  .menu-toggle__close {
    display: none;
  }

  /* Light/dark: a moon in light mode, a sun in dark mode. */
  .mode-toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-left: -14px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy-50) 0%, var(--navy-100) 100%);
    color: var(--navy);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .mode-toggle:hover {
    transform: rotate(-12deg) scale(1.06);
  }

  .mode-toggle__sun,
  :global(:root[data-mode='dark']) .mode-toggle__moon {
    display: none;
  }

  :global(:root[data-mode='dark']) .mode-toggle__sun {
    display: block;
  }

  /* At night the sun shines in the theme's sun colour, and both round buttons are raised glass
     tinted by the theme's accent (the dark navy tints sank into the bar). */
  :global(:root[data-mode='dark']) .mode-toggle {
    color: var(--sun);
  }

  :global(:root[data-mode='dark']) :is(.mode-toggle, .menu-toggle) {
    background: color-mix(in srgb, var(--navy) 14%, transparent);
    box-shadow: var(--badge-rim);
  }

  @media (max-width: 1180px) {
    .site-nav__cta .btn--ghost {
      display: none;
    }
  }

  /* Below this the links don't fit beside the logo in every theme's font: use the menu button. */
  @media (max-width: 1060px) {
    /* The menu button and then the light/dark button, at the right (the order they are in the page,
       so Tab goes the same way). */
    .menu-toggle {
      display: grid;
      margin-left: auto;
    }

    .mode-toggle {
      width: 46px;
      height: 46px;
    }

    .is-open .menu-toggle__open {
      display: none;
    }

    .is-open .menu-toggle__close {
      display: block;
    }

    /* The menu opens as a glass sheet under the floating bar. */
    .site-nav {
      position: fixed;
      inset: calc(var(--header-gap) + var(--header-h) + 8px) 8px 8px;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding: 16px 16px 24px;
      border: 1px solid var(--glass-edge);
      border-radius: 28px;
      /* Nearly opaque, so the page behind does not show through the links. */
      background: var(--glass-sheet);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      box-shadow: var(--glass-rim), var(--shadow-lift);
      overflow-y: auto;
    }

    .is-open .site-nav {
      display: flex;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }

    .site-nav__item > a {
      width: 100%;
      padding: 14px 16px;
      font-size: 1.15rem;
      border-radius: 14px;
    }

    .site-nav__caret {
      display: none;
    }

    .site-nav__sub {
      position: static;
      min-width: 0;
      padding: 0 0 8px 12px;
      background: none;
      border: 0;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .has-sub:hover .site-nav__sub,
    .has-sub:focus-within .site-nav__sub {
      transform: none;
    }

    .site-nav__cta {
      flex-direction: column;
    }

    .site-nav__cta .btn--ghost {
      display: inline-flex;
    }

    .site-nav__cta .btn {
      min-height: 52px;
    }
  }

  /* Phones: tighter spacing, so the logo and both buttons fit down to 320px. */
  @media (max-width: 480px) {
    .site-header__inner {
      gap: 12px;
      padding-inline: 16px;
    }

    .menu-toggle,
    .mode-toggle {
      width: 44px;
      height: 44px;
    }

    .mode-toggle {
      margin-left: -4px;
    }
  }

  :global(body.no-scroll) {
    overflow: hidden;
  }
</style>
