---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
import { branches, shortName } from '../data/branches';
import { cleanPath } from '../utils';

const path = cleanPath(Astro.url.pathname);
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.fullName} – home`}>
      <Logo />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <span class="menu-toggle__open"><Icon name="Menu" /></span>
      <span class="menu-toggle__close"><Icon name="X" /></span>
      <span class="sr-only">Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          nav.map((item) =>
            item.href === '/branch' ? (
              <li class="site-nav__item has-sub">
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                  <Icon name="ChevronDown" size={16} class="site-nav__caret" />
                </a>
                <ul class="site-nav__sub">
                  {branches.map((b) => (
                    <li>
                      <a href={`/branch/${b.slug}`} aria-current={path === `/branch/${b.slug}` ? 'page' : undefined}>
                        <strong>{shortName(b)}</strong>
                        <span>{b.area}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="site-nav__item">
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <div class="site-nav__cta">
        <a class="btn btn--ghost btn--sm" href={site.phoneHref}>
          <Icon name="Phone" size={18} />
          {site.phone}
        </a>
        <a class="btn btn--sm" href="/contact#enquire">Book a visit</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const header = document.querySelector('.site-header');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('is-open', open);
    document.body.classList.toggle('no-scroll', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  matchMedia('(min-width: 981px)').addEventListener('change', (e) => e.matches && setOpen(false));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
  }

  /* The blur lives on a pseudo-element: backdrop-filter on the header itself
     would become the containing block for the fixed mobile menu panel. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgb(255 244 249 / 96%) 0%, rgb(255 250 240 / 96%) 50%, rgb(239 246 255 / 96%) 100%);
    backdrop-filter: saturate(1.4) blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--header-h);
  }

  .site-header__brand {
    text-decoration: none;
    flex: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__item > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 8px 12px;
    border-radius: 999px;
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }

  .site-nav__item > a:hover,
  .site-nav__item > a[aria-current='page'] {
    background: linear-gradient(135deg, var(--navy-50) 0%, #dfe7fb 100%);
    color: var(--navy);
  }

  .has-sub {
    position: relative;
  }

  .site-nav__sub {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    min-width: 280px;
    margin: 0;
    padding: 8px;
    list-style: none;
    background: var(--g-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 6px);
    transition:
      opacity 0.15s ease,
      transform 0.15s ease,
      visibility 0.15s;
  }

  .site-nav__sub::before {
    content: '';
    position: absolute;
    inset: -10px 0 auto;
    height: 10px;
  }

  .has-sub:hover .site-nav__sub,
  .has-sub:focus-within .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .site-nav__sub a {
    display: grid;
    padding: 10px 14px;
    border-radius: 12px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.3;
  }

  .site-nav__sub a span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .site-nav__sub a:hover,
  .site-nav__sub a[aria-current='page'] {
    background: linear-gradient(135deg, var(--navy-50) 0%, #dfe7fb 100%);
  }

  .site-nav__cta {
    display: flex;
    gap: 8px;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 0;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--navy-50) 0%, #dfe7fb 100%);
    color: var(--navy);
    cursor: pointer;
  }

  .menu-toggle__close {
    display: none;
  }

  @media (max-width: 1180px) {
    .site-nav__cta .btn--ghost {
      display: none;
    }
  }

  @media (max-width: 980px) {
    .menu-toggle {
      display: grid;
    }

    .is-open .menu-toggle__open {
      display: none;
    }

    .is-open .menu-toggle__close {
      display: block;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      padding: 16px var(--gutter) 32px;
      background: linear-gradient(180deg, rgb(255 246 250 / 98%) 0%, rgb(244 246 255 / 98%) 100%);
      overflow-y: auto;
    }

    .is-open .site-nav {
      display: flex;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
    }

    .site-nav__item > a {
      width: 100%;
      padding: 14px 16px;
      font-size: 1.15rem;
      border-radius: 14px;
    }

    .site-nav__caret {
      display: none;
    }

    .site-nav__sub {
      position: static;
      min-width: 0;
      padding: 0 0 8px 12px;
      background: none;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .has-sub:hover .site-nav__sub,
    .has-sub:focus-within .site-nav__sub {
      transform: none;
    }

    .site-nav__cta {
      flex-direction: column;
    }

    .site-nav__cta .btn--ghost {
      display: inline-flex;
    }

    .site-nav__cta .btn {
      min-height: 52px;
    }
  }

  :global(body.no-scroll) {
    overflow: hidden;
  }
</style>
