---
// Tips: each section becomes a numbered card, with a "good to know" note and a recap at the end.
// For "5 ways to…" and how-to posts.
import { Image } from 'astro:assets';
import FloatingShapes from '../FloatingShapes.astro';
import Icon from '../Icon.astro';
import PostCrumbs from './PostCrumbs.astro';
import PostMeta from './PostMeta.astro';
import PostTakeaways from './PostTakeaways.astro';
import PostEnd from './PostEnd.astro';
import RichText from './RichText.astro';
import { hasImage, image } from '../../data/content';
import { categoryLabel, cover, type Post } from '../../data/blog';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const photo = cover(post);
const tones = ['coral', 'sky', 'green', 'sun', 'navy'];
---

<section class="page-hero tips-hero">
  <FloatingShapes />
  <div class:list={['container', 'tips-hero__inner', { 'tips-hero__inner--photo': photo }]}>
    <div>
      <PostCrumbs post={post} />
      <span class="eyebrow">{categoryLabel(post.category)}</span>
      <h1>{post.title}</h1>
      {post.summary && <p class="lead">{post.summary}</p>}
      <PostMeta post={post} />
    </div>
    {
      photo && (
        <Image class="tips-hero__photo" src={photo} alt={post.coverAlt || post.title} widths={[400, 600, 800]} sizes="(max-width: 900px) 100vw, 460px" priority />
      )
    }
  </div>
</section>

<section class="section section--tight tips-body">
  <div class="container">
    <RichText text={post.intro} class="tips-intro" />
    <ol class="tips-list">
      {
        post.sections.map((s, i) => (
          <li class:list={['card', 'tips-card', `tone-${tones[i % tones.length]}`]}>
            <span class="tips-num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            {hasImage(s.photo) && <Image class="tips-photo" src={image(s.photo)} alt={s.caption || s.heading} widths={[360, 560]} sizes="(max-width: 760px) 100vw, 520px" />}
            {s.heading && <h2>{s.heading}</h2>}
            <RichText text={s.text} />
          </li>
        ))
      }
    </ol>
    <div class="tips-end">
      {
        post.quote.text && (
          <aside class="card tips-note tone-sun">
            <span class="icon-badge">
              <Icon name="Lightbulb" size={22} />
            </span>
            <div>
              <p class="tips-note__title">Good to know</p>
              <p>{post.quote.text}</p>
              {post.quote.by && <p class="muted">{post.quote.by}</p>}
            </div>
          </aside>
        )
      }
      <PostTakeaways items={post.takeaways} title="Quick recap" />
    </div>
  </div>
</section>

<PostEnd post={post} />

<style>
  .tips-hero__inner--photo {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
  }

  /* The page set's big drifting doodle would sit behind the photo and poke out above its frame. */
  .tips-hero :global(.fx__shape--page-1) {
    display: none;
  }

  .tips-hero h1 {
    max-width: 20ch;
  }

  .tips-hero .lead {
    margin-bottom: 18px;
  }

  .tips-hero :global(.tips-hero__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    padding: 6px;
    border-radius: var(--radius-photo);
    background: var(--g-ring);
    box-shadow: var(--shadow);
  }

  @media (max-width: 900px) {
    .tips-hero__inner--photo {
      grid-template-columns: 1fr;
    }
    .tips-hero :global(.tips-hero__photo) {
      aspect-ratio: 16 / 10;
    }
  }

  .tips-body :global(.tips-intro) {
    max-width: 65ch;
    margin-bottom: clamp(28px, 4vw, 40px);
    font-size: clamp(1.12rem, 1.6vw, 1.25rem);
  }

  .tips-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tips-card {
    display: flex;
    flex-direction: column;
  }

  /* A big number in the card's own colour. */
  .tips-num {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 2.8rem;
    line-height: 1;
    color: var(--badge-fg);
  }

  .tips-card h2 {
    font-size: 1.3rem;
  }

  .tips-card :global(.tips-photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 16px;
    border-radius: var(--radius-photo-sm);
  }

  .tips-end {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 20px;
    align-items: start;
    margin-top: 20px;
  }

  .tips-end :global(.post-takeaways) {
    margin: 0;
  }

  .tips-note {
    display: flex;
    gap: 16px;
  }

  .tips-note .icon-badge {
    flex: none;
    margin: 0;
  }

  .tips-note p {
    margin: 0 0 6px;
  }

  .tips-note__title {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.2rem;
  }
</style>
