---
// "13 October 2026 · 4 min read · By The Crossmaze team"
import Icon from '../Icon.astro';
import { formatPostDate, readingMinutes, type Post } from '../../data/blog';

interface Props {
  post: Post;
  /** Leave out the author (when the template shows it elsewhere). */
  noAuthor?: boolean;
  class?: string;
}
const { post, noAuthor = false, class: className } = Astro.props;
const date = formatPostDate(post.date);
---

<p class:list={['post-meta', className]}>
  {
    date && (
      <span>
        <Icon name="CalendarDays" size={16} />
        <time datetime={post.date}>{date}</time>
      </span>
    )
  }
  <span>
    <Icon name="Clock" size={16} />
    {readingMinutes(post)} min read
  </span>
  {
    !noAuthor && post.author?.name && (
      <span>
        <Icon name="PenLine" size={16} />
        {post.author.name}
      </span>
    )
  }
</p>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin: 0;
    color: var(--muted);
    font-size: 0.93rem;
    font-weight: 700;
  }
  .post-meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .post-meta :global(svg) {
    color: var(--coral);
  }
</style>
