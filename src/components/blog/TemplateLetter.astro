---
// Letter: a personal note in a single glass sheet, from and signed by the author. For messages from
// the principal, the founders or the team.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import PostCrumbs from './PostCrumbs.astro';
import PostQuote from './PostQuote.astro';
import PostTakeaways from './PostTakeaways.astro';
import PostEnd from './PostEnd.astro';
import RichText from './RichText.astro';
import { hasImage, image } from '../../data/content';
import { site } from '../../data/site';
import { categoryLabel, cover, formatPostDate, type Post } from '../../data/blog';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const author = post.author?.name || site.fullName;
const role = post.author?.name ? post.author.role : '';
const photo = cover(post);
const quoteAfter = Math.min(0, post.sections.length - 1);
---

<section class="page-hero letter-hero">
  <div class="container letter-wrap">
    <PostCrumbs post={post} />
    <article class="card letter">
      <header class="letter__head">
        {
          hasImage(post.author?.photo) ? (
            <Image class="letter__face" src={image(post.author.photo)} alt="" widths={[120, 240]} sizes="64px" />
          ) : (
            <span class="icon-badge tone-sky letter__face">
              <Icon name="Mail" size={26} />
            </span>
          )
        }
        <p class="letter__from">
          <span class="eyebrow">{categoryLabel(post.category)}</span>
          <span>
            From <strong>{author}</strong>
            {role && <span class="muted">, {role}</span>}
          </span>
        </p>
        {post.date && <time class="letter__date" datetime={post.date}>{formatPostDate(post.date)}</time>}
      </header>

      <h1>{post.title}</h1>

      {
        photo && (
          <figure class="letter__photo">
            <Image src={photo} alt={post.coverAlt || post.title} widths={[360, 540, 720]} sizes="(max-width: 760px) 100vw, 320px" loading="eager" />
          </figure>
        )
      }

      <RichText text={post.intro} class="letter__intro" />
      {
        post.sections.map((s, i) => (
          <>
            {s.heading && <h2>{s.heading}</h2>}
            <RichText text={s.text} />
            {hasImage(s.photo) && (
              <figure class="letter__inline">
                <Image src={image(s.photo)} alt={s.caption || s.heading || post.title} widths={[480, 720]} sizes="(max-width: 760px) 100vw, 640px" />
                {s.caption && <figcaption>{s.caption}</figcaption>}
              </figure>
            )}
            {i === quoteAfter && <PostQuote text={post.quote.text} by={post.quote.by} variant="note" />}
          </>
        ))
      }
      {post.sections.length === 0 && <PostQuote text={post.quote.text} by={post.quote.by} variant="note" />}
      <PostTakeaways items={post.takeaways} />

      <footer class="letter__sign">
        <span>With warm regards,</span>
        <span class="letter__signature">{author}</span>
        {role && <span class="muted">{role}</span>}
      </footer>
    </article>
  </div>
</section>

<PostEnd post={post} />

<style>
  .letter-wrap {
    max-width: calc(780px + var(--gutter) * 2);
  }

  .letter {
    padding: clamp(24px, 5vw, 56px);
    border-radius: calc(var(--radius-card) + 6px);
    box-shadow: var(--glass-rim), var(--shadow-lift);
    font-size: 1.08rem;
  }

  .letter__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px dashed color-mix(in srgb, var(--navy) 18%, transparent);
  }

  .letter__head :global(.letter__face) {
    flex: none;
    width: 64px;
    height: 64px;
    margin: 0;
    object-fit: cover;
    border-radius: 50%;
  }

  .letter__head :global(img.letter__face) {
    padding: 3px;
    background: var(--g-ring);
    box-shadow: var(--shadow-sm);
  }

  .letter__from {
    display: grid;
    gap: 2px;
    margin: 0;
  }

  .letter__from .eyebrow {
    margin: 0;
  }

  .letter__date {
    margin-left: auto;
    color: var(--muted);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .letter h1 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
  }

  .letter h2 {
    margin-top: 1.4em;
    font-size: 1.3rem;
  }

  .letter :global(.letter__intro) {
    font-size: 1.15rem;
  }

  /* The photo pinned to the letter like a print. */
  .letter__photo {
    float: right;
    width: min(42%, 320px);
    margin: 4px 0 18px 28px;
    padding: 10px 10px 14px;
    border: 1px solid var(--glass-edge);
    border-radius: 14px;
    background: var(--glass-thick);
    box-shadow: var(--glass-rim), var(--shadow);
    rotate: 2deg;
  }

  .letter__photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 8px;
  }

  @media (max-width: 640px) {
    .letter__photo {
      float: none;
      width: 100%;
      margin: 0 0 20px;
      rotate: none;
    }
    .letter__photo :global(img) {
      aspect-ratio: 4 / 3;
    }
  }

  .letter__inline {
    margin: 24px 0;
  }

  .letter__inline :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-photo-sm);
  }

  .letter__inline figcaption {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .letter__sign {
    clear: both;
    display: grid;
    gap: 2px;
    margin-top: 36px;
  }

  .letter__signature {
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: 1.6rem;
    color: var(--navy);
  }
</style>
