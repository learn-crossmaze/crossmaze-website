---
// "Which centre?" Every general call button (marked data-call-picker) and WhatsApp button (marked
// data-whatsapp-picker) opens a list of branches instead of using one number, so parents reach their
// nearest centre; BaseLayout has one of each. On a branch page that branch is listed first; otherwise
// the centre the visitor called or messaged last is. Without JavaScript the buttons fall back to their
// own link: the main number for calls, the Branches page for WhatsApp.
import Icon from './Icon.astro';
import { site } from '../data/site';
import { branches, shortName, telHref, whatsappHref } from '../data/branches';

interface Props {
  channel?: 'phone' | 'whatsapp';
}

const { channel = 'phone' } = Astro.props;
const whatsapp = channel === 'whatsapp';
const tones = ['navy', 'green', 'coral', 'sky', 'sun'];
// Each centre with the link and number this list offers; a centre with no WhatsApp number isn't offered.
const items = branches
  .map((b) => {
    const phone = b.phone || site.phone;
    return whatsapp
      ? { branch: b, href: whatsappHref(b), number: b.whatsapp?.trim() || b.phone }
      : { branch: b, href: telHref(phone), number: phone };
  })
  .filter((item) => item.href);
const titleId = `${channel}-picker-title`;
---

<dialog
  class:list={['call-picker', { 'call-picker--whatsapp': whatsapp }]}
  id={whatsapp ? 'whatsapp-picker' : 'call-picker'}
  data-picker={channel}
  aria-labelledby={titleId}
>
  <div class="call-picker__panel">
    <button type="button" class="call-picker__close" data-picker-close aria-label="Close">
      <Icon name="X" size={22} />
    </button>
    <span class="call-picker__icon"><Icon name={whatsapp ? 'MessageCircle' : 'Phone'} size={26} /></span>
    <h2 id={titleId}>{whatsapp ? 'WhatsApp your nearest Crossmaze' : 'Call your nearest Crossmaze'}</h2>
    <p class="muted">
      {whatsapp ? 'Choose the centre closest to you and we’ll open a chat with them on WhatsApp.' : 'Choose the centre closest to you and we’ll connect you straight to them.'}
    </p>
    <ul class="call-picker__list">
      {
        items.map(({ branch: b, href, number }, i) => (
          <li data-slug={b.slug}>
            <a
              class:list={['call-picker__branch', `tone-${tones[i % tones.length]}`]}
              href={href}
              {...(whatsapp ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="icon-badge">
                <Icon name="MapPin" size={22} />
              </span>
              <span class="call-picker__name">
                <strong>
                  {shortName(b)} <span class="call-picker__tag" hidden />
                </strong>
                <span class="muted">
                  {b.area}
                  {b.pincode && ` · ${b.pincode}`}
                </span>
              </span>
              <span class="call-picker__phone">
                <Icon name={whatsapp ? 'MessageCircle' : 'Phone'} size={18} />
                <span>{number}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</dialog>

<script>
  // One script for both lists (Astro runs a component's script once however many times it's used).
  const pickers = [...document.querySelectorAll<HTMLDialogElement>('dialog[data-picker]')];
  const settings = {
    phone: { trigger: '[data-call-picker]', key: 'crossmaze-call-branch', before: 'Called before' },
    whatsapp: { trigger: '[data-whatsapp-picker]', key: 'crossmaze-whatsapp-branch', before: 'Messaged before' },
  };

  const remembered = (key: string) => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };

  /** Lists the most likely centre first: the branch page being viewed, else the last one chosen. */
  function putPreferredFirst(dialog: HTMLDialogElement, key: string, before: string) {
    const list = dialog.querySelector('.call-picker__list');
    const onPage = location.pathname.match(/^\/branch\/([^/]+)/)?.[1];
    const slug = onPage ?? remembered(key);
    dialog.querySelectorAll<HTMLElement>('.call-picker__tag').forEach((tag) => (tag.hidden = true));
    const item = slug ? dialog.querySelector<HTMLElement>(`li[data-slug="${CSS.escape(slug)}"]`) : null;
    if (!list || !item) return;
    list.prepend(item);
    const tag = item.querySelector<HTMLElement>('.call-picker__tag');
    if (tag) {
      tag.textContent = onPage ? 'This centre' : before;
      tag.hidden = false;
    }
  }

  for (const dialog of pickers) {
    if (typeof dialog.showModal !== 'function') continue;
    const { trigger, key, before } = settings[dialog.dataset.picker === 'whatsapp' ? 'whatsapp' : 'phone'];

    document.addEventListener('click', (event) => {
      if (!(event.target as Element).closest(trigger)) return;
      event.preventDefault();
      putPreferredFirst(dialog, key, before);
      dialog.showModal();
    });

    dialog.addEventListener('click', (event) => {
      const target = event.target as Element;
      // A click on the dimmed backdrop lands on the <dialog> itself.
      if (target === dialog || target.closest('[data-picker-close]')) {
        dialog.close();
        return;
      }
      const branch = target.closest<HTMLAnchorElement>('.call-picker__branch');
      if (branch) {
        try {
          localStorage.setItem(key, branch.closest('li')?.dataset.slug ?? '');
        } catch {
          // Private browsing: nothing to remember, the call or chat still goes ahead.
        }
        setTimeout(() => dialog.close(), 300);
      }
    });
  }
</script>

<style>
  .call-picker {
    width: min(560px, calc(100% - 24px));
    max-height: calc(100dvh - 24px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 32px;
    background: transparent;
    color: var(--ink);
    overflow: visible;
  }

  .call-picker::backdrop {
    /* --scrim (global.css) darkens at night; the fallback is for browsers whose ::backdrop
       doesn't inherit custom properties. */
    background: var(--scrim, color-mix(in srgb, var(--ink, #131a3a) 30%, transparent));
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }

  .call-picker[open] {
    animation: call-picker-in 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes call-picker-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }

  .call-picker__panel {
    position: relative;
    max-height: calc(100dvh - 24px);
    overflow-y: auto;
    padding: clamp(24px, 4vw, 36px);
    border: 1px solid var(--glass-edge);
    border-radius: 32px;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow-lift);
  }

  .call-picker__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--glass-edge);
    border-radius: 50%;
    background: var(--glass);
    box-shadow: var(--glass-rim);
    color: var(--navy);
    cursor: pointer;
  }

  .call-picker__icon {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 14px;
    border-radius: 18px;
    background: var(--g-navy);
    color: #fff;
    box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--navy) 70%, transparent);
  }

  /* The WhatsApp list's badge in WhatsApp's green, like the WhatsApp button. */
  .call-picker--whatsapp .call-picker__icon {
    background: var(--g-whatsapp);
    box-shadow: 0 12px 24px -12px rgb(37 211 102 / 70%);
  }

  .call-picker h2 {
    margin-bottom: 0.25em;
    padding-right: 40px;
    font-size: clamp(1.4rem, 3vw, 1.75rem);
    background: var(--g-heading);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .call-picker__list {
    display: grid;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .call-picker__branch {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border: 1px solid var(--glass-edge);
    border-radius: 20px;
    background: var(--g-card);
    box-shadow: var(--glass-rim), var(--shadow-sm);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .call-picker__branch:hover,
  .call-picker__branch:focus-visible {
    color: var(--ink);
    transform: translateY(-2px);
    box-shadow: var(--glass-rim), var(--shadow);
  }

  .call-picker__branch .icon-badge {
    flex: none;
    width: 44px;
    height: 44px;
    margin: 0;
    border-radius: 14px;
  }

  .call-picker__name {
    display: grid;
    flex: 1;
    min-width: 0;
    line-height: 1.35;
  }

  .call-picker__name strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
  }

  .call-picker__name .muted {
    font-size: 0.9rem;
  }

  .call-picker__tag {
    display: inline-block;
    margin-left: 6px;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--g-sun);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 800;
    vertical-align: 2px;
  }

  .call-picker__tag[hidden] {
    display: none;
  }

  /* At night the text around it is light, so the tag takes the sun buttons' dark text. */
  :global(:root[data-mode='dark']) .call-picker__tag {
    color: var(--sun-btn-fg);
  }

  .call-picker__phone {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--g-navy);
    color: #fff;
    font-weight: 800;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  /* Phones: a sheet that rises from the bottom, with the number under the branch name. */
  @media (max-width: 560px) {
    .call-picker {
      width: 100%;
      max-width: none;
      margin: auto 0 0;
    }

    .call-picker__panel {
      border-radius: 28px 28px 0 0;
      padding-bottom: max(24px, env(safe-area-inset-bottom));
    }

    .call-picker__branch {
      flex-wrap: wrap;
    }

    .call-picker__phone {
      flex-basis: 100%;
      justify-content: center;
    }
  }
</style>
