---
import { batchLabel, formatDays, seatLabels, type Batch } from '../data/batches';
import { branches, shortName } from '../data/branches';
import { programs } from '../data/programs';
import { site } from '../data/site';

interface Props {
  branch?: string;
  id?: string;
  /** Ask for a batch when the chosen program runs in more than one at the chosen branch (branch pages). */
  askBatch?: boolean;
}
const { branch, id = 'enquiry', askBatch = false } = Astro.props;

// Branch name → program name → that program's batches there, as the form shows them. Batches that would
// read the same (one name and time on different days) start with their days, so they differ even when a
// phone cuts the end of the choice off.
const choices = (list: Batch[]) =>
  list.map((x, _, all) => {
    const label = batchLabel(x);
    const clash = all.some((y) => y !== x && batchLabel(y) === label) && x.days?.length;
    return (clash ? `${formatDays(x.days)} · ` : '') + label + (x.seats === 'full' ? ` (${seatLabels.full.toLowerCase()})` : '');
  });
const batchChoices = askBatch
  ? Object.fromEntries(
      branches.map((b) => [b.name, Object.fromEntries(programs.map((p) => [p.name, choices((b.batches ?? []).filter((x) => x.program === p.slug))]))]),
    )
  : undefined;
---

<form
  class="form"
  data-cm-form
  data-form-type="admission_enquiry"
  data-subject="Admission enquiry – Crossmaze website"
  data-mailto={site.admissionsEmail}
  data-success="Thank you! Our admissions team will call you soon."
  data-batches={batchChoices && JSON.stringify(batchChoices)}
  novalidate
>
  <div class="form-row">
    <div class="field">
      <label for={`${id}-parent`}>Parent’s name</label>
      <input id={`${id}-parent`} name="parent_name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${id}-phone`}>Phone number</label>
      <input
        id={`${id}-phone`}
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        pattern="[0-9 +\-]{10,16}"
        required
      />
    </div>
  </div>
  <div class="form-row">
    <div class="field">
      <label for={`${id}-child`}>Child’s name</label>
      <input id={`${id}-child`} name="child_name" required />
    </div>
    <div class="field">
      <label for={`${id}-age`}>Child’s age</label>
      <input id={`${id}-age`} name="child_age" placeholder="e.g. 2 years 6 months" required />
    </div>
  </div>
  <div class="form-row">
    <div class="field">
      <label for={`${id}-program`}>Program</label>
      <select id={`${id}-program`} name="program" required>
        <option value="">Choose a program</option>
        {programs.map((p) => <option value={p.name}>{`${p.name} (${p.ages})`}</option>)}
        <option value="Not sure yet">Not sure yet</option>
      </select>
    </div>
    <div class="field">
      <label for={`${id}-branch`}>Preferred branch</label>
      <select id={`${id}-branch`} name="branch" required>
        <option value="">Choose a branch</option>
        {
          branches.map((b) => (
            <option value={b.name} selected={b.slug === branch}>
              {shortName(b)}
            </option>
          ))
        }
      </select>
    </div>
  </div>
  {
    askBatch && (
      <div class="field" data-batch-field hidden>
        <label for={`${id}-batch`}>
          Preferred batch <span class="hint">(optional)</span>
        </label>
        <select id={`${id}-batch`} name="batch" disabled>
          <option value="">Any batch</option>
        </select>
      </div>
    )
  }
  <div class="field">
    <label for={`${id}-email`}>Email <span class="hint">(optional)</span></label>
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" />
  </div>
  <div class="field">
    <label for={`${id}-message`}>Anything you’d like us to know? <span class="hint">(optional)</span></label>
    <textarea id={`${id}-message`} name="message" rows="3"></textarea>
  </div>
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
  <p class="form-status" role="status" tabindex="-1" hidden></p>
  <div class="btn-row">
    <button class="btn" type="submit">Request a call back</button>
  </div>
  <p class="form-note">We only use your details to respond to your enquiry.</p>
</form>

<script>
  import '../scripts/forms';

  // Branch pages: offer the program's batches at the chosen branch once there is more than one to pick
  // from. While hidden, the batch field is disabled, so nothing is sent.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-batches]')) {
    const choices = JSON.parse(form.dataset.batches ?? '{}') as Record<string, Record<string, string[]>>;
    const program = form.elements.namedItem('program') as HTMLSelectElement | null;
    const branch = form.elements.namedItem('branch') as HTMLSelectElement | null;
    const field = form.querySelector<HTMLElement>('[data-batch-field]');
    const batch = field?.querySelector('select');
    if (!program || !branch || !field || !batch) continue;
    const update = () => {
      const list = choices[branch.value]?.[program.value] ?? [];
      const keep = batch.value;
      batch.replaceChildren(new Option('Any batch', ''), ...list.map((label) => new Option(label, label)));
      batch.value = list.includes(keep) ? keep : '';
      field.hidden = batch.disabled = list.length < 2;
    };
    program.addEventListener('change', update);
    branch.addEventListener('change', update);
    form.addEventListener('reset', () => setTimeout(update));
    update();
  }
</script>
