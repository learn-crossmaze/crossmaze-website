---
import { Image } from 'astro:assets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { image } from '../data/content';
import { nav, site } from '../data/site';
import { branches, shortName } from '../data/branches';
import { programs } from '../data/programs';

const year = new Date().getFullYear();
const mascot = image(site.mascot);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__about">
        <Logo />
        <p>
          A Montessori-based preschool and day care helping children in Electronic City and Begur grow into
          confident, curious and kind learners.
        </p>
        <ul class="site-footer__contact">
          <li>
            <Icon name="MapPin" size={18} />
            <span>{site.address.slice(1).join(', ')}</span>
          </li>
          <li>
            <Icon name="Phone" size={18} />
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <Icon name="Mail" size={18} />
            <a href={`mailto:${site.admissionsEmail}`}>{site.admissionsEmail}</a>
          </li>
          <li>
            <Icon name="Clock" size={18} />
            <span>Preschool {site.hours.preschool} · Day care {site.hours.daycare}</span>
          </li>
        </ul>
        <Image src={mascot} alt="" width={140} class="site-footer__mascot" />
      </div>

      <div>
        <h2 class="site-footer__heading">Explore</h2>
        <ul class="site-footer__links">
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Programs</h2>
        <ul class="site-footer__links">
          {
            programs.map((p) => (
              <li>
                <a href={`/our-programs#${p.slug}`}>{p.name}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="site-footer__heading">Our branches</h2>
        <ul class="site-footer__links">
          {
            branches.map((b) => (
              <li>
                <a href={`/branch/${b.slug}`}>{shortName(b)}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul class="site-footer__social">
        <li><a href="/privacy-policy">Privacy policy</a></li>
        <li><a href="/terms">Terms &amp; conditions</a></li>
        {
          site.social.map((s) => (
            <li>
              <a href={s.href} rel="noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  /* No background of its own: the flowing page gradient continues underneath, and the footer
     content sits on a frosted-glass panel, so there is no hard colour change. */
  .site-footer {
    position: relative;
    padding-block: 24px 28px;
    color: var(--muted);
  }

  .site-footer > .container {
    position: relative;
    isolation: isolate;
    padding-bottom: 24px;
  }

  .site-footer > .container::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(var(--gutter) - min(40px, var(--gutter) - 8px));
    border: 1px solid var(--glass-edge);
    border-radius: 36px;
    background:
      radial-gradient(50% 80% at 100% 0%, rgb(217 203 255 / 45%), transparent 70%),
      radial-gradient(50% 80% at 0% 100%, rgb(191 234 207 / 40%), transparent 70%),
      linear-gradient(160deg, rgb(255 255 255 / 82%) 0%, rgb(255 255 255 / 58%) 100%);
    box-shadow: var(--shadow);
  }

  .site-footer__grid {
    padding-top: 48px;
  }

  .site-footer a {
    color: var(--ink);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--navy);
    text-decoration: underline;
  }

  .site-footer__grid {
    display: grid;
    gap: 40px;
    grid-template-columns: 1.6fr repeat(3, 1fr);
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__about {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }
  }

  .site-footer__about {
    position: relative;
  }

  .site-footer__about :global(.site-footer__mascot) {
    width: 120px;
    height: auto;
    margin-top: 24px;
    border-radius: 18px;
    background: linear-gradient(160deg, #ffffff 0%, #fff6fa 100%);
    box-shadow: var(--shadow-sm);
    animation: mascot-bob 6s ease-in-out infinite alternate;
  }

  @keyframes mascot-bob {
    to {
      transform: translateY(-6px) rotate(-2deg);
    }
  }

  .site-footer__about p {
    max-width: 42ch;
    margin-top: 18px;
  }

  .site-footer__heading {
    margin-bottom: 14px;
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .site-footer__links,
  .site-footer__contact,
  .site-footer__social {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__links {
    display: grid;
    gap: 8px;
  }

  .site-footer__contact {
    display: grid;
    gap: 10px;
  }

  .site-footer__contact li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .site-footer__contact li > :global(svg) {
    flex: none;
    margin-top: 4px;
    color: #c2362c;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgb(20 48 127 / 10%);
    font-size: 0.92rem;
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
</style>
