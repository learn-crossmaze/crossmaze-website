---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Steps from '../components/Steps.astro';
import ProgramDetail from '../components/ProgramDetail.astro';
import { programs, approach, extracurricular } from '../data/programs';
import { site, faqs, dayRoutine } from '../data/site';
import { listText } from '../utils';

// The programs by the names parents search for: the title uses each one's other name where it has one
// ("LKG"), the description both ("Junior KG (LKG)").
const also = (p: (typeof programs)[number]) => p.alsoCalled?.trim();
const names = listText(programs.map((p) => also(p) || p.name)).replace(/ and ([^,]+)$/, ' & $1');
const pageTitle = [`${names} in Bengaluru | ${site.name}`, `${names} | ${site.name}`].find((t) => t.length <= 65) ?? `Our Programs | ${site.name}`;
const description = `${listText(programs.map((p) => (also(p) ? `${p.name} (${also(p)})` : p.name)))} at Crossmaze, Bengaluru. Montessori-based, thematic learning for children aged 2 to 8.`;
---

<BaseLayout fullTitle={pageTitle} description={description}>
  <PageHero
    eyebrow="Our programs"
    title="Learning that grows with your child"
    lead="Our Foundational Development Program goes beyond traditional preschool, laying the groundwork for essential life skills and preparing children for the world of tomorrow."
    crumbs={[{ label: 'Our Programs' }]}
  >
    <nav class="jump" aria-label="Programs on this page">
      {
        programs.map((p) => (
          <a class:list={['pill', `tone-${p.color}`]} href={`#${p.slug}`}>
            {p.name} · {p.ages}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <section class="section programs-section">
    <div class="container programs">
      {programs.map((p, i) => <ProgramDetail program={p} flip={i % 2 === 1} />)}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="How we teach"
        title="Our Foundational Development Program"
        lead="Our thematic approach turns learning into an immersive experience, bringing cognitive, language, personal, social, emotional and physical development together in every theme."
      />
      <div class="grid grid--4 approach">
        {
          approach.map((a) => (
            <div class="card">
              <span class="icon-badge">
                <Icon name={a.icon} size={26} />
              </span>
              <h3>{a.title}</h3>
              <p class="muted">{a.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    dayRoutine.length > 0 && (
      <section class="section" id="a-day-at-crossmaze">
        <div class="container">
          <SectionHeading
            eyebrow="A day at Crossmaze"
            title="Busy, happy little days"
            lead="Every day balances calm, focused Montessori work with play, stories, music and movement."
            align="center"
          />
          <Steps items={dayRoutine} />
        </div>
      </section>
    )
  }

  <section class="section section--white">
    <div class="container extra">
      <div>
        <SectionHeading
          eyebrow="Beyond the classroom"
          title="Extra-curricular activities"
          lead="Activities that build physical well-being, creativity and confidence, outside the core curriculum."
        />
      </div>
      <ul class="grid grid--3 extra__list">
        {
          extracurricular.map((e, i) => (
            <li class:list={['card', `tone-${['sun', 'coral', 'green', 'sky', 'navy', 'sun'][i % 6]}`]}>
              <span class="icon-badge">
                <Icon name={e.icon} size={24} />
              </span>
              <strong>{e.label}</strong>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq">
      <SectionHeading eyebrow="FAQs" title="Questions parents ask us" />
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details class="faq__item">
              <summary>
                {f.q}
                <Icon name="ChevronDown" size={20} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight section--feature">
    <div class="container cta">
      <div>
        <h2>Not sure which program fits?</h2>
        <p class="lead">Tell us your child’s age and we’ll help you choose.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--sun" href="/contact#enquire">Talk to admissions</a>
        <a class="btn btn--ghost" href={site.phoneHref} data-call-picker><Icon name="Phone" size={18} /> Call a centre</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .jump a {
    padding: 8px 16px;
    text-decoration: none;
  }

  /* The five programs, each on its own glass panel (components/ProgramDetail.astro). */
  .programs {
    display: grid;
    gap: clamp(24px, 4vw, 48px);
  }

  /* Four across only where each card has room for its text (two by two on tablets and small laptops). */
  .approach {
    --grid-cols-at: 1060px;
  }

  .extra {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 860px) {
    .extra {
      grid-template-columns: 1fr;
    }
  }

  /* The shared count-aware grid (global.css), with steps for its narrower column: three in a row from
     560px (six activities: 3 + 3), then two. */
  .extra__list {
    --grid-gap: 16px;
    --grid-cols-at: 560px;
    --grid-two-at: 300px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .extra__list .card {
    display: grid;
    justify-items: start;
    padding: 20px;
  }

  .extra__list .icon-badge {
    margin-bottom: 12px;
  }

  .faq {
    max-width: 860px;
  }

  .faq__list {
    display: grid;
    gap: 12px;
  }

  .faq__item {
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius);
    background: var(--g-card);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow-sm);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px 22px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary :global(svg) {
    flex: none;
    transition: transform 0.2s ease;
  }

  .faq__item[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .faq__item p {
    margin: 0;
    padding: 0 22px 20px;
    color: var(--muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cta h2 {
    margin-bottom: 0.2em;
  }

  .cta .lead {
    margin: 0;
  }
</style>
