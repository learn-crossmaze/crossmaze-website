---
// Every festival greeting for a year (?year=2027), to check the cards and words before the day. A private
// page: the admin panel links to it (Site settings → Festival greetings); kept out of search results and
// the sitemap. On the day itself the greeting appears on every page (components/Greetings.astro).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { datesTable } from '../greetings/calendar';
import dates from '../greetings/dates.json';
import { occasions } from '../greetings/occasions';
import { jsonScript } from '../utils';

const table = datesTable(dates.events, occasions);
const schedule = occasions.map((o) => ({ id: o.id, name: o.name, when: o.when }));
---

<BaseLayout title="Festival greetings" noindex description="Every festival greeting on the Crossmaze website, for a year.">
  <PageHero eyebrow="Festival greetings" title="Every greeting, for a year" lead="Each card, the words about the day and the activity, as visitors will see them on the day. Change the colour theme with the links in the admin panel (Site settings → Look and feel)." />
  <section class="section">
    <div class="container">
      <nav class="btn-row greetings-years" aria-label="Year"></nav>
      <p class="greetings-note" id="greetings-note"></p>
      <div class="greetings-grid" id="greetings-grid"></div>
    </div>
  </section>
  <script type="application/json" id="greetings-preview" set:html={jsonScript({ schedule, dates: table })} />
  <script>
    import '../scripts/greetings-preview';
  </script>
</BaseLayout>

<style>
  .greetings-note {
    margin: 14px 0 22px;
  }
  .greetings-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 22px;
  }
  .greetings-grid :global(figure) {
    margin: 0;
    padding: 12px;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-card);
    background: var(--glass);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--shadow-sm), var(--glass-rim);
  }
  .greetings-grid :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 14px;
  }
  .greetings-grid :global(figcaption) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 10px 2px 0;
    font-weight: 700;
  }
  .greetings-grid :global(figcaption small) {
    display: block;
    font-weight: 600;
    opacity: 0.75;
  }
</style>
