---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProgramCard from '../components/ProgramCard.astro';
import BranchCard from '../components/BranchCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import FormSection from '../components/FormSection.astro';
import StepList from '../components/StepList.astro';
import FloatingShapes from '../components/FloatingShapes.astro';
import AboutStory from '../components/AboutStory.astro';
import Steps from '../components/Steps.astro';
import FacilityStrip from '../components/FacilityStrip.astro';
import Strip from '../components/Strip.astro';
import PostCard from '../components/blog/PostCard.astro';
import { posts } from '../data/blog';
import { site, coreValues, dayRoutine, admissionSteps } from '../data/site';
import { programs, daycareHighlights } from '../data/programs';
import { branches, facilities } from '../data/branches';
import { testimonials } from '../data/testimonials';
import { image } from '../data/content';

const [heroMain, ...heroSmall] = site.hero.photos;
// How many photos the banner shows (the big one plus up to two small ones), for its tablet layout.
const heroCount = Math.min(site.hero.photos.length, 3);
const tones = ['navy', 'green', 'coral', 'sky', 'sun', 'navy'];

// Programs, testimonials and branches: a grid of cards (.grid--3) from 700px up, a swipe strip of 76vw
// cards on phones. How wide the cards' photos are drawn, for their `sizes`: the strip's card, then two
// cards a row (until the grid is 840px wide), then three in the container, less the card's 1px border
// (and, for a branch, its 16px padding).
const stripBelow = '700px';
const programSizes =
  '(max-width: 699.98px) calc(76vw - 2px), (max-width: 879.98px) calc(50vw - 34px), (max-width: 1219.98px) calc(33.3vw - 31px), 376px';
const branchSizes =
  '(max-width: 699.98px) calc(76vw - 34px), (max-width: 879.98px) calc(50vw - 66px), (max-width: 1219.98px) calc(33.3vw - 63px), 344px';

// The day care photo keeps its own shape (within 4:3 to 2:1, so an odd upload can't make the panel very
// tall or a thin strip), and is wider still on tablets so it isn't a screen tall.
const careImage = image(site.daycarePhoto.image);
const careShape = careImage.width / careImage.height;
const careRatio = Math.min(Math.max(careShape, 4 / 3), 2).toFixed(4);
const careRatioWide = Math.min(Math.max(careShape, 16 / 9), 2.4).toFixed(4);
// The highlights run in rows of three under the photo (two for four, so none is left on its own).
const careCols = daycareHighlights.length === 4 ? 2 : 3;
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <FloatingShapes variant="home" />
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow"><Icon name="Sparkles" size={18} /> Preschool & Day Care · Bengaluru</span>
        <h1>{site.hero.titleStart} <span class="squiggle">{site.hero.titleHighlight}</span></h1>
        <p class="lead">{site.hero.lead}</p>
        <div class="btn-row">
          <a class="btn btn--sun" href="#enquire">Book a school visit <Icon name="ArrowRight" size={18} /></a>
          <a class="btn btn--ghost" href="/our-programs">Explore programs</a>
        </div>
        <ul class="hero__facts">
          <li><Icon name="Building2" size={20} /> {branches.length} centres</li>
          <li><Icon name="Baby" size={20} /> Ages 2 – 8</li>
          <li><Icon name="Users" size={20} /> 1:6 day care ratio</li>
        </ul>
      </div>
      <div class:list={['hero__art', `hero__art--${heroCount}`]}>
        {
          heroMain && (
            <Image
              class="hero__photo hero__photo--big"
              src={image(heroMain.image)}
              alt={heroMain.alt}
              widths={[480, 720, 960, 1280]}
              sizes={`(max-width: 560px) calc(100vw - 32px), (max-width: 900px) ${heroCount > 1 ? 'calc(66vw - 36px)' : 'calc(100vw - 32px)'}, (max-width: 1219px) calc(49vw - 20px), 572px`}
              loading="eager"
            />
          )
        }
        {
          heroSmall.slice(0, 2).map((p) => (
            <Image
              class="hero__photo"
              src={image(p.image)}
              alt={p.alt}
              widths={[280, 480, 640]}
              sizes="(max-width: 560px) calc(50vw - 23px), (max-width: 900px) calc(35vw - 19px), (max-width: 1219px) calc(24vw - 17px), 280px"
              loading="eager"
            />
          ))
        }
        {
          site.hero.badgeValue && (
            <div class="hero__badge">
              <strong data-countup>{site.hero.badgeValue}</strong>
              <span>{site.hero.badgeLabel}</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats no-shapes" aria-label="Crossmaze in numbers">
    <div class="container">
      <ul class="stats__list">
        {
          site.stats.map((s) => (
            <li>
              <strong data-countup>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- About -->
  <section class="section section--white">
    <AboutStory variant="teaser" eyebrow="About us" />
  </section>

  <!-- Core values -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Our core values"
        title="The foundation of everything we do"
        lead="Our values guide what we do every day: how we teach, how our centres feel and how we work with children, parents and the community."
        align="center"
      />
      <div class="grid grid--3">
        {
          coreValues.map((v, i) => (
            <div class:list={['card', `tone-${tones[i % tones.length]}`]}>
              <span class="icon-badge">
                <Icon name={v.icon} size={26} />
              </span>
              <h3>{v.title}</h3>
              <p class="muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Programs -->
  <section class="section section--white">
    <div class="container">
      <div class="split-heading">
        <SectionHeading
          eyebrow="Our programs"
          title="A program for every stage"
          lead="Our Foundational Development Program goes beyond traditional preschool, building essential life skills through a thematic, Montessori-based approach."
        />
        <a class="btn btn--ghost" href="/our-programs">All program details</a>
      </div>
      <Strip label="programs" below={stripBelow} as="div" listClass="grid grid--3">
        {programs.map((p) => <ProgramCard program={p} sizes={programSizes} />)}
      </Strip>
    </div>
  </section>

  <!-- A day at Crossmaze -->
  {
    dayRoutine.length > 0 && (
      <section class="section" id="a-day-at-crossmaze">
        <div class="container">
          <SectionHeading
            eyebrow="A day at Crossmaze"
            title="Busy, happy little days"
            lead="Every day balances calm, focused Montessori work with play, stories, music and movement."
            align="center"
          />
          <Steps items={dayRoutine} />
        </div>
      </section>
    )
  }

  <!-- Day care -->
  <section class="section section--feature care">
    <div class="container care__inner">
      <div class="care__intro">
        <span class="eyebrow">Day care</span>
        <h2>A nurturing, <span class="care__keep">home-like</span> day care</h2>
        <p class="lead">
          Our in-house day care is open to children from 2 to 8, with or without a Crossmaze class: for the full day,
          after the morning class, or after school for children from other schools. Experienced caregivers focus on
          safety and enrichment, so you can get on with your day with complete peace of mind.
        </p>
      </div>
      <div class="care__media ratio-frame photo-frame" style={`--ratio: ${careRatio}; --ratio-wide: ${careRatioWide}; --src-w: ${careImage.width}px`}>
        <Image
          src={careImage}
          alt={site.daycarePhoto.alt}
          widths={[480, 720, 960, 1280, 1600]}
          sizes="(max-width: 700px) calc(100vw - 64px), (max-width: 900px) calc(87vw - 286px), (max-width: 1219px) calc(39vw - 7px), 470px"
        />
      </div>
      <ul class="care__list" style={`--care-cols: ${careCols}`}>
        {
          daycareHighlights.map((h) => (
            <li>
              <Icon name="Check" size={20} />
              {h}
            </li>
          ))
        }
      </ul>
      <a class="btn btn--sun care__cta" href="/our-programs#day-care">About day care</a>
    </div>
  </section>

  <!-- Facilities -->
  <section class="section section--white" id="facilities">
    <div class="container">
      <SectionHeading
        eyebrow="Our facilities"
        title="Safe, secure and creative"
        lead="Every centre is designed around children, with CCTV and a parents’ app that keeps you connected all day."
        align="center"
      />
      <FacilityStrip items={facilities} />
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section testimonials">
        <div class="container">
          <SectionHeading eyebrow="Testimonials" title="What parents say" align="center" />
          <Strip label="testimonials" below={stripBelow} as="div" listClass="grid grid--3">
            {testimonials.map((t) => (
              <figure class="card testimonial">
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span class="muted">{t.detail}</span>
                </figcaption>
              </figure>
            ))}
          </Strip>
        </div>
      </section>
    )
  }

  <!-- Latest blog posts -->
  {
    posts.length > 0 && (
      <section class="section" id="blog">
        <div class="container">
          <div class="split-heading">
            <SectionHeading eyebrow="From our blog" title="Stories, tips and news" />
            <a class="btn btn--ghost" href="/blog">
              All posts
            </a>
          </div>
          <div class="grid grid--3">
            {posts.slice(0, 3).map((p) => (
              <PostCard post={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Branches -->
  <section class="section section--white">
    <div class="container">
      <div class="split-heading">
        <SectionHeading
          eyebrow="Our branches"
          title="A Crossmaze near you"
          lead="Five centres across Electronic City and Begur, each with the same curriculum, care and safety standards."
        />
        <a class="btn btn--ghost" href="/branch">See all branches</a>
      </div>
      <Strip label="branches" below={stripBelow} as="div" listClass="grid grid--3">
        {branches.map((b, i) => <BranchCard branch={b} index={i} sizes={branchSizes} />)}
      </Strip>
    </div>
  </section>

  <!-- Admission enquiry, with how admission works beside the form -->
  <FormSection
    id="enquire"
    eyebrow="Admissions open"
    title="Admission enquiry"
    lead="Share a few details and our admissions team will call you to answer your questions and set up a visit to your nearest centre."
  >
    {/* The admission steps from the admin panel (left out when there are none), then the call and
        WhatsApp buttons. #admissions is kept for links to the old "How admission works" section. */}
    <div class="enquire-aside" id="admissions" slot="aside">
      <div class:list={['enquire-aside__inner', { 'enquire-aside__inner--steps': admissionSteps.length > 0 }]}>
        {admissionSteps.length > 0 && <StepList title="How admission works" items={admissionSteps} />}
        <div class="enquire__direct">
          <a class="btn btn--ghost" href={site.phoneHref} data-call-picker><Icon name="Phone" size={18} /> Call your nearest centre</a>
          <a class="btn btn--ghost" href={site.whatsappHref} target="_blank" rel="noopener">
            <Icon name="MessageCircle" size={18} /> WhatsApp us
          </a>
        </div>
      </div>
    </div>
    <EnquiryForm slot="form" id="home-enquiry" />
  </FormSection>
</BaseLayout>

<style>
  .hero {
    --banner-pad-top: clamp(40px, 6vw, 80px);
    position: relative;
    overflow: hidden;
    padding-block: var(--banner-pad-top) clamp(48px, 7vw, 96px);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }

  .hero h1 {
    position: relative;
    z-index: 0;
    max-width: 14ch;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    font-weight: 800;
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero__facts :global(svg) {
    color: var(--coral);
  }

  .hero__art {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .hero__art :global(.hero__photo) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    padding: 5px;
    border-radius: var(--radius-photo-sm);
    background: var(--g-ring);
    box-shadow: var(--shadow);
  }

  .hero__art :global(.hero__photo--big) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  /* A liquid-glass label floating over the big photo. */
  .hero__badge {
    position: absolute;
    left: -18px;
    top: 42%;
    display: grid;
    padding: 12px 18px;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius);
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    color: var(--ink);
    box-shadow: var(--glass-rim), var(--shadow);
    line-height: 1.15;
  }

  .hero__badge strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: var(--display-weight);
    color: var(--navy);
  }

  .hero__badge span {
    font-weight: 800;
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .hero__badge {
      left: auto;
      right: 10px;
      top: 10px;
    }
  }

  /* Tablets: the text runs full width, so the photos follow it in one row of capped height (the big
     one with the small ones stacked beside it) rather than a full-width collage two screens tall.
     The banner's columns, gap and padding stay as they are: the doodles are placed by them
     (FloatingShapes.astro). */
  @media (min-width: 561px) and (max-width: 900px) {
    .hero__art:is(.hero__art--2, .hero__art--3) {
      grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
      height: clamp(240px, 42vw, 380px);
    }

    .hero__art:is(.hero__art--2, .hero__art--3) :global(.hero__photo) {
      aspect-ratio: auto;
    }

    .hero__art:is(.hero__art--2, .hero__art--3) :global(.hero__photo--big) {
      grid-column: 1;
      grid-row: 1 / -1;
    }

    /* A single small photo takes the whole column beside the big one. */
    .hero__art--2 :global(.hero__photo:not(.hero__photo--big)) {
      grid-row: 1 / -1;
    }

    .hero__art--1 :global(.hero__photo--big) {
      max-height: 380px;
    }

    /* The badge stays on the big photo, at its top right. */
    .hero__art:is(.hero__art--2, .hero__art--3) .hero__badge {
      right: calc((100% - 14px) / 2.9 + 24px);
    }
  }

  .stats {
    padding-block: 8px;
  }

  .stats__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 26px 20px;
    list-style: none;
    text-align: center;
    border: 1px solid var(--glass-edge);
    border-radius: 28px;
    background: var(--g-card);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow);
  }

  @media (max-width: 700px) {
    .stats__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Rows from the top, so a label stays under its number when the number beside it is taller. */
  .stats__list li {
    display: grid;
    align-content: start;
  }

  .stats__list strong {
    --num: linear-gradient(135deg, var(--navy) 0%, var(--navy-700) 100%);
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.2;
    background: var(--num);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Each number deepens towards --contrast-mix (darker on light pages, lighter at night). */
  .stats__list li:nth-child(4n + 2) strong {
    --num: linear-gradient(135deg, var(--coral-fg) 0%, color-mix(in srgb, var(--coral-fg) 75%, var(--contrast-mix)) 100%);
  }

  .stats__list li:nth-child(4n + 3) strong {
    --num: linear-gradient(135deg, var(--green-fg) 0%, color-mix(in srgb, var(--green-fg) 70%, var(--contrast-mix)) 100%);
  }

  .stats__list li:nth-child(4n + 4) strong {
    --num: linear-gradient(135deg, var(--sky-fg) 0%, color-mix(in srgb, var(--sky-fg) 72%, var(--contrast-mix)) 100%);
  }

  .stats__list span {
    font-weight: 700;
    color: var(--muted);
  }

  .split-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 24px;
  }

  .split-heading > .btn {
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  /* Day care: the photo beside the heading and introduction only, with the highlights and the button
     running full width below, so the photo never floats beside a much taller column.
     The glass panel and the padding come from global.css (main > section.section--feature > .container):
     the panel is drawn 8px inside the container's edge, and the content is set in from the glass by
     --panel-pad, as above and below. */
  .care__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    grid-template-areas:
      'intro media'
      'list list'
      'cta cta';
    gap: clamp(28px, 3.5vw, 40px) clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .care__intro {
    grid-area: intro;
  }

  .care__intro > :last-child {
    margin-bottom: 0;
  }

  /* Where the heading wraps, it breaks before "home-like" rather than at its hyphen. */
  .care__keep {
    white-space: nowrap;
  }

  /* Full width of its column (a grid item with a shape would otherwise shrink to fit its max-height),
     but never wider than the uploaded photo (--src-w), so a small upload isn't blown up. */
  .care__media {
    grid-area: media;
    justify-self: end;
    width: 100%;
    max-width: var(--src-w, none);
  }

  .care__cta {
    grid-area: cta;
    justify-self: start;
  }

  /* Rows of at most --care-cols highlights (fewer where there isn't room for 270px each, about the
     width of a highlight on one line). */
  .care__list {
    --care-gap: 20px;
    grid-area: list;
    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, max(270px, (100% - (var(--care-cols, 3) - 1) * var(--care-gap)) / var(--care-cols, 3))), 1fr)
    );
    gap: 10px var(--care-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .care__list li {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .care__list :global(svg) {
    flex: none;
    padding: 3px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--green-50) 0%, var(--green-100) 100%);
    color: var(--green);
    width: 26px;
    height: 26px;
  }

  /* Tablets and phones: one column, the photo after the introduction. */
  @media (max-width: 900px) {
    .care__inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'media'
        'list'
        'cta';
    }

    .care__media {
      justify-self: start;
    }
  }

  /* Tablets: a wide photo, not one as tall as the screen. */
  @media (min-width: 561px) and (max-width: 900px) {
    .care__media {
      aspect-ratio: var(--ratio-wide, 16 / 9);
      max-height: 380px;
    }
  }

  /* Wider tablets: the photo beside the highlights (one column of them) rather than across the whole
     panel, so it is never shown much larger than the photos the owner uploads. It grows to the
     highlights' height if they are the taller. */
  @media (min-width: 701px) and (max-width: 900px) {
    .care__inner {
      grid-template-columns: fit-content(50%) minmax(0, 1fr);
      grid-template-areas:
        'intro intro'
        'list media'
        'cta cta';
    }

    .care__media {
      align-self: stretch;
      justify-self: end;
    }

    .care__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Quotes are long, so three a row only once the grid is 960px wide (two on tablets, never three
     narrow columns). */
  .testimonials :global(.grid--3) {
    --grid-cols-at: 960px;
  }

  /* Rows of cards as tall as the row's longest quote, with the names lined up along the foot. */
  .testimonial {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  /* In the phone strip (below 700px, Strip's `below`) each card keeps its own height, so a short quote
     has no empty glass under it. */
  @media (max-width: 699.98px) {
    .testimonial {
      align-self: start;
    }
  }

  /* A large, soft opening quote mark instead of an icon. */
  .testimonial::before {
    content: '\201C';
    display: block;
    height: 0.5em;
    margin-bottom: 10px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 3.4rem;
    line-height: 1;
    color: color-mix(in srgb, var(--quote-mark) 55%, transparent);
  }

  .testimonial blockquote {
    margin: 0 0 16px;
  }

  .testimonial figcaption {
    display: grid;
    margin-top: auto;
    line-height: 1.35;
  }

  /* ---------- Admission enquiry (components/FormSection.astro) ----------
     Beside the form: the admission steps above the call and WhatsApp buttons. Above the form (below
     1001px, where the aside runs the full width), the steps and the buttons side by side. */
  .enquire-aside {
    container-type: inline-size;
  }

  .enquire-aside__inner {
    display: grid;
    gap: clamp(20px, 2.4vw, 24px);
  }

  .enquire__direct {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Beside the form, the small button size (.btn--sm), so the two fit on one line in every theme's font
     and the intro stays short enough to show whole under the header on a 768px-tall laptop screen. */
  @media (min-width: 1001px) {
    .enquire__direct .btn {
      min-height: 40px;
      padding: 8px 18px;
      font-size: 0.95rem;
    }
  }

  /* Phones: the two buttons one under the other, the same width. */
  @container (max-width: 519px) {
    .enquire__direct .btn {
      flex: 1 1 auto;
    }
  }

