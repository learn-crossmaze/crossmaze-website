---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProgramCard from '../components/ProgramCard.astro';
import BranchCard from '../components/BranchCard.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site } from '../data/site';
import { programs, approach } from '../data/programs';
import { branches, amenities } from '../data/branches';
import { testimonials } from '../data/testimonials';

const tiles = [
  { icon: 'Blocks', tone: 'sun' },
  { icon: 'Music', tone: 'plum' },
  { icon: 'Palette', tone: 'coral' },
  { icon: 'BookOpen', tone: 'teal' },
  { icon: 'Heart', tone: 'coral', big: true },
  { icon: 'Puzzle', tone: 'sky' },
  { icon: 'Sprout', tone: 'teal' },
  { icon: 'Star', tone: 'sun' },
  { icon: 'Sun', tone: 'plum' },
];

const careHighlights = [
  {
    icon: 'Cctv',
    title: 'Live CCTV for parents',
    text: 'Watch your child’s day in real time, from anywhere.',
  },
  {
    icon: 'Smartphone',
    title: 'Parent app',
    text: 'Daily updates, photos, notices and reports in one place.',
  },
  {
    icon: 'Bus',
    title: 'In-house transport',
    text: 'Convenient pick-up and drop-off with our own transport service.',
  },
  {
    icon: 'BedDouble',
    title: 'AC sleeping rooms',
    text: 'Calm, air-conditioned nap rooms designed just for little ones.',
  },
];

const day = [
  { icon: 'Smile', title: 'Warm welcome & circle time', text: 'Greetings, songs, weather and the day’s theme.' },
  { icon: 'Shapes', title: 'Montessori work time', text: 'Hands-on materials for language, numbers and life skills.' },
  { icon: 'Utensils', title: 'Snack break', text: 'Healthy habits, table manners and sharing.' },
  { icon: 'Palette', title: 'Theme activity', text: 'Art, craft, music or a science discovery tied to the theme.' },
  { icon: 'Trees', title: 'Active play', text: 'Movement, games and gross-motor fun.' },
  { icon: 'BookOpen', title: 'Story & goodbye', text: 'A story, a recap of the day, and home – or on to day care.' },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow"><Icon name="Sparkles" size={18} /> Preschool & Day Care · Bengaluru</span>
        <h1>Where little minds <span class="squiggle">find their way</span></h1>
        <p class="lead">
          A Montessori-based preschool and day care where children aged 2 to 8 learn through play, discovery and
          care, at five centres across Electronic City and Begur.
        </p>
        <div class="btn-row">
          <a class="btn btn--sun" href="#enquire">Book a school visit <Icon name="ArrowRight" size={18} /></a>
          <a class="btn btn--ghost" href="/our-programs">Explore programs</a>
        </div>
        <ul class="hero__facts">
          <li><Icon name="Building2" size={20} /> {branches.length} centres</li>
          <li><Icon name="Baby" size={20} /> Ages 2 – 8</li>
          <li><Icon name="Clock" size={20} /> Day care till 6 pm</li>
        </ul>
      </div>
      <div class="hero__art" aria-hidden="true">
        {
          tiles.map((t) => (
            <span class:list={['hero__tile', `tone-${t.tone}`, { 'hero__tile--big': t.big }]}>
              <Icon name={t.icon} size={t.big ? 56 : 34} strokeWidth={1.8} />
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="Why Crossmaze"
        title="Education centred on the whole child"
        lead="Academics and discipline matter to us, and so do values, culture, manners and kindness. Our approach brings them together so children grow in every way."
      />
      <div class="grid grid--4">
        {
          approach.map((a, i) => (
            <div class:list={['card', `tone-${['plum', 'teal', 'coral', 'sky'][i % 4]}`]}>
              <span class="icon-badge">
                <Icon name={a.icon} size={26} />
              </span>
              <h3>{a.title}</h3>
              <p class="muted">{a.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Programs -->
  <section class="section">
    <div class="container">
      <div class="split-heading">
        <SectionHeading
          eyebrow="Our programs"
          title="A program for every stage"
          lead={`Preschool runs ${site.hours.preschool}. Day care runs ${site.hours.daycare} for families who need a full day.`}
        />
        <a class="btn btn--ghost" href="/our-programs">All program details</a>
      </div>
      <div class="grid grid--3">
        {programs.map((p) => <ProgramCard program={p} />)}
      </div>
    </div>
  </section>

  <!-- Safety & care -->
  <section class="section section--plum care">
    <div class="container care__inner">
      <div>
        <span class="eyebrow">Safety & peace of mind</span>
        <h2>Safe, secure and always within reach</h2>
        <p class="lead">
          Every Crossmaze centre is designed around children: child-friendly spaces, trained staff and tools that keep
          parents connected throughout the day.
        </p>
        <ul class="care__amenities">
          {
            amenities.map((a) => (
              <li>
                <Icon name={a.icon} size={18} />
                {a.label}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="care__grid">
        {
          careHighlights.map((c) => (
            <div class="care__card">
              <Icon name={c.icon} size={30} />
              <h3>{c.title}</h3>
              <p>{c.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- A day at Crossmaze -->
  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="A day at Crossmaze"
        title="Every morning is a little adventure"
        lead="A predictable rhythm helps young children feel secure, and leaves room for wonder."
        align="center"
      />
      <ol class="day">
        {
          day.map((d, i) => (
            <li class:list={['day__step', `tone-${['sun', 'teal', 'coral', 'sky', 'plum', 'sun'][i]}`]}>
              <span class="icon-badge">
                <Icon name={d.icon} size={24} />
              </span>
              <h3>{d.title}</h3>
              <p class="muted">{d.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    testimonials.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHeading eyebrow="Parents say" title="Loved by families" align="center" />
          <div class="grid grid--3">
            {testimonials.map((t) => (
              <figure class="card testimonial">
                <blockquote>“{t.quote}”</blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span class="muted">{t.detail}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Branches -->
  <section class="section">
    <div class="container">
      <div class="split-heading">
        <SectionHeading
          eyebrow="Our branches"
          title="A Crossmaze near you"
          lead="Five centres across Electronic City and Begur, each with the same curriculum, care and safety standards."
        />
        <a class="btn btn--ghost" href="/branch">See all branches</a>
      </div>
      <div class="grid grid--3">
        {branches.map((b, i) => <BranchCard branch={b} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Enquiry -->
  <section class="section section--white" id="enquire">
    <div class="container enquire">
      <div>
        <span class="eyebrow">Admissions open</span>
        <h2>Come and see us in action</h2>
        <p class="lead">
          Share a few details and our admissions team will call you to answer your questions and set up a visit to
          your nearest centre.
        </p>
        <ul class="check-list">
          <li><Icon name="Check" size={20} /> Tour the classrooms and Montessori area</li>
          <li><Icon name="Check" size={20} /> Meet the centre head and teachers</li>
          <li><Icon name="Check" size={20} /> Find the right program for your child</li>
        </ul>
        <div class="enquire__direct">
          <a class="btn btn--ghost" href={site.phoneHref}><Icon name="Phone" size={18} /> {site.phone}</a>
          <a class="btn btn--ghost" href={site.whatsappHref} target="_blank" rel="noopener">
            <Icon name="MessageCircle" size={18} /> WhatsApp us
          </a>
        </div>
      </div>
      <div class="card enquire__form">
        <EnquiryForm id="home-enquiry" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(56px, 8vw, 112px);
    background:
      radial-gradient(circle at 100% 0%, var(--sun-50) 0 260px, transparent 261px),
      radial-gradient(circle at 0% 100%, var(--teal-50) 0 180px, transparent 181px),
      var(--cream);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }

  .hero h1 {
    position: relative;
    z-index: 0;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    font-weight: 800;
  }

  .hero__facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero__facts :global(svg) {
    color: var(--coral);
  }

  .hero__art {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(10px, 1.6vw, 18px);
    max-width: 480px;
    width: 100%;
    margin-inline: auto;
    transform: rotate(-4deg);
  }

  .hero__tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: clamp(18px, 2.4vw, 28px);
    background: var(--badge-bg);
    color: var(--badge-fg);
    box-shadow: var(--shadow-sm);
    animation: float 6s ease-in-out infinite;
  }

  .hero__tile:nth-child(odd) {
    animation-delay: -3s;
  }

  .hero__tile--big {
    background: var(--plum);
    color: var(--sun);
    box-shadow: var(--shadow);
  }

  @keyframes float {
    50% {
      transform: translateY(-6px);
    }
  }

  @media (max-width: 900px) {
    .hero__art {
      max-width: 340px;
    }
  }

  .split-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0 24px;
  }

  .split-heading > .btn {
    margin-bottom: clamp(32px, 4vw, 48px);
  }

  .care h2 {
    color: #fff;
  }

  .care__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  @media (max-width: 900px) {
    .care__inner {
      grid-template-columns: 1fr;
    }
  }

  .care__amenities {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .care__amenities li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 10%);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .care__amenities :global(svg) {
    color: var(--sun);
  }

  .care__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  @media (max-width: 480px) {
    .care__grid {
      grid-template-columns: 1fr;
    }
  }

  .care__card {
    padding: 24px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 8%);
    border: 1px solid rgb(255 255 255 / 14%);
  }

  .care__card :global(svg) {
    margin-bottom: 14px;
    color: var(--sun);
  }

  .care__card h3 {
    color: #fff;
    font-size: 1.15rem;
  }

  .care__card p {
    margin: 0;
    color: rgb(255 255 255 / 80%);
  }

  .day {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .day__step {
    position: relative;
    padding: 24px 20px;
    border-radius: var(--radius);
    background: var(--cream);
    text-align: center;
  }

  .day__step .icon-badge {
    margin-inline: auto;
  }

  .day__step h3 {
    font-size: 1.05rem;
  }

  .day__step p {
    margin: 0;
    font-size: 0.95rem;
  }

  .testimonial blockquote {
    margin: 0 0 16px;
    font-size: 1.1rem;
  }

  .testimonial figcaption {
    display: grid;
  }

  .enquire {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }

  @media (max-width: 900px) {
    .enquire {
      grid-template-columns: 1fr;
    }
  }

  .enquire .check-list {
    margin-top: 24px;
  }

  .enquire__direct {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .enquire__form {
    background: var(--cream);
  }
</style>
