---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BranchCard from '../../components/BranchCard.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import Icon from '../../components/Icon.astro';
import FloatingShapes from '../../components/FloatingShapes.astro';
import PhotoAlbum from '../../components/PhotoAlbum.astro';
import {
  branches,
  amenityList,
  branchPhotos,
  headPhoto,
  shortName as toShortName,
  telHref,
  type Branch,
} from '../../data/branches';
import TimeRange from '../../components/TimeRange.astro';
import { formatDays, openingHoursSpecification, openingTimes, seatLabels } from '../../data/batches';
import { programs } from '../../data/programs';
import { site } from '../../data/site';

export function getStaticPaths() {
  return branches.map((branch) => ({ params: { slug: branch.slug }, props: { branch } }));
}

interface Props {
  branch: Branch;
}

const { branch } = Astro.props;
const shortName = toShortName(branch);
const offered = programs.filter((p) => branch.programs.includes(p.slug));
// Each program's batches here (src/data/batches.ts), and when the branch is open: earliest start to latest end.
const batches = branch.batches ?? [];
const batchesOf = (slug: string) => batches.filter((b) => b.program === slug);
const open = openingTimes(batches);
const openLabel = (days: string) => (!days ? 'Open' : days === 'Every day' ? 'Open every day' : `Open ${days}`);
const hours = openingHoursSpecification(batches);
const others = branches.filter((b) => b.slug !== branch.slug);
const photos = branchPhotos(branch.slug);
// The cover photo sits in the hero; the next five fill the gallery's 2×2 + 4 grid. Every photo opens
// in the album (components/PhotoAlbum.astro), and the last tile counts the ones the grid leaves out.
const [cover, ...rest] = photos;
const gallery = rest.slice(0, 5);
const notShown = rest.length - gallery.length;
const photoAlt = (n: number) => (n === 1 ? `Inside ${branch.name}` : `${branch.name} – photo ${n}`);
const fullSize = await Promise.all(photos.map((p) => getImage({ src: p, width: 1600, format: 'webp' })));
const head = headPhoto(branch.slug);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(branch.mapQuery)}&output=embed`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(branch.mapQuery)}`;

const facts = [
  branch.carpetArea && { icon: 'Ruler', label: 'Carpet area', value: branch.carpetArea },
  branch.capacity && { icon: 'Users', label: 'Capacity', value: `${branch.capacity} children` },
  branch.centerHead && { icon: 'UserRound', label: 'Centre head', value: branch.centerHead.name },
  // One range when the days share their hours ("Open Mon – Fri", "9:00 am – 6:00 pm"), else one per group of days.
  open.length === 1 && { icon: 'Clock', label: openLabel(open[0]!.days), hours: [{ ...open[0]!, days: '' }] },
  open.length > 1 && { icon: 'Clock', label: 'Open', hours: open },
].filter(Boolean) as { icon: string; label: string; value?: string; hours?: { days: string; from: string; to: string }[] }[];

const jsonLd = {
  '@context': 'https://schema.org',
  // Preschool, and as day care a local business, for which Google shows opening hours.
  '@type': ['Preschool', 'ChildCare'],
  name: branch.name,
  url: new URL(`/branch/${branch.slug}`, site.url).href,
  telephone: branch.phone,
  email: branch.email,
  ...(cover ? { image: new URL(fullSize[0]!.src, site.url).href } : {}),
  parentOrganization: { '@type': 'Organization', name: site.fullName, url: site.url },
  ...(hours.length ? { openingHoursSpecification: hours } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: branch.address.slice(0, -1).join(', '),
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    postalCode: branch.pincode,
    addressCountry: 'IN',
  },
};
---

<BaseLayout
  title={`${shortName} Branch`}
  description={`${branch.name}: preschool and day care in ${branch.area}, Bengaluru ${branch.pincode}. Play Group, Nursery, Junior KG, Senior KG and Day Care.`}
  jsonLd={jsonLd}
>
  <section class="page-hero branch-hero">
    <FloatingShapes />
    <div class="container branch-hero__inner">
      <div>
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumbs">
            <li><a href="/">Home</a></li>
            <li><a href="/branch">Branches</a></li>
            <li><span aria-current="page">{shortName}</span></li>
          </ol>
        </nav>
        <span class="eyebrow">{branch.area} · {branch.pincode}</span>
        <h1>{branch.name}</h1>
        <p class="lead">{branch.intro}</p>
        <div class="btn-row">
          <a class="btn btn--sun" href="#enquire">Book a visit</a>
          <a class="btn btn--ghost" href={telHref(branch.phone)}><Icon name="Phone" size={18} /> {branch.phone}</a>
          <a class="btn btn--ghost" href={directions} target="_blank" rel="noopener">
            <Icon name="Navigation" size={18} /> Directions
          </a>
        </div>
      </div>
      {
        cover && (
          <a class="branch-hero__open" href={fullSize[0]!.src} data-album-for="branch" data-album-open="0" aria-haspopup="dialog">
            <Image
              class="branch-hero__photo"
              src={cover}
              alt={photoAlt(1)}
              widths={[480, 720, 1000]}
              sizes="(max-width: 900px) 100vw, 560px"
              loading="eager"
            />
            {photos.length > 1 && (
              <span class="branch-hero__count">
                <Icon name="Images" size={18} /> {photos.length} photos
              </span>
            )}
          </a>
        )
      }
    </div>
  </section>

  <section class="section--tight section--white">
    <div class="container">
      <ul class="facts">
        {
          facts.map((f) => (
            <li>
              <span class="icon-badge">
                <Icon name={f.icon} size={22} />
              </span>
              <span>
                <span class="facts__label">{f.label}</span>
                {f.hours ? (
                  <strong class="facts__hours">
                    {f.hours.map((h) => (
                      <>
                        {h.days && <span class="facts__days">{h.days}</span>}
                        <TimeRange from={h.from} to={h.to} />
                      </>
                    ))}
                  </strong>
                ) : (
                  <strong>{f.value}</strong>
                )}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container about">
      <div>
        <SectionHeading eyebrow="About this centre" title={`Welcome to ${shortName}`} />
        {branch.description.map((p) => <p class="muted">{p}</p>)}
      </div>
      <div class="card about__amenities">
        <h3>Amenities</h3>
        <ul class="amen">
          {
            branch.amenities.map((key) => (
              <li>
                <Icon name={amenityList[key].icon} size={20} />
                {amenityList[key].label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="section section--white" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHeading eyebrow="Gallery" title="Take a look inside" id="gallery-title" />
          <ul class="gallery">
            {gallery.map((photo, i) => (
              <li>
                <a href={fullSize[i + 1]!.src} data-album-for="branch" data-album-open={i + 1} aria-haspopup="dialog">
                  <Image
                    src={photo}
                    alt={photoAlt(i + 2)}
                    widths={[360, 600, 900]}
                    sizes={i === 0 ? '(max-width: 700px) 100vw, 580px' : '(max-width: 700px) 50vw, 290px'}
                  />
                  {notShown > 0 && i === gallery.length - 1 && (
                    <span class="gallery__more" aria-hidden="true">
                      +{notShown}
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    branch.centerHead && (
      <section class="section">
        <div class="container">
          <div class="card head">
            {head ? (
              <Image class="head__photo" src={head} alt={`${branch.centerHead.name}, Centre Head`} width={240} height={240} />
            ) : (
              <span class="head__photo head__photo--initials" aria-hidden="true">
                {branch.centerHead.name.replace(/^(Mrs?s?\.|Dr\.)\s*/, '').split(' ').map((n) => n[0]).join('')}
              </span>
            )}
            <div>
              <span class="eyebrow">Know our centre head</span>
              <h2>{branch.centerHead.name}</h2>
              <p>{branch.centerHead.bio[0]}</p>
              {branch.centerHead.bio.length > 1 && (
                <details class="head__more">
                  <summary>
                    Read more <Icon name="ChevronDown" size={18} />
                  </summary>
                  {branch.centerHead.bio.slice(1).map((p) => (
                    <p>{p}</p>
                  ))}
                </details>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--white">
    <div class="container location">
      <div class="card location__card">
        <h2>Visit us</h2>
        <address>
          <Icon name="MapPin" size={22} />
          <span>
            {branch.address.map((line) => <>{line}<br /></>)}
            {branch.pincode}
          </span>
        </address>
        <p>
          <Icon name="Phone" size={20} />
          <a href={telHref(branch.phone)}>{branch.phone}</a>
        </p>
        <p>
          <Icon name="Mail" size={20} />
          <a href={`mailto:${branch.email}`}>{branch.email}</a>
        </p>
        <a class="btn btn--sm" href={directions} target="_blank" rel="noopener">Open in Google Maps</a>
      </div>
      <div class="location__map">
        <iframe
          title={`Map showing ${branch.name}`}
          src={mapSrc}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow={`At ${shortName}`} title="Programs and timings" />
      <div class="offered">
        {
          offered.map((p) => (
            <article class:list={['offered__item', 'card', `tone-${p.color}`]} aria-labelledby={`offered-${p.slug}`}>
              <a class="offered__head" href={`/our-programs#${p.slug}`}>
                <span class="icon-badge">
                  <Icon name={p.icon} size={24} />
                </span>
                <div>
                  <h3 class="offered__name" id={`offered-${p.slug}`}>
                    {p.name}
                  </h3>
                  <span class="muted">{p.ages}</span>
                </div>
              </a>
              {batchesOf(p.slug).length ? (
                <ul class="batches">
                  {batchesOf(p.slug).map((b) => (
                    <li class="batch">
                      <strong class="batch__name">{b.name || <TimeRange from={b.from} to={b.to} />}</strong>
                      {b.name && (
                        <strong class="batch__time">
                          <TimeRange from={b.from} to={b.to} />
                        </strong>
                      )}
                      {b.days?.length ? <span class="batch__days">{formatDays(b.days)}</span> : null}
                      {b.seats && <span class:list={['batch__seats', `batch__seats--${b.seats}`]}>{seatLabels[b.seats]}</span>}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="batches-none muted">
                  <a href={telHref(branch.phone)}>Call us</a> for timings.
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--white" id="enquire">
    <div class="container enquire">
      <div>
        <span class="eyebrow">Admissions open</span>
        <h2>Book a visit to {shortName}</h2>
        <p class="lead">
          Leave your details and the {shortName} team will call you to arrange a visit at a time that suits you.
        </p>
      </div>
      <div class="card enquire__form">
        <EnquiryForm branch={branch.slug} id={`enquiry-${branch.slug}`} askBatch />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="More centres" title="Other Crossmaze branches" />
      <div class="grid grid--4">
        {others.map((b, i) => <BranchCard branch={b} index={i + 1} />)}
      </div>
    </div>
  </section>
  {photos.length > 0 && <PhotoAlbum id="branch" photos={photos} title={branch.name} alt={photoAlt} />}
</BaseLayout>

<style>
  .branch-hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 900px) {
    .branch-hero__inner {
      grid-template-columns: 1fr;
    }
  }

  /* The page set's big drifting doodle would sit behind the photo and poke out above its frame. */
  .branch-hero :global(.fx__shape--page-1) {
    display: none;
  }

  .branch-hero h1 {
    max-width: 16ch;
  }

  .branch-hero .btn-row {
    margin-top: 28px;
  }

  .branch-hero__open {
    position: relative;
    display: block;
    border-radius: var(--radius-photo);
    cursor: zoom-in;
  }

  .branch-hero__count {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow-sm);
    color: var(--ink);
    font-weight: 800;
    font-size: 0.9rem;
    transition: transform 0.2s ease;
  }

  .branch-hero__open:hover .branch-hero__count {
    transform: translateY(-2px);
  }

  .branch-hero :global(.branch-hero__photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    padding: 6px;
    border-radius: var(--radius-photo);
    background: var(--g-ring);
    box-shadow: var(--shadow);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .facts .icon-badge {
    margin: 0;
    flex: none;
  }

  @media (max-width: 640px) {
    .facts {
      grid-template-columns: 1fr 1fr;
      gap: 24px 16px;
    }
    .facts li {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
  }

  .facts__label {
    display: block;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Opening hours that differ by day: each group of days above its hours, or beside them, lined up in two
     columns, when the fact has room. */
  .facts li > span:last-child {
    flex: 1;
    min-width: 0;
    container-type: inline-size;
  }

  @media (max-width: 640px) {
    .facts li > span:last-child {
      align-self: stretch;
    }
  }

  .facts__hours {
    display: grid;
    align-items: baseline;
    column-gap: 10px;
  }

  @container (min-width: 230px) {
    .facts__hours:has(.facts__days) {
      grid-template-columns: max-content minmax(0, 1fr);
    }
  }

  .facts__days {
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--muted);
  }

  .about {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  .about p {
    max-width: 68ch;
  }

  .about__amenities h3 {
    margin-bottom: 16px;
  }

  .amen {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  .amen li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .amen :global(svg) {
    flex: none;
    color: var(--green);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 180px;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery li:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media (max-width: 700px) {
    .gallery {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: 130px;
    }
  }

  .gallery a {
    position: relative;
    display: block;
    height: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
  }

  /* "+3": photos the grid leaves out, which the album shows. */
  .gallery__more {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--photo-scrim);
    backdrop-filter: blur(2px);
    color: #fff;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
  }

  .gallery :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery a:hover :global(img) {
    transform: scale(1.04);
  }

  .head {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(24px, 4vw, 48px);
    align-items: start;
    padding: clamp(24px, 4vw, 40px);
  }

  @media (max-width: 700px) {
    .head {
      grid-template-columns: 1fr;
    }
  }

  .head :global(.head__photo) {
    width: 220px;
    height: 220px;
    border-radius: 50%;
    object-fit: cover;
    border: 6px solid var(--sun-50);
  }

  /* --sun-50 is a deep, muddy tint at night: a soft golden ring instead. */
  /* At night the portrait gets the same glass frame as the other photos (a mixed ring went khaki). */
  :global(:root[data-mode='dark']) .head :global(.head__photo) {
    border-color: transparent;
    background: var(--g-ring) border-box;
  }

  :global(:root[data-mode='dark']) .head .head__photo--initials {
    background:
      var(--g-navy) padding-box,
      var(--g-ring) border-box;
  }

  @media (max-width: 700px) {
    .head :global(.head__photo) {
      width: 160px;
      height: 160px;
    }
  }

  .head__photo--initials {
    display: grid;
    place-items: center;
    background: var(--g-navy);
    color: var(--sun);
    font-family: var(--font-display);
    font-size: 3rem;
  }

  .head h2 {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .head p {
    color: var(--muted);
    max-width: 70ch;
  }

  .head__more summary {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 800;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
  }

  .head__more summary::-webkit-details-marker {
    display: none;
  }

  .head__more[open] summary {
    margin-bottom: 1em;
  }

  .head__more[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .location {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 24px;
    align-items: stretch;
  }

  @media (max-width: 860px) {
    .location {
      grid-template-columns: 1fr;
    }
  }

  .location__card address,
  .location__card p {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-style: normal;
    margin: 0 0 16px;
  }

  .location__card :global(svg) {
    flex: none;
    margin-top: 3px;
    color: var(--coral);
  }

  .location__card .btn {
    margin-top: 8px;
  }

  .location__map {
    min-height: 340px;
    border-radius: var(--radius);
    overflow: hidden;
    border: 6px solid var(--glass-edge);
    box-shadow: var(--glass-rim), var(--shadow-sm);
    background: linear-gradient(135deg, var(--navy-50) 0%, var(--green-50) 100%);
  }

  .location__map iframe {
    width: 100%;
    height: 100%;
    min-height: 340px;
    border: 0;
  }

  /* At night: smoky glass behind the map, and Google's light map turned into a night map. */
  :global(:root[data-mode='dark']) .location__map {
    border: 1px solid var(--glass-edge);
    background: var(--glass);
  }

  :global(:root[data-mode='dark']) .location__map iframe {
    filter: invert(0.9) hue-rotate(180deg) saturate(0.8);
  }

  /* Programs and timings: a card per program with its batches here, each a soft band in the
     program's colour (src/data/batches.ts). */
  .offered {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 16px;
    align-items: start;
  }

  .offered__item {
    display: grid;
    gap: 14px;
    padding: 18px;
  }

  .offered__head {
    display: flex;
    align-items: center;
    gap: 14px;
    color: inherit;
    text-decoration: none;
  }

  .offered__head:hover {
    color: inherit;
  }

  /* The program's name, as a heading for screen readers, looking as the bold name always did. */
  .offered__name {
    margin: 0;
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    line-height: inherit;
    letter-spacing: normal;
    color: inherit;
  }

  .offered__head:hover .offered__name {
    text-decoration: underline;
    text-decoration-color: var(--tone);
    text-underline-offset: 3px;
  }

  .offered__head .icon-badge {
    margin: 0;
    flex: none;
  }

  .offered__head > div {
    display: grid;
    line-height: 1.3;
  }

  .batches {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Two columns, filled in order: the name (or the time) and the time, then the days and the seats
     label. A long name wraps in its own column, so the times stay lined up on the right. */
  .batch {
    display: grid;
    grid-template-columns: minmax(min-content, 1fr) auto;
    align-items: center;
    gap: 2px 12px;
    padding: 10px 14px;
    border: 1px solid color-mix(in srgb, var(--tone) 22%, transparent);
    border-radius: 14px;
    background: color-mix(in srgb, var(--badge-bg) 70%, transparent);
  }

  .batch__name {
    grid-column: 1;
  }

  .batch__time,
  .batch__seats {
    grid-column: 2;
    justify-self: end;
    text-align: right;
  }

  .batch__days {
