---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import FormSection from '../../components/FormSection.astro';
import Icon from '../../components/Icon.astro';
import FloatingShapes from '../../components/FloatingShapes.astro';
import PhotoAlbum from '../../components/PhotoAlbum.astro';
import {
  branches,
  amenityList,
  branchPhotos,
  headPhoto,
  shortName as toShortName,
  telHref,
  type Branch,
} from '../../data/branches';
import TimeRange from '../../components/TimeRange.astro';
import { dayRuns, openingHoursSpecification, openingTimes, seatLabels } from '../../data/batches';
import { programs } from '../../data/programs';
import { site } from '../../data/site';

export function getStaticPaths() {
  return branches.map((branch) => ({ params: { slug: branch.slug }, props: { branch } }));
}

interface Props {
  branch: Branch;
}

const { branch } = Astro.props;
const shortName = toShortName(branch);
// "Crossmaze – The Hub" with a no-break space before the dash, so a long name wraps after the dash
// ("Crossmaze – / Neeladri Nagar"), never before it.
const heroTitle = branch.name.replace(/^(Crossmaze)\s+(?=[–-])/, '$1 ');
const offered = programs.filter((p) => branch.programs.includes(p.slug));
// Each program's batches here (src/data/batches.ts), and when the branch is open: earliest start to latest end.
const batches = branch.batches ?? [];
const batchesOf = (slug: string) => batches.filter((b) => b.program === slug);
const open = openingTimes(batches);
const openLabel = (days: string) => (!days ? 'Open' : days === 'Every day' ? 'Open every day' : `Open ${days}`);
const hours = openingHoursSpecification(batches);
const others = branches.filter((b) => b.slug !== branch.slug);
const photos = branchPhotos(branch.slug);
// The cover photo sits in the banner; the others fill the gallery. Every photo opens in the album
// (components/PhotoAlbum.astro).
const [cover, ...rest] = photos;
const photoAlt = (n: number) => (n === 1 ? `Inside ${branch.name}` : `${branch.name} – photo ${n}`);
const fullSize = await Promise.all(photos.map((p) => getImage({ src: p, width: 1600, format: 'webp' })));
const head = headPhoto(branch.slug);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(branch.mapQuery)}&output=embed`;
const directions = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(branch.mapQuery)}`;
const emailAt = branch.email.lastIndexOf('@');

// The gallery: the photos after the cover as framed 3:2 tiles in full rows, so the owner can add any
// number of photos. Each screen width has its own plan, on a 12-column grid:
//  - lg (from 1001px): rows of four or three, or a big first tile beside four small ones;
//  - md (700–1000px): rows of three or two;
//  - sm (up to 699px): rows of two, the first tile across the full width when that evens them out.
// The fewest rows win, with the bigger tiles first. At most nine tiles: when two or more photos are left
// over, the last tile counts them ("+3"); one photo is never left over on its own (it would have no
// tile and no count). Every photo opens in the album.
type Screen = { lengths: number[]; lead?: number; big?: boolean; maxRows: number };
type Plan = { tiles: number; rows: number[]; big: boolean };
const screens = {
  lg: { lengths: [3, 4], big: true, maxRows: 3 },
  md: { lengths: [2, 3], maxRows: 3 },
  sm: { lengths: [2], lead: 1, maxRows: 5 },
} satisfies Record<string, Screen>;
type ScreenKey = keyof typeof screens;
const screenKeys = Object.keys(screens) as ScreenKey[];
const MAX_TILES = 9;
// The big tile takes two rows of four: itself (two columns wide) and four small tiles beside it.
const BIG_BLOCK = 5;

// Every way to fill at most `maxRows` rows with exactly `tiles` tiles, a length from `lengths` a row,
// shortest rows (biggest tiles) first.
function fills(tiles: number, lengths: number[], maxRows: number, shortest = 0): number[][] {
  if (tiles === 0) return [[]];
  if (maxRows === 0) return [];
  return lengths
    .filter((len) => len >= shortest && len <= tiles)
    .flatMap((len) => fills(tiles - len, lengths, maxRows - 1, len).map((more) => [len, ...more]));
}

function galleryPlan(n: number, { lengths, lead, big, maxRows }: Screen): Plan {
  for (let tiles = Math.min(n, MAX_TILES); tiles >= 1; tiles--) {
    if (n - tiles === 1) continue;
    // Fewer photos than the shortest row: one row of them.
    if (tiles < Math.min(...lengths)) return { tiles, rows: [tiles], big: false };
    const options: Plan[] = [
      ...fills(tiles, lengths, maxRows).map((rows) => ({ tiles, rows, big: false })),
      ...(lead ? fills(tiles - lead, lengths, maxRows - 1).map((rows) => ({ tiles, rows: [lead, ...rows], big: false })) : []),
      ...(big && tiles >= BIG_BLOCK ? fills(tiles - BIG_BLOCK, lengths, maxRows - 2).map((rows) => ({ tiles, rows, big: true })) : []),
    ];
    const rowCount = (p: Plan) => p.rows.length + (p.big ? 2 : 0);
    const kinds = (p: Plan) => new Set(p.rows).size;
    // The fewest rows; then the big tile; then rows all the same length.
    options.sort((a, b) => rowCount(a) - rowCount(b) || Number(b.big) - Number(a.big) || kinds(a) - kinds(b));
    if (options[0]) return options[0];
  }
  return { tiles: 0, rows: [], big: false };
}

const plans = Object.fromEntries(screenKeys.map((s) => [s, galleryPlan(rest.length, screens[s])])) as Record<ScreenKey, Plan>;
// Each tile's width in twelfths of the row on each screen (12 for a tile the plan leaves out there).
const spansOf = (plan: Plan) => [
  ...(plan.big ? [6, 3, 3, 3, 3] : []),
  ...plan.rows.flatMap((len) => Array<number>(len).fill(12 / len)),
];
const spans = Object.fromEntries(screenKeys.map((s) => [s, spansOf(plans[s])])) as Record<ScreenKey, number[]>;
const span = (s: ScreenKey, i: number) => spans[s][i] ?? 12;
const gallery = rest.slice(0, Math.max(0, ...screenKeys.map((s) => plans[s].tiles)));
const leftOver = (s: ScreenKey) => rest.length - plans[s].tiles;
// The width each tile is drawn at, for picking the image size (the page is at most 1180px wide).
const tileSizes = (i: number) =>
  `(max-width: 699px) ${Math.round((span('sm', i) / 12) * 100)}vw, (max-width: 1000px) ${Math.round((span('md', i) / 12) * 100)}vw, ${Math.round((span('lg', i) / 12) * 1180)}px`;

const facts = [
  branch.carpetArea && { icon: 'Ruler', label: 'Carpet area', value: branch.carpetArea },
  branch.capacity && { icon: 'Users', label: 'Capacity', value: `${branch.capacity} children` },
  branch.centerHead && { icon: 'UserRound', label: 'Centre head', value: branch.centerHead.name, href: '#centre-head' },
  // One range when the days share their hours ("Open Mon – Fri", "9:00 am – 6:00 pm"), else one per group of days.
  open.length === 1 && { icon: 'Clock', label: openLabel(open[0]!.days), hours: [{ ...open[0]!, days: '' }] },
  open.length > 1 && { icon: 'Clock', label: 'Open', hours: open },
].filter(Boolean) as { icon: string; label: string; value?: string; href?: string; hours?: { days: string; from: string; to: string }[] }[];
// All the facts in one row on wide screens, each as wide as its text needs (a long name gets more room
// than "180 children"); two to a row on tablets (three when there are three) and phones.
const RANGE_CHARS = '9:00 am – 6:00 pm'.length;
const factChars = (f: (typeof facts)[number]) =>
  Math.max(f.label.length, f.hours ? Math.max(...f.hours.map((h) => (h.days ? h.days.length + 2 : 0) + RANGE_CHARS)) : (f.value ?? '').length);
const factsCols = facts.map((f) => `minmax(0, ${factChars(f) + 8}fr)`).join(' ');
const factsMd = facts.length === 3 ? 3 : Math.min(facts.length, 2);
const factsSm = Math.min(facts.length, 2);

// On wide screens the timetable runs in two columns, down the first and then the second. The second
// starts at the program that makes the two closest in height (a program with more batches is taller);
// with a tie, the first column takes the extra program.
const weights = offered.map((p) => 1 + 0.7 * Math.max(0, batchesOf(p.slug).length - 1));
const weightBefore = (k: number) => weights.slice(0, k).reduce((sum, w) => sum + w, 0);
const imbalance = (k: number) => Math.abs(2 * weightBefore(k) - weightBefore(offered.length));
let secondColumn = offered.length - 1;
for (let k = offered.length - 2; k >= 1; k--) if (imbalance(k) < imbalance(secondColumn)) secondColumn = k;
// The other branches, each with its cover photo and colour.
const tones = ['navy', 'green', 'coral', 'sky', 'sun'];
const otherCards = others.map((b, i) => ({ branch: b, cover: branchPhotos(b.slug)[0], tone: tones[(i + 1) % tones.length] }));

const jsonLd = {
  '@context': 'https://schema.org',
  // Preschool, and as day care a local business, for which Google shows opening hours.
  '@type': ['Preschool', 'ChildCare'],
  name: branch.name,
  url: new URL(`/branch/${branch.slug}`, site.url).href,
  telephone: branch.phone,
  email: branch.email,
  ...(cover ? { image: new URL(fullSize[0]!.src, site.url).href } : {}),
  parentOrganization: { '@type': 'Organization', name: site.fullName, url: site.url },
  ...(hours.length ? { openingHoursSpecification: hours } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: branch.address.slice(0, -1).join(', '),
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    postalCode: branch.pincode,
    addressCountry: 'IN',
  },
};
---

<BaseLayout
  title={`${shortName} Branch`}
  description={`${branch.name}: preschool and day care in ${branch.area}, Bengaluru ${branch.pincode}. Play Group, Nursery, Junior KG, Senior KG and Day Care.`}
  jsonLd={jsonLd}
>
  <section class="page-hero branch-hero">
    <FloatingShapes />
    <div class="container branch-hero__inner">
      <div>
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumbs">
            <li><a href="/">Home</a></li>
            <li><a href="/branch">Branches</a></li>
            <li><span aria-current="page">{shortName}</span></li>
          </ol>
        </nav>
        <span class="eyebrow">{branch.area} · {branch.pincode}</span>
        <h1>{heroTitle}</h1>
        <p class="lead">{branch.intro}</p>
        <div class="btn-row">
          <a class="btn btn--sun" href="#enquire">Book a visit</a>
          <a class="btn btn--ghost" href={telHref(branch.phone)}><Icon name="Phone" size={18} /> {branch.phone}</a>
          <a class="btn btn--ghost" href={directions} target="_blank" rel="noopener">
            <Icon name="Navigation" size={18} /> Directions
          </a>
        </div>
      </div>
      {
        cover && (
          <a class="branch-hero__open" href={fullSize[0]!.src} data-album-for="branch" data-album-open="0" aria-haspopup="dialog">
            <Image
              class="branch-hero__photo"
              src={cover}
              alt={photoAlt(1)}
              widths={[480, 720, 1000, 1400]}
              sizes="(max-width: 900px) calc(100vw - 32px), 580px"
              loading="eager"
            />
            {photos.length > 1 && (
              <span class="branch-hero__count">
                <Icon name="Images" size={18} /> {photos.length} photos
              </span>
            )}
          </a>
        )
      }
    </div>
  </section>

  {
    facts.length > 0 && (
      <section class="section--tight branch-facts">
        <div class="container">
          <ul class="facts" style={`--facts-cols: ${factsCols}; --facts-md: ${factsMd}; --facts-sm: ${factsSm}`}>
            {facts.map((f) => (
              <li>
                <span class="icon-badge">
                  <Icon name={f.icon} size={22} />
                </span>
                <span>
                  <span class="facts__label">{f.label}</span>
                  {f.hours ? (
                    <strong class="facts__hours">
                      {f.hours.map((h) => (
                        <>
                          {h.days && <span class="facts__days">{h.days}</span>}
                          <TimeRange from={h.from} to={h.to} />
                        </>
                      ))}
                    </strong>
                  ) : f.href ? (
                    <strong>
                      <a class="facts__link" href={f.href}>
                        {f.value}
                      </a>
                    </strong>
                  ) : (
                    <strong>{f.value}</strong>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section branch-timings" id="timings" aria-labelledby="timings-title">
    <div class="container">
      <SectionHeading eyebrow={`At ${shortName}`} title="Programs and timings" id="timings-title" />
      {/* The timetable: a row per program (its name and ages, linking to it on Our Programs), with its
          batches here beside it, each a soft band in the program's colour (src/data/batches.ts). */}
      <ul class:list={['card', 'timetable', { 'timetable--single': offered.length < 2 }]}>
        {
          offered.map((p, i) => (
            <li class:list={['timetable__row', `tone-${p.color}`, { 'is-col-top': offered.length > 1 && i === secondColumn }]}>
              <a class="timetable__program" href={`/our-programs#${p.slug}`}>
                <span class="icon-badge">
                  <Icon name={p.icon} size={22} />
                </span>
                <span class="timetable__label">
                  <h3 class="timetable__name" id={`offered-${p.slug}`}>
                    {p.name}
                  </h3>
                  <span class="muted">{p.ages}</span>
                </span>
              </a>
              {batchesOf(p.slug).length ? (
                <ul class="batches" aria-labelledby={`offered-${p.slug}`}>
                  {batchesOf(p.slug).map((b) => (
                    <li class="batch">
                      {b.name && <strong class="batch__name">{b.name}</strong>}
                      <strong class="batch__time">
                        <TimeRange from={b.from} to={b.to} />
                      </strong>
                      {b.days?.length ? (
                        <span class="batch__days">
                          {dayRuns(b.days).map((run, j) => (
                            <>
                              {j > 0 && ', '}
                              <span class="batch__run">{run}</span>
                            </>
                          ))}
                        </span>
                      ) : null}
                      {b.seats && <span class:list={['batch__seats', `batch__seats--${b.seats}`]}>{seatLabels[b.seats]}</span>}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="batches-none muted">
                  <a href={telHref(branch.phone)}>Call us</a> for timings.
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section branch-about" aria-labelledby="about-title">
    <div class="container">
      <div class:list={['about', { 'about--solo': !branch.centerHead }]}>
        <div class="about__text">
          <SectionHeading eyebrow="About this centre" title={`Welcome to ${shortName}`} id="about-title" />
          {branch.description.map((p) => <p class="muted">{p}</p>)}
        </div>
        {
          branch.centerHead && (
            <aside class="card head" id="centre-head" aria-labelledby="centre-head-name">
              <div class="head__top">
                {head ? (
                  <Image class="head__photo" src={head} alt={`${branch.centerHead.name}, Centre Head`} width={192} height={192} />
                ) : (
                  <span class="head__photo head__photo--initials" aria-hidden="true">
                    {branch.centerHead.name
                      .replace(/^(Mrs?s?\.|Dr\.)\s*/, '')
                      .split(' ')
                      .map((n) => n[0])
                      .join('')}
                  </span>
                )}
                <div>
                  <span class="eyebrow">Know our centre head</span>
                  <h3 class="head__name" id="centre-head-name">
                    {branch.centerHead.name}
                  </h3>
                </div>
              </div>
              <div class="head__bio">
                {branch.centerHead.bio.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </aside>
          )
        }
      </div>
      {
        branch.amenities.length > 0 && (
          <div class="card amenities">
            <h3>Amenities</h3>
            <ul class="amen">
              {branch.amenities.map((key) => (
                <li>
                  <Icon name={amenityList[key].icon} size={20} />
                  {amenityList[key].label}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="section branch-gallery" aria-labelledby="gallery-title">
        <div class="container">
          <div class="gallery-head">
            <SectionHeading eyebrow="Gallery" title="Take a look inside" id="gallery-title" />
            {photos.length > 2 && (
              <a class="btn btn--ghost btn--sm" href={fullSize[0]!.src} data-album-for="branch" data-album-open="0" aria-haspopup="dialog">
                <Icon name="Images" size={18} /> All {photos.length} photos
              </a>
            )}
          </div>
          <ul class:list={['gallery', { 'gallery--one': gallery.length === 1 }]}>
            {gallery.map((photo, i) => (
              <li
                class:list={[
                  ...screenKeys.filter((s) => i >= plans[s].tiles).map((s) => `hide-${s}`),
                  { 'big-lg': plans.lg.big && i === 0, 'full-sm': gallery.length > 1 && i < plans.sm.tiles && span('sm', i) === 12 },
                ]}
                style={`--lg: ${span('lg', i)}; --md: ${span('md', i)}; --sm: ${span('sm', i)}`}
              >
                <a
                  class="gallery__tile ratio-frame photo-frame photo-frame--sm"
                  href={fullSize[i + 1]!.src}
                  data-album-for="branch"
                  data-album-open={i + 1}
                  aria-haspopup="dialog"
                >
                  <Image src={photo} alt={photoAlt(i + 2)} widths={[360, 600, 900, 1200]} sizes={tileSizes(i)} />
                  {screenKeys
                    .filter((s) => i === plans[s].tiles - 1 && leftOver(s) >= 2)
                    .map((s) => (
                      <span class={`gallery__more gallery__more--${s}`} aria-hidden="true">
                        +{leftOver(s)}
                      </span>
                    ))}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <FormSection
    id="enquire"
    eyebrow="Admissions open"
    title={`Book a visit to ${shortName}`}
    lead={`Leave your details and our team at ${shortName} will call you to arrange a visit at a time that suits you.`}
  >
    <div class="card visit" slot="aside">
      <h3 class="visit__title">Visit us</h3>
      <div class="visit__body">
        <div class="visit__details">
          <address class="visit__list">
            <p>
              <Icon name="MapPin" size={20} />
              <span>
                {/* The PIN code on the last line ("Bengaluru, Karnataka 560068"). */}
                {branch.address.map((line, i) => (i < branch.address.length - 1 ? <>{line}<br /></> : `${line} `))}
                <span class="visit__pin">{branch.pincode}</span>
              </span>
            </p>
            <p>
              <Icon name="Phone" size={20} />
              <a href={telHref(branch.phone)}>{branch.phone}</a>
            </p>
            <p>
              <Icon name="Mail" size={20} />
              {/* Where it must wrap, the address breaks after the @, never inside a word. */}
              <a href={`mailto:${branch.email}`}>{emailAt >= 0 ? <>{branch.email.slice(0, emailAt + 1)}<wbr />{branch.email.slice(emailAt + 1)}</> : branch.email}</a>
            </p>
          </address>
          <a class="btn btn--sm" href={directions} target="_blank" rel="noopener">
            <Icon name="Navigation" size={16} /> Open in Google Maps
          </a>
        </div>
        <div class="visit__map">
          <iframe
            title={`Map showing ${branch.name}`}
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>
    </div>
    <EnquiryForm slot="form" branch={branch.slug} id={`enquiry-${branch.slug}`} askBatch />
  </FormSection>

  {
    others.length > 0 && (
      <section class="section branch-others" aria-labelledby="others-title">
        <div class="container">
          <SectionHeading eyebrow="More centres" title="Other Crossmaze branches" id="others-title" />
          {/* Cards with the cover photo, the facts and both buttons on one row; on phones, compact rows
              (a small photo, the name and area, and a call button), the whole row leading to the branch.
              "branch-card" tells the call log (scripts/call-log.ts) that a call came from a branch card. */}
          <div class="others">
            <ul class="grid grid--4 others__list">
              {otherCards.map(({ branch: b, cover: photo, tone }) => (
                <li class:list={['card', 'other', 'branch-card', `tone-${tone}`]}>
                  <div class="other__media ratio-frame photo-frame photo-frame--sm">
                    {photo ? (
                      <Image src={photo} alt={`Inside ${b.name}`} widths={[200, 400, 640]} sizes="(max-width: 559px) 112px, (max-width: 1000px) 50vw, 290px" />
                    ) : (
                      <span class="other__art" aria-hidden="true">
                        <Icon name="Building2" size={40} strokeWidth={1.6} />
                      </span>
                    )}
                    <span class="other__pin">
                      <Icon name="MapPin" size={15} /> {b.pincode}
                    </span>
                  </div>
                  <div class="other__text">
                    <h3 class="other__name">
                      <a class="other__link" href={`/branch/${b.slug}`}>
                        {toShortName(b)}
                      </a>
                    </h3>
                    <p class="other__area muted">{b.area}</p>
                    {(b.carpetArea || b.capacity) && (
                      <ul class="other__facts">
                        {b.carpetArea && (
                          <li>
                            <Icon name="Ruler" size={18} />
                            {b.carpetArea}
                          </li>
                        )}
                        {b.capacity && (
                          <li>
                            <Icon name="Users" size={18} />
                            {b.capacity} children
                          </li>
                        )}
                      </ul>
                    )}
                  </div>
                  <div class="other__actions">
                    <a class="btn btn--sm other__view" href={`/branch/${b.slug}`}>
                      View branch
                    </a>
                    <a class="btn btn--sm btn--ghost other__call" href={telHref(b.phone)} aria-label={`Call ${b.name}`}>
                      <Icon name="Phone" size={18} />
                    </a>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }
  {photos.length > 0 && <PhotoAlbum id="branch" photos={photos} title={branch.name} alt={photoAlt} />}
</BaseLayout>

<style>
  /* ---------- Banner ---------- */
  .branch-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  @media (max-width: 900px) {
    .branch-hero__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The page set's big drifting doodle would sit behind the photo and poke out above its frame. */
  .branch-hero :global(.fx__shape--page-1) {
    display: none;
  }

  .branch-hero h1 {
    max-width: 16ch;
  }

  .branch-hero .btn-row {
    margin-top: 28px;
  }

  .branch-hero__open {
    position: relative;
    display: block;
    border-radius: var(--radius-photo);
    cursor: zoom-in;
  }

  .branch-hero__count {
    position: absolute;
    right: 18px;
    bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--glass-edge);
    border-radius: 999px;
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow-sm);
    color: var(--ink);
    font-weight: 800;
