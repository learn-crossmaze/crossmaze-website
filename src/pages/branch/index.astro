---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BranchCard from '../../components/BranchCard.astro';
import Icon from '../../components/Icon.astro';
import { branches, facilities } from '../../data/branches';
import { site } from '../../data/site';

// "Five centres": the number in words up to twelve.
const words = ['One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve'];
const count = words[branches.length - 1] ?? String(branches.length);

// The facilities in full rows: on each screen (wide from 1141px, phones up to 700px) the first of the
// column counts that leaves no gap in the last row, else the one with the fewest gaps, never leaving
// one facility alone under a full row. Twelve go 4 a row on wide screens, 3 on tablets and laptops
// and 2 on phones; ten go 5 / 2 / 2, nine 3 / 3 / 2, eight 4 / 2 / 2, six 3 / 3 / 2.
const columnsFor = (n: number, choices: number[]) => {
  // The empty places in the last row, plus a full row's worth when it holds a single facility.
  const cost = (cols: number) => {
    const last = n % cols;
    return last === 0 ? 0 : cols - last + (last === 1 && n > cols ? cols : 0);
  };
  return Math.min(n, choices.reduce((best, cols) => (cost(cols) < cost(best) ? cols : best)));
};
const facilityCols = {
  lg: columnsFor(facilities.length, [4, 3, 5]),
  md: columnsFor(facilities.length, [3, 2]),
  sm: columnsFor(facilities.length, [2]),
};
// The badges take the same colours as the facility cards on the home page (FacilityStrip.astro).
const tones = ['coral', 'sun', 'green', 'sky', 'navy'];
---

<BaseLayout
  fullTitle={`Preschool & Day Care Centres in Electronic City & Begur | ${site.name}`}
  description="Find your nearest Crossmaze Preschool and Day Care: The Hub in Begur, and Neotown, SNN Greenbay, Neeladri Nagar and Ananth Nagar in Electronic City, Bengaluru."
>
  <PageHero
    eyebrow="Our branches"
    title={`${count} ${branches.length === 1 ? 'centre' : 'centres'}, one Crossmaze family`}
    lead="Preschool and day care in Electronic City and Begur, Bengaluru. Every centre follows the same curriculum, safety standards and caring approach, so your child gets the Crossmaze experience wherever you are."
    crumbs={[{ label: 'Branches' }]}
  />

  {/* The cards start just under the banner, so they read as its list: each centre's name is a heading
      (h2) with its area and short introduction (admin panel → Branches). */}
  <section class="section section--tight branch-list" aria-label="Our centres">
    <div class="container">
      <div class="grid grid--3">
        {branches.map((b, i) => <BranchCard branch={b} index={i} level={2} showIntro />)}
      </div>
    </div>
  </section>

  {
    facilities.length > 0 && (
      <section class="section--tight branch-facilities" aria-labelledby="facilities-title">
        <div class="container">
          <div class="card facilities">
            <h2 class="facilities__title" id="facilities-title">
              Our facilities
            </h2>
            <ul
              class="facilities__list"
              style={`--cols-lg: ${facilityCols.lg}; --cols-md: ${facilityCols.md}; --cols-sm: ${facilityCols.sm}`}
            >
              {facilities.map((f, i) => (
                <li class={`tone-${tones[i % tones.length]}`}>
                  <span class="icon-badge">
                    <Icon name={f.icon} size={22} />
                  </span>
                  <span class="facilities__name">{f.title}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* The banner's own bottom padding is the gap above the cards (a little more, so a card's hover
     shadow isn't cut off). */
  .branch-list {
    padding-top: clamp(16px, 2vw, 24px);
  }

  /* The space under the cards is the gap above the facilities (a little more, so the panel's shadow
     isn't cut off). */
  .branch-facilities {
    padding-top: 16px;
  }

  /* ---------- Our facilities: one glass panel, the facilities in full rows ---------- */
  .facilities {
    padding: clamp(22px, 3.4vw, 40px);
  }

  .facilities__title {
    margin-bottom: clamp(18px, 2.4vw, 28px);
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
  }

  .facilities__list {
    display: grid;
    grid-template-columns: repeat(var(--cols-lg), minmax(0, 1fr));
    gap: 18px clamp(16px, 2.4vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Fewer columns below 1141px, where four would leave a long name such as "Parents' communication
     app" three lines. */
  @media (max-width: 1140px) {
    .facilities__list {
      grid-template-columns: repeat(var(--cols-md), minmax(0, 1fr));
    }
  }

  /* Two up to 700px, where three would leave a long word such as "communication" wider than its
     column. */
  @media (max-width: 700px) {
    .facilities__list {
      grid-template-columns: repeat(var(--cols-sm), minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .facilities__list {
      gap: 14px 12px;
    }
  }

  /* Each facility: its badge beside the name, which wraps into even lines when it needs two. */
  .facilities__list li {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
    font-weight: 700;
    line-height: 1.3;
  }

  .facilities__list .icon-badge {
    flex: none;
    width: 44px;
    height: 44px;
    margin: 0;
    border-radius: 14px;
  }

  /* A word too long for its column (as on the narrowest phones) is hyphenated or, where a browser doesn't
     hyphenate, broken anywhere rather than running out of the panel. */
  .facilities__name {
    min-width: 0;
    text-wrap: balance;
    -webkit-hyphens: auto;
    hyphens: auto;
    overflow-wrap: anywhere;
  }

  /* Phones: two columns of icons (without their badges, as with the amenities on a branch page) and
     names, so a long word such as "communication" still fits its column. */
  @media (max-width: 560px) {
    .facilities {
      padding: 20px 18px;
    }

    .facilities__list li {
      align-items: flex-start;
      gap: 8px;
      font-size: 0.94rem;
    }

    .facilities__list .icon-badge {
      width: auto;
      height: auto;
      margin-top: 1px;
      border-radius: 0;
      background: none;
      box-shadow: none;
    }

    .facilities__list .icon-badge :global(svg) {
      width: 19px;
      height: 19px;
    }
  }
</style>
