---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { site, coreValues } from '../data/site';
import { approach } from '../data/programs';
import { image } from '../data/content';
import { blocksOf } from '../data/about';

const moments = site.moments.map((m) => ({ src: image(m.image), alt: m.alt }));
const tones = ['navy', 'green', 'coral', 'sky', 'sun', 'navy'];
// "Who we are": the first paragraph is the lead beside the photo, the rest flow in two columns below.
const [intro, ...rest] = site.about;
const statTones = ['navy', 'coral', 'green', 'sky'];
const blockTones = ['sun', 'green', 'coral', 'sky'];
---

<BaseLayout
  title="About Us"
  description="About Crossmaze Preschool and Day Care, Bengaluru: an interactive, Montessori-based preschool where every child is special. Our story, core values and approach."
>
  <PageHero
    eyebrow="About Crossmaze"
    title="An interactive place where every child can excel"
    lead={site.promise}
    crumbs={[{ label: 'About' }]}
  />

  <section class="section section--white">
    <div class="container story">
      <div class="story__intro">
        <div class="story__lead">
          <SectionHeading eyebrow="Who we are" title="Every child is special" />
          {
            intro && (
              <>
                {intro.heading && <h3 class="story__kicker">{intro.heading}</h3>}
                {blocksOf(intro.text).map((t, i) => (
                  <p class:list={[i === 0 && 'lead']}>{t}</p>
                ))}
              </>
            )
          }
        </div>
        <div class="story__media">
          <Image src={image(site.aboutPhoto.image)} alt={site.aboutPhoto.alt} widths={[400, 555]} sizes="(max-width: 860px) 100vw, 540px" />
          <ul class="story__stats" aria-label="Crossmaze in numbers">
            {
              site.stats.map((s, i) => (
                <li class:list={['stat', `tone-${statTones[i % statTones.length]}`]}>
                  <strong data-countup>{s.value}</strong>
                  <span>{s.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="story__flow">
        {
          rest.map((p, i) => (
            <div class:list={['story__block', `tone-${blockTones[i % blockTones.length]}`]}>
              {p.heading && <h3>{p.heading}</h3>}
              {blocksOf(p.text).map((t) => (
                <p>{t}</p>
              ))}
            </div>
          ))
        }
        {
          site.quote.text && (
            <blockquote class="story__quote">
              <p>{site.quote.text}</p>
              {site.quote.author && <cite>{site.quote.author}</cite>}
            </blockquote>
          )
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Our core values"
        title="More than guiding principles"
        lead="Our core values are more than guiding principles. They are the foundation of our commitment to excellent early education, and they shape our classrooms, our daily routines and how we work with children, parents and the community."
        align="center"
      />
      <div class="grid grid--3">
        {
          coreValues.map((v, i) => (
            <div class:list={['card', `tone-${tones[i % tones.length]}`]}>
              <span class="icon-badge">
                <Icon name={v.icon} size={26} />
              </span>
              <h3>{v.title}</h3>
              <p class="muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="Our approach"
        title="How children learn at Crossmaze"
        lead="Our Foundational Development Program uses a Montessori-based, thematic approach to build the skills children need for school and for life."
      />
      <div class="grid grid--2">
        {
          approach.map((a) => (
            <div class="approach">
              <span class="icon-badge">
                <Icon name={a.icon} size={26} />
              </span>
              <div>
                <h3>{a.title}</h3>
                <p class="muted">{a.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="Life at Crossmaze" title="Moments that build confidence" align="center" />
      <ul class="moments">
        {
          moments.map((m) => (
            <li>
              <Image src={m.src} alt={m.alt} widths={[300, 500]} sizes="(max-width: 700px) 50vw, 240px" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--white">
    <div class="container founders">
      <SectionHeading eyebrow="Leadership" title="Our founders" />
      <div class="grid grid--2">
        {
          site.founders.map((name) => (
            <div class="card founder">
              <span class="founder__avatar" aria-hidden="true">
                {name
                  .split(' ')
                  .map((n) => n[0])
                  .join('')}
              </span>
              <div>
                <h3>{name}</h3>
                <p class="muted">Co-founder, {site.legalName}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section--tight section--feature">
    <div class="container cta">
      <div>
        <h2>See Crossmaze for yourself</h2>
        <p class="lead">Visit your nearest centre and meet our team.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--sun" href="/contact#enquire">Book a visit</a>
        <a class="btn btn--ghost" href="/branch">Find a branch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* "Who we are": the heading and first paragraph as a lead beside the photo (with the numbers on a
     glass panel over its lower edge), then the other paragraphs in two columns, each under a hairline
     with a short coloured tab, and the quote as a pull quote that fills the last row. */
  .story {
    --story-gap: clamp(32px, 5vw, 72px);
    --story-rule: color-mix(in srgb, var(--navy) 14%, transparent);
  }

  .story p {
    color: var(--muted);
  }

  .story__intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--story-gap);
    align-items: center;
  }

  .story__lead :global(.section-heading) {
    margin-bottom: 24px;
  }

  /* The first paragraph's subheading, a step below the title. */
  .story__kicker {
    margin-bottom: 0.55em;
    font-size: clamp(1.2rem, 1.8vw, 1.4rem);
    color: var(--ink);
  }

  .story__lead p {
    max-width: 60ch;
  }

  .story__lead p:last-child {
    margin-bottom: 0;
  }

  .story__lead .lead {
    line-height: 1.6;
    color: var(--ink);
  }

  .story__media {
    position: relative;
  }

  .story__media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    padding: 6px;
    border-radius: var(--radius-photo);
    background: var(--g-ring);
    box-shadow: var(--shadow);
  }

  /* The numbers: thick glass over the bottom of the photo. */
  .story__stats {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: -72px 22px 0;
    padding: 8px 10px;
    list-style: none;
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-lg);
    background: var(--glass-thick);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    box-shadow: var(--glass-rim), var(--shadow);
  }

  .stat {
    display: grid;
    align-content: start;
    padding: 14px 16px;
  }

  .stat:nth-child(2n) {
    border-left: 1px solid var(--story-rule);
  }

  .stat:nth-child(n + 3) {
    border-top: 1px solid var(--story-rule);
  }

  /* Each number in its tone, deepening towards --contrast-mix (darker by day, lighter at night). */
  .stat strong {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 600;
    line-height: 1.15;
    white-space: nowrap;
    background: linear-gradient(
      135deg,
      var(--badge-fg) 0%,
      color-mix(in srgb, var(--badge-fg) 72%, var(--contrast-mix)) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat span {
    font-weight: 700;
    font-size: 0.92rem;
    line-height: 1.35;
    color: var(--muted);
  }

  /* The other paragraphs: two columns whose rows line up, so the subheadings make a steady beat. */
  .story__flow {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 4.5vw, 56px) var(--story-gap);
    margin-top: clamp(56px, 7vw, 96px);
  }

  .story__block {
    position: relative;
    padding-top: 22px;
    border-top: 1px solid var(--story-rule);
  }

  .story__block::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: 44px;
    height: 3px;
    border-radius: 3px;
    background: var(--tone);
  }

  .story__block h3 {
    margin-bottom: 0.45em;
    font-size: 1.2rem;
  }

  .story__block p:last-child {
    margin-bottom: 0;
  }

  /* The quote: large words under a soft quote mark. Beside the last paragraph it fills that row;
     when it would start a row of its own it spans both columns, centred. */
  .story__quote {
    align-self: center;
    margin: 0;
    padding: 8px 0 8px 4px;
  }

  .story__quote::before {
    content: '\201C';
    display: block;
    height: 0.52em;
    margin-bottom: 8px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 4.6rem;
    line-height: 1;
    color: color-mix(in srgb, var(--quote-mark) 50%, transparent);
  }

  .story__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--display-weight);
    font-size: clamp(1.35rem, 2.3vw, 1.75rem);
    line-height: 1.32;
    text-wrap: balance;
    background: var(--g-heading);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @media (forced-colors: active) {
    .stat strong,
    .story__quote p {
      color: CanvasText;
    }
  }

  .story__quote cite {
    display: block;
    margin-top: 14px;
    font-style: normal;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--navy);
  }

  .story__quote cite::before {
    content: '';
    display: inline-block;
    width: 28px;
    height: 2px;
    margin-right: 10px;
    border-radius: 2px;
    vertical-align: middle;
    background: var(--g-highlight);
  }

  @media (min-width: 861px) {
    .story__flow > .story__quote:nth-child(odd) {
      grid-column: 1 / -1;
      justify-self: center;
      max-width: 720px;
      padding-top: clamp(8px, 2vw, 24px);
      text-align: center;
    }
  }

  @media (max-width: 960px) {
    .story__stats {
      margin: -56px 14px 0;
    }

    .stat {
      padding: 12px;
    }
  }

  @media (max-width: 860px) {
    .story__intro,
    .story__flow {
      grid-template-columns: minmax(0, 1fr);
      max-width: 680px;
      margin-inline: auto;
    }

    .story__flow > .story__quote {
      justify-self: center;
      max-width: 40ch;
      text-align: center;
    }

    .story__stats {
      margin-top: -52px;
    }
  }

  /* Tablets: a wide photo with the numbers in one row. */
  @media (min-width: 561px) and (max-width: 860px) {
    .story__media :global(img) {
      aspect-ratio: 16 / 9;
    }

    .story__stats {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
    }

    .stat:nth-child(n) {
      border-top: 0;
      border-left: 1px solid var(--story-rule);
    }

    .stat:first-child {
      border-left: 0;
    }
  }

  .approach {
    display: flex;
    gap: 18px;
  }

  .approach .icon-badge {
    flex: none;
    margin: 0;
  }

  .moments {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 860px) {
    .moments {
      grid-template-columns: repeat(2, 1fr);
    }
    .moments li:first-child {
      grid-column: 1 / -1;
    }
  }

  .moments :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }

  @media (max-width: 860px) {
    .moments li:first-child :global(img) {
      aspect-ratio: 16 / 10;
    }
  }

  .founder {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .founder__avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--g-navy);
    color: var(--sun);
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
  }

  .founder p {
    margin: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cta h2 {
    margin-bottom: 0.2em;
  }

  .cta .lead {
    margin: 0;
  }
</style>
