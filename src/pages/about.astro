---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import AboutStory from '../components/AboutStory.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { site, coreValues } from '../data/site';
import { approach } from '../data/programs';
import { hasImage, image } from '../data/content';
import { blocksOf } from '../data/about';
import { initials } from '../data/founders';

// "Life at Crossmaze" (admin: Site settings → Life at Crossmaze photos): framed tiles of one shape, the shape
// most of the photos were taken in, between 4:3 and 3:2, so most are shown whole. A portrait photo is
// cropped near its top, where the faces usually are.
const moments = site.moments.map((m) => {
  const src = image(m.image);
  return { src, alt: m.alt, shape: src.width / src.height };
});
const shapes = moments.map((m) => m.shape).sort((a, b) => a - b);
const middleShape = shapes.length ? shapes[Math.floor((shapes.length - 1) / 2)]! : 3 / 2;
const momentRatio = Math.min(Math.max(middleShape, 4 / 3), 3 / 2).toFixed(4);
// Tile widths: three in a row from 880px (a full container's third at most), two below.
const momentSizes = '(max-width: 879px) calc(50vw - 26px), (max-width: 1219px) calc(33vw - 26px), 380px';
const tones = ['navy', 'green', 'coral', 'sky', 'sun', 'navy'];

// "Our founders" (admin: Site settings → About page), only while "Show the founders on the About page" is on
// (site.founders is empty until then). A glass card each: the portrait in a round photo frame, or their
// initials, the name, the role if one is given, and a few lines about them. One founder has a card of their
// own, centred; two sit side by side, four two by two, and three (or more) three in a row on wide screens.
// The cards' class names (.people, .person) don't say "founder": the page's styles are in its HTML even while
// the section is left out, and nothing there should name the founders.
const founders = site.founders.map((f) => {
  const photo = hasImage(f.photo) ? image(f.photo) : undefined;
  return { ...f, photo, portrait: photo ? photo.width < photo.height : false, about: blocksOf(f.about) };
});
---

<BaseLayout
  title="About Us"
  description="About Crossmaze Preschool and Day Care, Bengaluru: an interactive, Montessori-based preschool where every child is special. Our story, core values and approach."
>
  <PageHero
    eyebrow="About Crossmaze"
    title="An interactive place where every child can excel"
    lead={site.promise}
    crumbs={[{ label: 'About' }]}
  />

  <section class="section section--white">
    <AboutStory />
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Our core values"
        title="More than guiding principles"
        lead="Our core values are more than guiding principles. They are the foundation of our commitment to excellent early education, and they shape our classrooms, our daily routines and how we work with children, parents and the community."
        align="center"
      />
      <div class="grid grid--3">
        {
          coreValues.map((v, i) => (
            <div class:list={['card', `tone-${tones[i % tones.length]}`]}>
              <span class="icon-badge">
                <Icon name={v.icon} size={26} />
              </span>
              <h3>{v.title}</h3>
              <p class="muted">{v.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <SectionHeading
        eyebrow="Our approach"
        title="How children learn at Crossmaze"
        lead="Our Foundational Development Program uses a Montessori-based, thematic approach to build the skills children need for school and for life."
      />
      <div class="grid grid--2 approach-grid">
        {
          approach.map((a) => (
            <div class="approach">
              <span class="icon-badge">
                <Icon name={a.icon} size={26} />
              </span>
              <div>
                <h3>{a.title}</h3>
                <p class="muted">{a.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    moments.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHeading eyebrow="Life at Crossmaze" title="Moments that build confidence" align="center" />
          <ul class="moments grid grid--3" style={`--ratio: ${momentRatio}`}>
            {
              moments.map((m) => (
                <li class="ratio-frame photo-frame photo-frame--sm" style={m.shape < 1 ? '--photo-focus: 50% 25%' : undefined}>
                  <Image src={m.src} alt={m.alt} widths={[360, 540, 720, 960]} sizes={momentSizes} />
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )
  }

  {
    founders.length > 0 && (
      <section class="section section--white" aria-labelledby="founders-title">
        <div class="container">
          <SectionHeading eyebrow="Leadership" title={founders.length === 1 ? 'Our founder' : 'Our founders'} align="center" id="founders-title" />
          <ul class:list={['people', founders.length === 1 ? 'people--one' : ['grid', founders.length === 3 || founders.length > 4 ? 'grid--3' : 'grid--2']]}>
            {
              founders.map((f) => (
                <li class="card person">
                  <div class="person__top">
                    {f.photo ? (
                      <span class="person__photo ratio-frame photo-frame photo-frame--sm" style={f.portrait ? '--photo-focus: 50% 25%' : undefined}>
                        <Image src={f.photo} alt={f.photoAlt || f.name} widths={[96, 192, 288]} sizes="96px" />
                      </span>
                    ) : (
                      <span class="person__photo photo-frame photo-frame--sm" aria-hidden="true">
                        <span class="person__initials">{initials(f.name)}</span>
                      </span>
                    )}
                    <div class="person__who">
                      <h3>{f.name}</h3>
                      {f.role && <p class="person__role">{f.role}</p>}
                    </div>
                  </div>
                  {f.about.map((p) => (
                    <p class="person__about">{p}</p>
                  ))}
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )
  }

  <section class="section--tight section--feature">
    <div class="container cta">
      <div>
        <h2>See Crossmaze for yourself</h2>
        <p class="lead">Visit your nearest centre and meet our team.</p>
      </div>
      <div class="btn-row">
        <a class="btn btn--sun" href="/contact#enquire">Book a visit</a>
        <a class="btn btn--ghost" href="/branch">Find a branch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Two in a row from a 720px grid, where each still has room for its icon beside the text. */
  .approach-grid {
    --grid-two-at: 720px;
  }

  .approach {
    display: flex;
    gap: 18px;
  }

  .approach .icon-badge {
    flex: none;
    margin: 0;
  }

  /* The photos as a .grid--3: 5 photos show 3 + 2 (4: four in a row), and two in a row on tablets and
     phones too (2 + 2 + 1, the last one centred). --ratio (on the list) is the tiles' shape. */
  .moments {
    --grid-gap: clamp(12px, 1.6vw, 20px);
    --grid-two-at: 0px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .people {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .people--one {
    max-width: 600px;
    margin-inline: auto;
  }

  /* Three founders (or five or more): three in a row only on a 1100px grid, where each card has room for
     a few lines about them; two and one centred below that, and one a row under 640px. */
  .people.grid--3 {
    --grid-cols-at: 1100px;
    --grid-two-at: 640px;
  }

  .person {
    --portrait: clamp(76px, 8vw, 96px);
    container-type: inline-size;
    padding: clamp(22px, 2.6vw, 30px);
    overflow-wrap: break-word;
  }

  /* The portrait beside the name and role: centred on them while they are shorter than it, level with
     the name's first line when they are longer. */
  .person__top {
    display: flex;
    align-items: flex-start;
    gap: clamp(14px, 1.8vw, 20px);
  }

  .person__who {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    min-height: var(--portrait);
  }

  /* A narrower card (three in a row, or two on a small tablet) puts the portrait above the name, so the
     name and role have the card's full width and keep each word whole. */
  @container (width < 340px) {
    .person__top {
      flex-direction: column;
    }

    .person__who {
      min-height: 0;
    }
  }

  .person__top:not(:last-child) {
    margin-bottom: 18px;
  }

  /* The portrait in the site's photo frame, made round; the initials sit in the same ring. */
  .person__photo {
    --ratio: 1;
    --frame-radius: 50%;
    display: grid;
    flex: none;
    width: var(--portrait);
    aspect-ratio: 1;
  }

  .person__initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--g-navy);
    color: var(--sun);
    font-family: var(--font-display);
    font-size: calc(var(--portrait) * 0.32);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .person h3 {
    margin: 0;
    font-size: clamp(1.2rem, 1.8vw, 1.4rem);
  }

  .person__role {
    margin: 0.25em 0 0;
    color: var(--muted);
    font-weight: 600;
  }

  .person__about {
    margin: 0 0 0.8em;
    color: var(--muted);
  }

  .person__about:last-child {
    margin-bottom: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cta h2 {
    margin-bottom: 0.2em;
  }

  .cta .lead {
    margin: 0;
  }
</style>
