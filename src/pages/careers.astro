---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CareerForm from '../components/CareerForm.astro';
import Icon from '../components/Icon.astro';
import { jobs, perks } from '../data/jobs';
import { site } from '../data/site';
---

<BaseLayout
  title="Careers"
  description="Careers at Crossmaze Preschool and Day Care, Bengaluru: openings for Teacher / Facilitator, Day Care In-Charge and Center Head. An ideal workplace for women."
>
  <PageHero
    eyebrow="Careers"
    title="Join us"
    lead="Crossmaze is an ideal workplace for women, with equal opportunities, support for career advancement, flexible work arrangements and a culture of respect and inclusivity. Join a community where your talents are recognised and your voice is heard."
    crumbs={[{ label: 'Careers' }]}
  >
    <div class="btn-row hero-actions">
      <a class="btn btn--sun" href="#openings">See open positions</a>
      <a class="btn btn--ghost" href="#apply">Apply now</a>
    </div>
  </PageHero>

  <section class="section section--white">
    <div class="container">
      <SectionHeading eyebrow="Why work with us" title="A workplace that cares about you, too" />
      <div class="grid grid--4">
        {
          perks.map((p, i) => (
            <div class:list={['card', `tone-${['coral', 'navy', 'green', 'sun'][i % 4]}`]}>
              <span class="icon-badge">
                <Icon name={p.icon} size={26} />
              </span>
              <h3>{p.title}</h3>
              <p class="muted">{p.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="openings">
    <div class="container jobs">
      <SectionHeading
        eyebrow="Open positions"
        title="Current openings"
        lead={`${jobs.length} roles across our branches in Electronic City and Begur.`}
      />
      <div class="jobs__list">
        {
          jobs.map((job, i) => (
            <details class="job" id={job.slug} open={i === 0}>
              <summary>
                <span class="job__title">
                  <span class="icon-badge">
                    <Icon name="Briefcase" size={22} />
                  </span>
                  <span>
                    <strong>{job.title}</strong>
                    <span class="muted">{job.timings.join(' · ')}</span>
                  </span>
                </span>
                <Icon name="ChevronDown" size={22} class="job__chev" />
              </summary>
              <div class="job__body">
                <p class="lead">{job.overview}</p>
                <dl class="job__facts">
                  <div>
                    <dt><Icon name="GraduationCap" size={18} /> Qualification</dt>
                    <dd>{job.qualification}</dd>
                  </div>
                  <div>
                    <dt><Icon name="Award" size={18} /> Experience</dt>
                    <dd>{job.experience}</dd>
                  </div>
                  <div>
                    <dt><Icon name="Clock" size={18} /> Work timings</dt>
                    <dd>{job.timings.join(' · ')}</dd>
                  </div>
                  {job.ageLimit && (
                    <div>
                      <dt><Icon name="UserRound" size={18} /> Age limit</dt>
                      <dd>{job.ageLimit}</dd>
                    </div>
                  )}
                </dl>
                <h3>Primary responsibilities</h3>
                <ul class="check-list job__list">
                  {job.responsibilities.map((r) => (
                    <li>
                      <Icon name="Check" size={20} />
                      <span>
                        {r.title && <strong>{r.title}: </strong>}
                        {r.text}
                      </span>
                    </li>
                  ))}
                </ul>
                {job.extra && (
                  <p class="job__extra">
                    <strong>{job.extra.title}:</strong> {job.extra.text}
                  </p>
                )}
                <a class="btn" href={`?position=${encodeURIComponent(job.title)}#apply`} data-apply={job.title}>
                  Apply for this role
                </a>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--white" id="apply">
    <div class="container apply">
      <div>
        <span class="eyebrow">Apply</span>
        <h2>Send us your application</h2>
        <p class="lead">
          Fill in the form and our team will be in touch. Don’t see the right role? Apply anyway and choose “Other”. We’re
          always happy to meet great people.
        </p>
        <p>
          <Icon name="Mail" size={18} class="inline-icon" />
          <a href={`mailto:${site.careersEmail}`}>{site.careersEmail}</a>
        </p>
      </div>
      <div class="card apply__form">
        <CareerForm />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Clicking "Apply for this role" pre-selects the position without reloading the page.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-apply]')) {
    link.addEventListener('click', (event) => {
      const select = document.querySelector<HTMLSelectElement>('#job-role');
      if (!select) return;
      event.preventDefault();
      select.value = link.dataset.apply ?? '';
      document.querySelector('#apply')?.scrollIntoView();
      document.querySelector<HTMLInputElement>('#job-name')?.focus({ preventScroll: true });
    });
  }
</script>

<style>
  .hero-actions {
    margin-top: 28px;
  }

  .jobs {
    max-width: 960px;
  }

  .jobs__list {
    display: grid;
    gap: 16px;
  }

  .job {
    background: var(--g-card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  .job summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
  }

  .job summary::-webkit-details-marker {
    display: none;
  }

  .job__title {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .job__title .icon-badge {
    margin: 0;
    flex: none;
  }

  .job__title > span:last-child {
    display: grid;
    line-height: 1.3;
  }

  .job__title strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.3rem;
  }

  .job summary :global(.job__chev) {
    flex: none;
    transition: transform 0.2s ease;
  }

  .job[open] summary :global(.job__chev) {
    transform: rotate(180deg);
  }

  .job__body {
    padding: 0 24px 28px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }

  .job__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 16px 28px;
    margin: 0 0 28px;
    padding: 20px;
    border-radius: var(--radius);
    background: var(--g-soft);
  }

  .job__facts dt {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
  }

  .job__facts dt :global(svg) {
    color: var(--coral);
  }

  .job__facts dd {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.97rem;
  }

  .job__body h3 {
    font-size: 1.1rem;
    margin-bottom: 14px;
  }

  .job__list {
    margin-bottom: 24px;
  }

  .job__extra {
    color: var(--muted);
  }

  .apply {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }

  @media (max-width: 860px) {
    .apply {
      grid-template-columns: 1fr;
    }
  }

  .apply p :global(.inline-icon) {
    display: inline;
    vertical-align: -3px;
    margin-right: 6px;
    color: var(--coral);
  }

  .apply__form {
    background: var(--g-soft);
  }
</style>
