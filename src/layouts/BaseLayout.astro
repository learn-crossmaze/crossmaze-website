---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import '../styles/themes.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallPicker from '../components/CallPicker.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { branches, shortName } from '../data/branches';
import { image } from '../data/content';
import { cleanPath } from '../utils';
import { doodleCss } from '../components/doodles';
import { themes, themeSettings, fontsHref } from '../data/themes';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The picture shown when the page is shared (default: the site's own). */
  image?: ImageMetadata;
  /** "article" for blog posts. */
  type?: 'website' | 'article';
  /** Keeps the page out of search results (blog draft previews). */
  noindex?: boolean;
}

const { title, description = site.description, jsonLd, image: shareImage, type = 'website', noindex = false } = Astro.props;

// Which centre each phone number on the site belongs to (last 10 digits), so the call log
// (scripts/call-log.ts) can say which centre a visitor tried to call.
const last10 = (phone: string) => phone.replace(/\D/g, '').slice(-10);
const callNumbers = Object.fromEntries([
  [last10(site.phone), 'Main number'],
  ...(site.whatsapp ? [[last10(site.whatsapp), 'Main number']] : []),
  ...branches.filter((b) => b.phone).map((b) => [last10(b.phone), shortName(b)]),
]);
const pageTitle = title ? `${title} | ${site.fullName}` : `${site.fullName} | Bengaluru`;
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site ?? site.url).href;
const ogImage = shareImage
  ? new URL((await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site ?? site.url).href
  : new URL('/og-image.jpg', Astro.site ?? site.url).href;
// Google's copy of the logo follows the one set in the admin panel.
const schemaLogo = await getImage({ src: image(site.logo), width: 600, format: 'png' });

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Preschool',
  name: site.fullName,
  legalName: site.legalName,
  url: site.url,
  telephone: site.phone,
  email: site.admissionsEmail,
  logo: new URL(schemaLogo.src, site.url).href,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.slice(0, 2).join(', '),
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    postalCode: '560068',
    addressCountry: 'IN',
  },
  founder: site.founders.map((name) => ({ '@type': 'Person', name })),
  sameAs: site.social.map((s) => s.href),
};
const structuredData = [organization, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

// Which colour theme to show (admin panel: Site settings → Look and feel). The browser picks it
// before the page is drawn, by the script in <head> below.
const themeConfig = {
  ...themeSettings(site.theme),
  all: themes.map((t) => ({ id: t.id, fonts: fontsHref(t.fonts), color: t.color, dark: t.dark })),
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b1d5e" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline define:vars={{ themeConfig }}>
      (function () {
        var c = themeConfig;
        var byId = {};
        c.all.forEach(function (t) {
          byId[t.id] = t;
        });
        var storage = function (name) {
          try {
            return window[name];
          } catch (e) {
            return null;
          }
        };
        var session = storage('sessionStorage');
        var local = storage('localStorage');
        var get = function (store, key) {
          try {
            return store ? store.getItem(key) : null;
          } catch (e) {
            return null;
          }
        };
        var put = function (store, key, value) {
          try {
            if (store) store.setItem(key, value);
          } catch (e) {
            // Private browsing: the theme just isn't remembered.
          }
        };
        var list = c.rotation;

        // ?theme=meadow previews a theme for the rest of the visit; ?theme=auto returns to the setting.
        var asked = new URLSearchParams(location.search).get('theme');
        if (asked === 'auto') put(session, 'cm-theme-preview', '');
        else if (byId[asked]) put(session, 'cm-theme-preview', asked);

        // The address wins even when storage is blocked; storage only carries it to later pages.
        var theme = byId[asked] ? asked : asked === 'auto' ? null : get(session, 'cm-theme-preview');
        if (!byId[theme]) {
          var now = new Date();
          var day = Math.floor((now.getTime() - now.getTimezoneOffset() * 60000) / 86400000);
          if (c.mode === 'weekday') {
            theme = c.weekdays[['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'][now.getDay()]];
          } else if (c.mode === 'daily') {
            theme = list[day % list.length];
          } else if (c.mode === 'visit' || c.mode === 'returning') {
            // One theme per visit (browser session), so it doesn't change from page to page.
            theme = get(session, 'cm-theme');
            if (list.indexOf(theme) < 0) {
              var last = get(local, 'cm-theme-last');
              if (c.mode === 'returning' && list.indexOf(last) >= 0) {
                theme = last;
              } else {
                var pool = list.length > 1 ? list.filter(function (t) { return t !== last; }) : list;
                theme = pool[Math.floor(Math.random() * pool.length)];
              }
              put(session, 'cm-theme', theme);
              put(local, 'cm-theme-last', theme);
            }
          } else {
            theme = c.fixed;
          }
        }
        if (!byId[theme]) theme = c.fixed;

        document.documentElement.dataset.theme = theme;
        var fonts = document.createElement('link');
        fonts.rel = 'stylesheet';
        fonts.href = byId[theme].fonts;
        document.head.appendChild(fonts);
        // Light or dark (Site settings → Look and feel → Dark mode). A visitor's own choice with the
        // sun/moon button (Header.astro) wins; otherwise "device" follows their phone or computer.
        // ?mode=dark or ?mode=light previews a mode for the visit, even when dark mode is off.
        var askedMode = new URLSearchParams(location.search).get('mode');
        if (askedMode === 'auto') put(session, 'cm-mode-preview', '');
        else if (askedMode === 'dark' || askedMode === 'light') put(session, 'cm-mode-preview', askedMode);
        var isMode = function (m) {
          return m === 'dark' || m === 'light';
        };
        var device = window.matchMedia ? matchMedia('(prefers-color-scheme: dark)') : null;
        // A preview, then the visitor's own choice, then (for "device") their phone or computer.
        var decide = function () {
          var preview = get(session, 'cm-mode-preview');
          if (isMode(preview)) return preview;
          if (c.dark === 'off') return 'light';
          var chosen = get(local, 'cm-mode');
          if (isMode(chosen)) return chosen;
          return c.dark === 'device' && device && device.matches ? 'dark' : 'light';
        };
        var meta = document.querySelector('meta[name="theme-color"]');
        var setMode = function (m) {
          document.documentElement.dataset.mode = m;
          if (meta) meta.setAttribute('content', m === 'dark' ? byId[theme].dark : byId[theme].color);
        };
        setMode(isMode(askedMode) ? askedMode : decide());
        window.cmMode = { set: setMode, decide: decide, followsDevice: c.dark === 'device', device: device };
        // Print in light colours: the night palette would come out as pale text on white paper.
        var printedDark = false;
        window.addEventListener('beforeprint', function () {
          printedDark = document.documentElement.dataset.mode === 'dark';
          if (printedDark) setMode('light');
        });
        window.addEventListener('afterprint', function () {
          if (printedDark) setMode('dark');
        });
      })();
    </script>
    <noscript><link rel="stylesheet" href={fontsHref(themes[0].fonts)} /></noscript>

    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <style is:inline set:html={doodleCss}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CallPicker />

    <a class="whatsapp-fab" href={site.whatsappHref} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
      <Icon name="MessageCircle" size={26} />
    </a>

    <script type="application/json" id="cm-call-numbers" set:html={JSON.stringify(callNumbers)} />
    <script>
      import '../scripts/motion';
      import '../scripts/call-log';
    </script>

    <style>
      .whatsapp-fab {
        position: fixed;
        right: max(16px, env(safe-area-inset-right));
        bottom: max(16px, env(safe-area-inset-bottom));
        z-index: 40;
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: var(--g-whatsapp);
        color: #fff;
        box-shadow: 0 8px 24px rgb(37 211 102 / 40%);
        transition: transform 0.15s ease;
      }
      .whatsapp-fab:hover {
        color: #fff;
        transform: scale(1.06);
      }
    </style>
  </body>
</html>
