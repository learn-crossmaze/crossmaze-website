---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import '../styles/themes.css';
import '../styles/seasons.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallPicker from '../components/CallPicker.astro';
import Greetings from '../components/Greetings.astro';
import Icon from '../components/Icon.astro';
import { site, orgId } from '../data/site';
import { branches, branchId, branchUrl, shortName, whatsappNumber } from '../data/branches';
import { hasImage, image } from '../data/content';
import { cleanPath, jsonScript } from '../utils';
import { doodleCss } from '../components/doodles';
import { themes, themeSettings, fontsHref } from '../data/themes';
import { seasonWindows } from '../data/seasons';

interface Props {
  /** The page's name; the browser tab and Google show "<title> | Crossmaze". */
  title?: string;
  /** The whole title instead, for pages whose title names what they offer and where. */
  fullTitle?: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The picture shown when the page is shared (default: the site's own). */
  image?: ImageMetadata;
  /** "article" for blog posts. */
  type?: 'website' | 'article';
  /** Keeps the page out of search results (blog draft previews). */
  noindex?: boolean;
  /** A branch page's own WhatsApp chat: its WhatsApp button opens it straight away instead of the list of centres. */
  whatsappHref?: string;
  /** That branch's short name, which the call log records for a tap on the button. */
  whatsappBranch?: string;
  /** A branch page's own phone link: the phone action bar's Call button rings that centre straight away. */
  callHref?: string;
  /** Where the phone action bar's "Book a visit" goes: the page's own enquiry form when it has one. */
  visitHref?: string;
}

const {
  title,
  fullTitle,
  description = site.description,
  jsonLd,
  image: shareImage,
  type = 'website',
  noindex = false,
  whatsappHref,
  whatsappBranch,
  callHref,
  visitHref = '/contact#enquire',
} = Astro.props;

// Which centre each phone number on the site belongs to (last 10 digits), so the call log
// (scripts/call-log.ts) can say which centre a visitor tried to call. Later entries win, so a centre's phone
// and the main number keep their own names when a WhatsApp number is the same; the lists of centres and the
// branch page's WhatsApp button name their centre on the link (data-branch) anyway.
const last10 = (phone: string) => phone.replace(/\D/g, '').slice(-10);
const callNumbers = Object.fromEntries([
  ...branches.filter((b) => whatsappNumber(b)).map((b) => [last10(whatsappNumber(b)), shortName(b)]),
  [last10(site.phone), 'Main number'],
  ...branches.filter((b) => b.phone).map((b) => [last10(b.phone), shortName(b)]),
]);
// The short name as the suffix, so the words that say what the page is about have the room.
const pageTitle = fullTitle?.trim() || (title ? `${title} | ${site.name}` : site.fullName);
const canonical = new URL(cleanPath(Astro.url.pathname), Astro.site ?? site.url).href;
const ogImage = shareImage
  ? new URL((await getImage({ src: shareImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src, Astro.site ?? site.url).href
  : new URL('/og-image.jpg', Astro.site ?? site.url).href;
// Google's copy of the logo follows the one set in the admin panel. Google wants it at least 112 px tall: a
// wordmark 1200 px wide is about 150 px tall (never enlarged past the upload).
const logo = image(site.logo);
const schemaLogo = await getImage({ src: logo, width: Math.min(logo.width, 1200), format: 'png' });
// The founders, only while the admin panel shows them (site.founders is empty until then).
const founders = await Promise.all(
  site.founders.map(async (f) => ({
    '@type': 'Person',
    name: f.name,
    ...(f.role ? { jobTitle: f.role } : {}),
    ...(hasImage(f.photo) ? { image: new URL((await getImage({ src: image(f.photo), width: 400, format: 'jpg' })).src, site.url).href } : {}),
  })),
);

// The main address from Site settings, without the line that is the school's name and without the city
// and state (addressLocality and addressRegion carry them): "Kusumkunj, Site No 3/4 …, Thirupalya, Neotown".
const streetAddress = site.address
  .map((line) => line.trim())
  .filter((line) => line && !line.startsWith(site.name))
  .join(', ')
  .replace(/,?\s*\b(Bengaluru|Bangalore)\b.*$/i, '');
// The school. Each centre's page describes the centre in full under its own id (branch/[slug].astro), and
// the website (index.astro) and blog posts point here by @id.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Preschool',
  '@id': orgId,
  name: site.fullName,
  alternateName: site.name,
  legalName: site.legalName,
  description: site.description,
  url: site.url,
  telephone: site.phone,
  email: site.admissionsEmail,
  logo: new URL(schemaLogo.src, site.url).href,
  image: new URL('/og-image.jpg', site.url).href,
  subOrganization: branches.map((b) => ({ '@type': 'Preschool', '@id': branchId(b), name: b.name, url: branchUrl(b) })),
  address: {
    '@type': 'PostalAddress',
    streetAddress,
    addressLocality: 'Bengaluru',
    addressRegion: 'Karnataka',
    ...(site.addressPincode ? { postalCode: site.addressPincode } : {}),
    addressCountry: 'IN',
  },
  ...(founders.length ? { founder: founders } : {}),
  sameAs: site.social.map((s) => s.href),
};
const structuredData = [organization, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];

// Which colour theme to show (admin panel: Site settings → Look and feel). The browser picks it
// before the page is drawn, by the script in <head> below.
const themeSettingsNow = themeSettings(site.theme);
const themeConfig = {
  ...themeSettingsNow,
  all: themes.map((t) => ({ id: t.id, fonts: fontsHref(t.fonts), color: t.color, dark: t.dark })),
  // Festival seasons by India's date (src/data/seasons.ts), when festive touches are on.
  seasonList: themeSettingsNow.seasons ? seasonWindows() : [],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b1d5e" />
    <!-- Ownership checks carried over from the old Wix site, so Google Search Console, Bing Webmaster
         Tools and Facebook keep crossmaze.in verified after the move (README, "Point the domain"). -->
    <meta name="google-site-verification" content="shOo5K-NNlQUoMGB8ooNIUNwAGMrjaCVGU5fU5U4iRo" />
    <meta name="msvalidate.01" content="FC1A8D83E964BBC9B5D5B98C6D786F57" />
    <meta name="facebook-domain-verification" content="7tzapfcuo5w4jk6jizkxk4gfah6fav" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline define:vars={{ themeConfig }}>
      (function () {
        var c = themeConfig;
        var byId = {};
        c.all.forEach(function (t) {
          byId[t.id] = t;
        });
        var storage = function (name) {
          try {
            return window[name];
          } catch (e) {
            return null;
          }
        };
        var session = storage('sessionStorage');
        var local = storage('localStorage');
        var get = function (store, key) {
          try {
            return store ? store.getItem(key) : null;
          } catch (e) {
            return null;
          }
        };
        var put = function (store, key, value) {
          try {
            if (store) store.setItem(key, value);
          } catch (e) {
            // Private browsing: the theme just isn't remembered.
          }
        };
        var list = c.rotation;

        // ?theme=meadow previews a theme for the rest of the visit; ?theme=auto returns to the setting.
        var asked = new URLSearchParams(location.search).get('theme');
        if (asked === 'auto') put(session, 'cm-theme-preview', '');
        else if (byId[asked]) put(session, 'cm-theme-preview', asked);

        // The address wins even when storage is blocked; storage only carries it to later pages.
        var theme = byId[asked] ? asked : asked === 'auto' ? null : get(session, 'cm-theme-preview');
        if (!byId[theme]) {
          var now = new Date();
          var day = Math.floor((now.getTime() - now.getTimezoneOffset() * 60000) / 86400000);
          if (c.mode === 'weekday') {
            theme = c.weekdays[['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'][now.getDay()]];
          } else if (c.mode === 'daily') {
            theme = list[day % list.length];
          } else if (c.mode === 'visit' || c.mode === 'returning') {
            // One theme per visit (browser session), so it doesn't change from page to page.
            theme = get(session, 'cm-theme');
            if (list.indexOf(theme) < 0) {
              var last = get(local, 'cm-theme-last');
              if (c.mode === 'returning' && list.indexOf(last) >= 0) {
                theme = last;
              } else {
                var pool = list.length > 1 ? list.filter(function (t) { return t !== last; }) : list;
                theme = pool[Math.floor(Math.random() * pool.length)];
              }
              put(session, 'cm-theme', theme);
              put(local, 'cm-theme-last', theme);
            }
          } else {
            theme = c.fixed;
          }
        }
        if (!byId[theme]) theme = c.fixed;

        document.documentElement.dataset.theme = theme;
        var fonts = document.createElement('link');
        fonts.rel = 'stylesheet';
        fonts.href = byId[theme].fonts;
        document.head.appendChild(fonts);
        // Light or dark (Site settings → Look and feel → Dark mode). A visitor's own choice with the
        // sun/moon button (Header.astro) wins; otherwise "device" follows their phone or computer.
        // ?mode=dark or ?mode=light previews a mode for the visit, even when dark mode is off.
        var askedMode = new URLSearchParams(location.search).get('mode');
        if (askedMode === 'auto') put(session, 'cm-mode-preview', '');
        else if (askedMode === 'dark' || askedMode === 'light') put(session, 'cm-mode-preview', askedMode);
        var isMode = function (m) {
          return m === 'dark' || m === 'light';
        };
        var device = window.matchMedia ? matchMedia('(prefers-color-scheme: dark)') : null;
        // What the setting gives on its own: the phone or computer's choice ("device"), or dark from
        // 7 pm to 6 am by the visitor's clock ("time").
        var auto = function () {
          if (c.dark === 'time') {
            var h = new Date().getHours();
            return h >= 19 || h < 6 ? 'dark' : 'light';
          }
          return c.dark === 'device' && device && device.matches ? 'dark' : 'light';
        };
        // A preview, then the visitor's own choice, then the setting.
        var decide = function () {
          var preview = get(session, 'cm-mode-preview');
          if (isMode(preview)) return preview;
          if (c.dark === 'off') return 'light';
          var chosen = get(local, 'cm-mode');
          if (isMode(chosen)) return chosen;
          return auto();
        };
        var meta = document.querySelector('meta[name="theme-color"]');
        var setMode = function (m) {
          document.documentElement.dataset.mode = m;
          if (meta) meta.setAttribute('content', m === 'dark' ? byId[theme].dark : byId[theme].color);
        };
        setMode(isMode(askedMode) ? askedMode : decide());
        window.cmMode = { set: setMode, decide: decide, auto: auto, followsTime: c.dark === 'time', device: c.dark === 'device' ? device : null };

        // The light of the time of day (Look and feel → Light that follows the time of day), by the
        // visitor's clock; ?daypart=morning|afternoon|evening previews one.
        var parts = ['morning', 'afternoon', 'evening'];
        var askedPart = new URLSearchParams(location.search).get('daypart');
        var daypart = function () {
          var h = new Date().getHours();
          return h >= 5 && h < 11 ? 'morning' : h >= 11 && h < 16 ? 'afternoon' : h >= 16 && h < 19 ? 'evening' : 'night';
        };
        if (parts.indexOf(askedPart) >= 0) document.documentElement.dataset.daypart = askedPart;
        else if (c.daylight) document.documentElement.dataset.daypart = daypart();

        // Festive touches (styles/seasons.css) around festivals, by India's date; ?season=diwali previews one.
        var seasonIds = ['diwali', 'holi', 'winter', 'tricolour'];
        var askedSeason = new URLSearchParams(location.search).get('season');
        var season = seasonIds.indexOf(askedSeason) >= 0 ? askedSeason : '';
        if (!season) {
          var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
          c.seasonList.forEach(function (w) {
            if (!season && today >= w[1] && today <= w[2]) season = w[0];
          });
        }
        if (season) document.documentElement.dataset.season = season;
        // Print in light colours: the night palette would come out as pale text on white paper.
        var printedDark = false;
        window.addEventListener('beforeprint', function () {
          printedDark = document.documentElement.dataset.mode === 'dark';
          if (printedDark) setMode('light');
        });
        window.addEventListener('afterprint', function () {
          if (printedDark) setMode('dark');
        });
      })();
    </script>
    <noscript><link rel="stylesheet" href={fontsHref(themes[0].fonts)} /></noscript>

    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonScript(data)} />)}
    <style is:inline set:html={doodleCss}></style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <div class="season-garland" aria-hidden="true"></div>
    <main id="main">
      {site.greetings?.enabled !== false && <Greetings />}
      <slot />
    </main>
    <Footer />
    <CallPicker />
    <CallPicker channel="whatsapp" />

    {/* On a branch page, a chat with that centre; elsewhere the list of centres (CallPicker.astro). */}
    {
      whatsappHref ? (
        <a class="whatsapp-fab" href={whatsappHref} target="_blank" rel="noopener" data-branch={whatsappBranch} aria-label="Chat with this centre on WhatsApp">
          <Icon name="MessageCircle" size={26} />
        </a>
      ) : (
        <a class="whatsapp-fab" href="/branch" data-whatsapp-picker aria-label="Chat with your nearest centre on WhatsApp">
          <Icon name="MessageCircle" size={26} />
        </a>
      )
    }

    {/* Phones: Call, WhatsApp and Book a visit always within reach at the bottom of the screen (it takes the
        WhatsApp button's place). On a branch page Call and WhatsApp reach that centre; elsewhere they open the
        list of centres. It moves out of the way while the enquiry form is on screen, while typing and while
        the menu is open (scripts/action-bar.ts). */}
    <nav class="action-bar" aria-label="Call, WhatsApp or book a visit" data-action-bar>
      {
        callHref ? (
          <a class="action-bar__item" href={callHref}>
            <Icon name="Phone" size={20} />
            <span>Call</span>
          </a>
        ) : (
          <a class="action-bar__item" href={site.phoneHref} data-call-picker>
            <Icon name="Phone" size={20} />
            <span>Call</span>
          </a>
        )
      }
      {
        whatsappHref ? (
          <a class="action-bar__item action-bar__item--whatsapp" href={whatsappHref} target="_blank" rel="noopener" data-branch={whatsappBranch}>
            <Icon name="MessageCircle" size={20} />
            <span>WhatsApp</span>
          </a>
        ) : (
          <a class="action-bar__item action-bar__item--whatsapp" href="/branch" data-whatsapp-picker>
            <Icon name="MessageCircle" size={20} />
            <span>WhatsApp</span>
          </a>
        )
      }
      <a class="action-bar__item action-bar__item--visit" href={visitHref}>
        <Icon name="CalendarCheck" size={20} />
        <span>Book a visit</span>
      </a>
    </nav>

    <script type="application/json" id="cm-call-numbers" set:html={jsonScript(callNumbers)} />
    <script>
      import '../scripts/motion';
      import '../scripts/call-log';
      import '../scripts/action-bar';
      import '../scripts/admissions';
    </script>

    <style>
      .whatsapp-fab {
        position: fixed;
        right: max(16px, env(safe-area-inset-right));
        bottom: max(16px, env(safe-area-inset-bottom));
        z-index: 40;
        display: grid;
        place-items: center;
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: var(--g-whatsapp);
        color: #fff;
        box-shadow: 0 8px 24px rgb(37 211 102 / 40%);
        transition: transform 0.15s ease;
      }
      .whatsapp-fab:hover {
        color: #fff;
        transform: scale(1.06);
      }

      /* ---------- Phones: the action bar at the bottom of the screen (floating glass, like the menu bar) */
      .action-bar {
        display: none;
      }

      @media (max-width: 760px) {
        .whatsapp-fab {
          display: none;
        }

        /* Room under the footer, so the bar never covers its last lines. */
        :global(body) {
          padding-bottom: calc(84px + env(safe-area-inset-bottom));
        }

        .action-bar {
          position: fixed;
          left: max(10px, env(safe-area-inset-left));
          right: max(10px, env(safe-area-inset-right));
          bottom: max(10px, env(safe-area-inset-bottom));
          z-index: 40;
          display: grid;
          grid-template-columns: 0.85fr 1.15fr 1.45fr;
          gap: 6px;
          padding: 6px;
          border: 1px solid var(--glass-edge);
          border-radius: 22px;
          background: var(--glass-thick);
          -webkit-backdrop-filter: var(--glass-blur);
          backdrop-filter: var(--glass-blur);
          box-shadow: var(--glass-rim), var(--shadow);
          transition:
            transform 0.25s ease,
            opacity 0.25s ease,
            visibility 0.25s;
        }

        /* Out of the way while the form is on screen, while typing (the keyboard is open) and while the menu
           is open. Hidden this way it can't be tapped or reached with the keyboard either. */
        .action-bar[data-hidden],
        :global(body:has(.site-header.is-open)) .action-bar,
        :global(body:has(:is(input, textarea, select):focus)) .action-bar {
          transform: translateY(calc(100% + 24px));
          opacity: 0;
          visibility: hidden;
        }

        .action-bar__item {
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 5px;
          min-height: 50px;
          padding: 6px;
          border-radius: 16px;
          background: linear-gradient(135deg, var(--navy-50) 0%, var(--navy-100) 100%);
          color: var(--navy);
          font-family: var(--font-display);
          font-weight: 700;
          font-size: 0.95rem;
          line-height: 1.1;
          text-align: center;
          text-decoration: none;
        }

        .action-bar__item :global(svg) {
          flex-shrink: 0;
        }

        /* Dark words on WhatsApp's green: white text on it is too faint to read easily. */
        .action-bar__item--whatsapp {
          background: var(--g-whatsapp);
          color: var(--sun-btn-fg);
        }

        .action-bar__item--visit {
          background: var(--g-sun);
          color: var(--sun-btn-fg);
        }

        .action-bar__item:hover,
        .action-bar__item:focus-visible {
          filter: brightness(1.04);
        }
      }

      /* The narrowest phones: icons over the words, so all three still fit. */
      @media (max-width: 359px) {
        .action-bar__item {
          flex-direction: column;
          gap: 2px;
          font-size: 0.8rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .action-bar {
          transition: none;
        }
      }
    </style>
  </body>
</html>
